# deterministic
LLM_TEMPERATURE="0"

# S3 conf
S3_ACCESS_KEY_ID=a_key
S3_SECRET_ACCESS_KEY=a_secret
S3_REGION=a_region
S3_BUCKET=a_bucket
S3_FORCE_PATH_STYLE="true"
S3_ENDPOINT="http://a_endpoint.com"


# AMI is never reached from the test suite: dotenv also loads a real .env locally
AMI_API_URL=""
AMI_API_USER=""
AMI_API_PASSWORD=""
