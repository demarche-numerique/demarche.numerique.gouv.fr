[Unit]
Description="demarche-numerique web server"
After=network.target

[Service]
Type=notify
User=dn
WorkingDirectory=/var/www/dn
ExecStart=/home/dn/.rbenv/shims/bundle exec puma -C config/puma.rb -b tcp://127.0.0.1:8080
ExecReload=/bin/kill -SIGUSR2 $MAINPID
Environment="RAILS_ENV=production RAILS_LOG_TO_STDOUT=true"
WatchdogSec=10
Restart=always
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dn-web

[Install]
WantedBy=multi-user.target
