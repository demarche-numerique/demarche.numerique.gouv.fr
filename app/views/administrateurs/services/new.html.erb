<% content_for(:title, "Service") %>
<% render_procedure_sticky_title(@procedure) %>

<%= render partial: 'shared/breadcrumbs_section', locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)], [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)], ['Choix du service', admin_services_path(procedure_id: @procedure.id)], ['Nouveau service']] } %>

<div class="container">
  <h1>Nouveau Service</h1>
  <%= render partial: 'form', locals: { service: @service, procedure: @procedure, prefilled: @prefilled } %>
</div>
