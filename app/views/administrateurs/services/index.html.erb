<% content_for(:title, "Service") %>
<% render_procedure_sticky_title(@procedure) %>

<%= render partial: 'shared/breadcrumbs_section', locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)], [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)], ['Service']] } %>

<div class="fr-container" id="services-index">
  <h1 class="fr-h2">Service</h1>
  <%= link_to "Nouveau service", new_admin_service_path(procedure_id: @procedure.id), class: "fr-btn fr-btn--primary fr-btn--icon-left fr-icon-add-circle-line fr-mb-6v" %>

  <div class="fr-table">
    <div class="fr-table__wrapper">
      <div class="fr-table__container">
        <div class="fr-table__content">
          <table>
            <caption>
              Liste des services pouvant être affectés à la démarche
            </caption>

            <thead>
              <tr>
                <th scope="col">
                  Nom
                </th>

                <th class="fr-col-4" scope="col">
                  Actions
                </th>
              </tr>
            </thead>

            <tbody>
              <% @services.each do |service| %>
                <tr>
                  <td class="fr-cell--multiline">
                    <%= service.nom %>
                  </td>

                  <td class="fr-col-4">
                    <div class="fr-container flex fr-px-0">
                      <div class="fr-col-4 fr-col--middle">
                        <% if @procedure.service == service %>
                          <p class="fr-badge fr-badge--success fr-badge--sm">
                            ASSIGNÉ
                          </p>
                        <% else %>
                          <%= button_to "Affecter", add_to_procedure_admin_services_path(procedure_id: @procedure.id, procedure: { service_id: service.id }), method: :patch, class: 'fr-btn fr-btn--sm fr-btn--secondary fr-btn--icon-left fr-icon-checkbox-circle-line' %>
                        <% end %>
                      </div>

                      <div class="fr-col-4">
                        <%= link_to('Modifier', edit_admin_service_path(service, procedure_id: @procedure.id), class: 'fr-btn fr-btn--sm fr-btn--secondary fr-btn--icon-left fr-icon-pencil-line') %>
                      </div>

                      <div class="fr-col-4">
                        <% procedures_count = @procedures_count_by_service_id.fetch(service.id, 0) %>
                        <%= button_to 'Supprimer', admin_service_path(service, procedure_id: @procedure.id), method: :delete, data: { turbo_confirm: "Confirmez vous la suppression de #{service.nom}" }, form: { data: { turbo: true } }, class: 'fr-btn fr-btn--sm fr-btn--secondary fr-btn--icon-left fr-icon-delete-line', title: (procedures_count > 0 ? "Ce service est encore utilisé par #{pluralize(procedures_count, 'démarche')}" : nil), disabled: (procedures_count > 0 || service.administrateur_id != current_administrateur.id) %>
                      </div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render Procedure::FixedFooterComponent.new(procedure: @procedure) %>
