<% content_for(:title, "Chorus") %>
<% render_procedure_sticky_title(@procedure) %>

<%= render partial: 'shared/breadcrumbs_section', locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)], [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)], ['Connecteur Chorus']] } %>

<div class="fr-container">
  <h1 class="fr-h1">
    Cadre budgétaire
  </h1>

  <%= render Dsfr::CalloutComponent.new(title: "Cas d’usage") do |c| %>
    <% c.with_body do %>
      <p>
        Ajouter un champs Engagement Juridique aux annotations privées afin de
        renseigner l’EJ directement dans DS
      </p>

      <p>L'EJ sera automatiquement ajouté aux exports des dossiers</p>
    <% end %>
  <% end %>

  <%= link_to "Ajouter une annotation privée EJ", annotations_admin_procedure_path(@procedure), class: 'btn fr-btn' %>
</div>
