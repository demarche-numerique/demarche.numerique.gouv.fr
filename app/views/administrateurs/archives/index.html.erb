<% content_for(:title, t('.title')) %>
<%= render_procedure_sticky_title(@procedure) %>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)],
                    [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)],
                    [t('.breadcrumb_export_and_archives')]] } %>

<div class="fr-container flex">
  <h1>
    <%= t('.title') %>
    <%# index not renderable as administrateur flagged as manager, so render it anyway %>
  </h1>

  <div class="fr-ml-2w fr-my-1w">
    <%= render Dossiers::ExportDropdownComponent.new(procedure: @procedure, export_url: method(:download_admin_procedure_exports_path), show_export_template_tab: false) %>
  </div>
</div>

<div class="fr-container">
  <%= render Dossiers::ExportLinkComponent.new(procedure: @procedure, exports: @exports, export_url: method(:download_admin_procedure_exports_path), administrateur: true) %>

  <%= render partial: "shared/archives/notice", locals: { with_bills: true } %>
  <%= render partial: "shared/archives/table", locals: { count_dossiers_termines_by_month: @count_dossiers_termines_by_month, archives: @archives, average_dossier_weight: @average_dossier_weight, procedure: @procedure } %>
</div>
