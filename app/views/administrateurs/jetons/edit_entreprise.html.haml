- content_for(:title, "Jeton Entreprise")
- render_procedure_sticky_title(@procedure)

= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)],
                    [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)],
                    ['Jetons API', [:admin, @procedure, :jetons]],
                    ['Jeton API Entreprise']] }

.fr-container
  .fr-mb-3w
    = link_to "Liste des jetons",
      [:admin, @procedure, :jetons],
      class: "fr-link fr-icon-arrow-left-line fr-link--icon-left"

  %h1.fr-h2 Jeton API Entreprise

= form_with model: @procedure, url: url_for({ controller: 'administrateurs/jetons', action: :update_entreprise }) do |f|
  .fr-container

    - if @procedure.api_entreprise_token_rejected?
      = render Dsfr::AlertComponent.new(state: :error, size: :sm, extra_class_names: 'fr-mb-2w') do |c|
        - c.with_body do
          %p
            API Entreprise a refusé votre jeton le
            = "#{I18n.l(@procedure.api_entreprise_token_rejected_at, format: :long_with_time)}."
            Les dossiers concernés attendent son renouvellement.
    - else
      = render 'token_expiration_alert', token: @procedure.api_entreprise_token, api_name: 'API Entreprise'

    = render Dsfr::InputComponent.new(form: f, attribute: :api_entreprise_token, input_type: :password_field, required: false, opts: { value: @procedure.read_attribute(:api_entreprise_token)})

  = render Procedure::FixedFooterComponent.new(procedure: @procedure, form: f)
