- content_for(:title, "Jetons")
- render_procedure_sticky_title(@procedure)

= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)],
                    [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)],
                    ['Jetons API']] }

.fr-container
  %h1.fr-h2
    Jetons API

.fr-container
  %h2.fr-h4 API Entreprise

  %p
    = t('.api_entreprise_description_html', app_name: Current.application_name,
      api_link: link_to("API Entreprise", "https://entreprise.api.gouv.fr/", **external_link_attributes(t('.api_entreprise_link_title'))),
      habilitation_link: link_to("https://www.data.gouv.fr/dataservices/api-entreprise", "https://www.data.gouv.fr/dataservices/api-entreprise", **external_link_attributes(t('.api_entreprise_habilitation_title'))))

  - if @procedure.specific_api_entreprise_token?
    .fr-table.fr-table--lg#api_entreprise
      .fr-table__wrapper
        .fr-table__container
          .fr-table__content
            %table
              %thead
                %tr
                  %th{ scope: "col" }
                    Jeton
                  %th{ scope: "col" }
                    Expiration
                  %th.change.fr-col-2{ scope: "col" }
                    Actions

              %tbody
                %tr
                  %td
                    .fr-badge
                      API entreprise
                  %td
                    = render 'token_expiration', token: @procedure.api_entreprise_token
                  %td.change

                    = link_to 'Modifier',
                      api_entreprise_admin_procedure_jetons_path(@procedure),
                      class: 'fr-btn fr-btn--sm fr-btn--secondary fr-btn--icon-left fr-icon-pencil-line'

                    = button_to 'Supprimer',
                      api_entreprise_admin_procedure_jetons_path(@procedure),
                      method: :delete,
                      data: { turbo_confirm: "Êtes-vous sûr de vouloir supprimer le jeton API Entreprise ?" },
                      form: { class: 'inline', data: { turbo: true } },
                      class: 'fr-btn fr-btn--sm fr-btn--secondary fr-btn--icon-left fr-icon-delete-line fr-ml-1w'


  - else
    = link_to 'Ajouter un jeton API Entreprise',
                      api_entreprise_admin_procedure_jetons_path(@procedure),
                      class: 'fr-btn'
  %hr.fr-hr.fr-mt-5w.fr-mb-1w
  %h2.fr-h4 API Particulier
  %p
    = t('.api_particulier_description_html', app_name: Current.application_name,
      api_link: link_to("API Particulier", "https://particulier.api.gouv.fr/", **external_link_attributes(t('.api_particulier_link_title'))),
      habilitation_link: link_to("https://datapass.api.gouv.fr/formulaires/api-particulier-demarche-numerique/demande/nouveau", "https://datapass.api.gouv.fr/formulaires/api-particulier-demarche-numerique/demande/nouveau", **external_link_attributes(t('.api_particulier_habilitation_title'))))

  - if @procedure.api_particulier_token?
    .fr-table.fr-table--lg
      .fr-table__wrapper
        .fr-table__container
          .fr-table__content
            %table
              %thead
                %tr
                  %th{ scope: "col" }
                    Jeton
                  %th{ scope: "col" }
                    Expiration
                  %th.change.fr-col-2{ scope: "col" }
                    Actions

              %tbody
                %tr
                  %td
                    .fr-badge
                      API particulier
                  %td
                    = render 'token_expiration', token: @procedure.api_particulier_token
                  %td.change

                    = link_to 'Modifier',
                      api_particulier_admin_procedure_jetons_path(@procedure),
                      class: 'fr-btn fr-btn--sm fr-btn--secondary fr-btn--icon-left fr-icon-pencil-line'

                    = button_to 'Supprimer',
                      api_particulier_admin_procedure_jetons_path(@procedure),
                      method: :delete,
                      data: { turbo_confirm: "Êtes-vous sûr de vouloir supprimer le jeton API Particulier?" },
                      form: { class: 'inline', data: { turbo: true } },
                      class: 'fr-btn fr-btn--sm fr-btn--secondary fr-btn--icon-left fr-icon-delete-line fr-ml-1w'

    = render Dsfr::AlertComponent.new(state: :info, size: :sm) do |c|
      - c.with_body do
        %p
          Pour activer les champs relatifs à API Particulier, contactez-nous sur
          = link_to CONTACT_EMAIL, "mailto:#{CONTACT_EMAIL}"

  - else
    = link_to 'Ajouter un jeton API Particulier',
                      api_particulier_admin_procedure_jetons_path(@procedure),
                      class: 'fr-btn'

= render Procedure::FixedFooterComponent.new(procedure: @procedure)
