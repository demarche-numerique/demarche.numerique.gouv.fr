<%= turbo_frame_tag("api-champ-columns") do %>
  <h2
    id="<%= Dsfr::ModalComponent.title_id('api-champ-columns-modal') %>"
    class="fr-modal__title"
  >
    <%= t(".title") %>
  </h2>

  <p>
    <%= t(".description_html", api_geo_link: link_to("API Géo", "https://api.gouv.fr/les-api/api-geo", **external_link_attributes.merge(class: 'fr-link'))) %>
  </p>

  <%= render Dsfr::AlertComponent.new(state: :warning) do |c| %>
    <% c.with_body do %>
      <p><%= t(".warning_desc_html") %></p>
    <% end %>
  <% end %>
<% end %>
