<%= turbo_frame_tag("api-champ-columns") do %>
  <h1 id="fr-modal-api-champ-columns-h1" class="fr-modal__title">
    <%= t(".title") %>
  </h1>

  <p>
    <%= t(".description_html", api_geo_link: link_to("API Géo", "https://api.gouv.fr/les-api/api-geo", **external_link_attributes("API Géo").merge(class: 'fr-link'))) %>
  </p>

  <%= render Dsfr::AlertComponent.new(state: :warning) do |c| %>
    <% c.with_body do %>
      <p><%= t(".warning_desc_html") %></p>
    <% end %>
  <% end %>
<% end %>
