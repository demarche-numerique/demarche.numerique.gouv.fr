<%- content_for :title, t('.title', name: @api_token.name) -%>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [['Tableau de bord', tableau_de_bord_helper_path],
    [t('users.profil.show.profile'), profil_path(context: :administrateur)],
    [t('.title', name: @api_token.name)]] } %>

<div class="fr-container fr-mt-2w">
  <turbo-frame id="tokenUpdate">
    <%= render partial: 'edit_form', locals: { api_token: @api_token, libelle_id_procedures: @libelle_id_procedures, invalid_network_message: @invalid_network_message } %>
  </turbo-frame>

  <ul class="fr-btns-group fr-btns-group--inline">
    <li>
      <%= link_to t('.back_link'), profil_path(context: :administrateur), class: "fr-btn fr-btn--secondary" %>
    </li>
  </ul>
</div>
