<%= content_for :title, t('.title') %>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [[t('.dashboard'), tableau_de_bord_helper_path],
    [t('users.profil.show.profile'), profil_path(context: :administrateur)],
    [api_token_form_title(@api_token_form)]] } %>

<div class="fr-container fr-mt-2w">
  <h1>
    <%= api_token_form_title(@api_token_form) %>
  </h1>

  <%= form_with model: @api_token_form, url: autorisations_admin_api_tokens_path, method: :post, html: { class: 'fr-mt-2w' } do |f| %>
    <%- name_error = @api_token_form.errors[:name].first -%>

    <div class="<%= class_names('fr-input-group': true, 'fr-input-group--error': name_error) %>">
      <%= f.label :name, class: 'fr-label' do %>
        <%= t('.name') %>
        <span class="fr-hint-text"><%= t('.name-hint') %></span>
      <% end %>

      <%= f.text_field :name, class: class_names('fr-input width-33': true, 'fr-input--error': name_error), aria: { describedby: ('api-token-name-error' if name_error), invalid: ('true' if name_error) }, autocomplete: 'off', autocapitalize: 'off', autocorrect: 'off', spellcheck: false, required: true, autofocus: true %>

      <%- if name_error -%>
        <p class="fr-error-text" id="api-token-name-error"><%= name_error %></p>
      <%- end -%>

      <%= render APITokens::HiddenFieldsComponent.new(form: f, except: %i[name]) %>
    </div>

    <ul class="fr-btns-group fr-btns-group--inline">
      <li>
        <%= link_to t('.cancel'), profil_path(context: :administrateur), class: "fr-btn fr-btn--secondary" %>
      </li>

      <li>
        <%= f.button type: :submit, class: "fr-btn fr-btn--primary" do %>
          <%= t('.continue') %>
        <% end %>
      </li>
    </ul>
  <% end %>
</div>
