<%= content_for :title, t('.title') %>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [[t('.dashboard'), tableau_de_bord_helper_path],
    [t('users.profil.show.profile'), profil_path(context: :administrateur)],
    [@api_token_params.duplicating? ? t('administrateurs.api_tokens.duplicate_title') : t('administrateurs.api_tokens.new_token')]] } %>

<div class="fr-container fr-mt-2w" data-turbo="true">
  <h1>
    <%= @api_token_params.duplicating? ? t('administrateurs.api_tokens.duplicate_title') : t('administrateurs.api_tokens.new_token') %>
  </h1>

  <%= form_with url: autorisations_admin_api_tokens_path, method: :get,  html: { class: 'fr-mt-2w' } do |f| %>
    <div class="fr-input-group">
      <%= f.label :name, class: 'fr-label' do %>
        <%= t('.name') %>
        <span class="fr-hint-text"><%= t('.name-hint') %></span>
      <% end %>

      <%= f.text_field :name, class: 'fr-input width-33', autocomplete: 'off', autocapitalize: 'off', autocorrect: 'off', spellcheck: false, required: true, value: @name, autofocus: true %>

      <%= render APITokens::HiddenFieldsComponent.new(fields: @api_token_params.hidden_fields_for(%i[name])) %>
    </div>

    <ul class="fr-btns-group fr-btns-group--inline">
      <li>
        <%= link_to t('.cancel'), profil_path(context: :administrateur), class: "fr-btn fr-btn--secondary" %>
      </li>

      <li>
        <%= f.button type: :submit, class: "fr-btn fr-btn--primary" do %>
          <%= t('.continue') %>
        <% end %>
      </li>
    </ul>
  <% end %>
</div>
