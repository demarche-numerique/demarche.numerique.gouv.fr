<%- content_for :title, t('.title', name: @api_token.name) -%>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [['Tableau de bord', tableau_de_bord_helper_path],
    [t('users.profil.show.profile'), profil_path(context: :administrateur)],
    [t('administrateurs.api_tokens.nom.new_token')]] } %>

<div class="fr-container fr-mt-2w" data-turbo="true">
  <h1><%= t('.ready') %></h1>

  <p><%= t('.intro') %><br><b><%= t('.warning') %></b></p>

  <p
    data-controller="clipboard"
    data-clipboard-text-value="<%= @packed_token %>"
  >
    <code><%= @packed_token %></code>

    <button
      class="fr-btn fr-btn-primary fr-btn-small fr-ml-2w"
      data-action="clipboard#copy"
      data-clipboard-target="toHide"
      title="<%= t('.copy_title') %>"
    >
      <%= t('.copy') %>
    </button>

    <button
      class="fr-btn fr-btn-primary fr-btn-small fr-ml-2w hidden"
      data-clipboard-target="success"
    >
      <%= t('.copied') %>
    </button>
  </p>

  <p class="fr-mt-4w"><%= t('.example_intro') %></p>

  <div
    class="code-example"
    data-controller="clipboard"
    data-clipboard-text-value="<%= @curl_command %>"
  >
    <div class="example-header">
      <span class="lang"><%= t('.lang') %></span>

      <button
        class="
          fr-btn fr-btn--icon-left fr-icon-clipboard-line fr-btn--sm
          fr-btn--tertiary-no-outline
        "
        data-action="clipboard#copy"
        data-clipboard-target="toHide"
        title="<%= t('.copy_title') %>"
      >
        <%= t('.copy') %>
      </button>

      <button
        class="
          fr-btn fr-btn--icon-left fr-icon-checkbox-line fr-btn--sm
          fr-btn--tertiary-no-outline hidden
        "
        data-clipboard-target="success"
      >
        <%= t('.copied') %>
      </button>
    </div>

    <pre>
      <code><%= @curl_command %></code>
    </pre>
  </div>

  <p class="fr-text--sm fr-text-mention--grey">
    <%= t('.doc_text') %>
    <%= link_to(t('.doc_link'), API_DOC_URL, **external_link_attributes) %>
  </p>

  <p class="fr-mt-4w"><%= t('.summary') %></p>

  <ul>
    <li><strong><%= t('.name') %></strong><%= @api_token.name %></li>

    <li>
      <strong><%= t('.access') %></strong>
      <%= @api_token.write_access? ? t('.read_write') : t('.read_only') %>
    </li>

    <li>
      <strong><%= t('.procedures') %></strong>
      <%= @api_token.full_access? ? t('.all_procedures') : @api_token.procedures.map(&:libelle).join(', ') %>
    </li>

    <li>
      <strong><%= t('.networks') %></strong>
      <%= @api_token.authorized_networks.empty? ? t('.all_networks') : @api_token.authorized_networks_for_ui %>
    </li>

    <li>
      <strong><%= t('.expiration') %></strong>

      <span><%= l(@api_token.expires_at, format: :long) %></span>
    </li>
  </ul>

  <%= link_to(t('.back_to_profile'), profil_path(context: :administrateur), class: 'fr-btn fr-btn--secondary fr-mt-2w') %>
</div>
