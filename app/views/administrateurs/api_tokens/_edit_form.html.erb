<h1><%= t('.title', name: api_token.name) %></h1>

<div class="fr-card fr-p-3w fr-mb-2w">
  <%= form_with url: admin_api_token_path(api_token), method: :patch do |f| -%>
    <div class="fr-input-group">
      <%= f.label :name, class: 'fr-label' do -%>
        <%= t('name', scope: [:administrateurs, :api_tokens, :nom]) %>

        <span class="fr-hint-text">
          <%= t('name-hint', scope: [:administrateurs, :api_tokens, :nom]) %>
        </span>
      <%- end -%>

      <div class="flex">
        <%= f.text_field :name,
          class: 'fr-input width-33',
          autocomplete: 'off',
          autocapitalize: 'off',
          autocorrect: 'off',
          spellcheck: false,
          required: true,
          value: api_token.name %>

        <button class="fr-btn fr-btn--primary fr-ml-1w">
          <%= t('.rename_button') %>
        </button>
      </div>
    </div>
  <%- end -%>
</div>

<div class="fr-card fr-p-3w fr-mb-2w">
  <%= form_with url: admin_api_token_path(api_token), method: :patch do |f| -%>
    <div class="fr-input-group <%= class_names('fr-input-group--error': invalid_network_message.present?) %>">
      <%= f.label :name, class: 'fr-label' do -%>
        <%- if !@api_token.requires_ip_filtering? -%>
          <%= t('.enter_at_least_one_network') %>
        <%- else -%>
          <%= t('.enter_authorized_ips') %>
        <%- end -%>

        <span class="fr-hint-text"><%= t('.networks_hint') %></span>
      <%- end -%>

      <div class="flex">
        <%= f.text_field :networks,
          class: class_names('fr-input': true, 'fr-input--error': invalid_network_message.present?),
          autocomplete: 'off',
          autocapitalize: 'off',
          autocorrect: 'off',
          spellcheck: false,
          value: api_token.authorized_networks_for_ui.gsub(/,/, ' ') %>

        <button class="fr-btn fr-btn--primary fr-ml-1w">
          <%= t('.modify_button') %>
        </button>
      </div>
    </div>

    <%- if invalid_network_message.present? -%>
      <p class="fr-error-text"><%= invalid_network_message %></p>
    <%- end -%>

    <%- if api_token.pending_auto_ip? -%>
      <div class="fr-messages-group" aria-live="polite">
        <p class="fr-message fr-message--info">
          <%= t('.pending_auto_ip_message') %>
        </p>
      </div>
    <%- end -%>
  <%- end -%>
</div>

<div class="fr-card fr-p-3w fr-mb-2w">
  <div class="fr-input-group fr-mb-0" data-controller="toggle-restriction">
    <div data-toggle-restriction-target="fullAccessBlock" class="<%= 'hidden' unless api_token.full_access? %>">
      <p><%= t('.full_access_message') %></p>
      <button type="button" class="fr-btn fr-btn--primary fr-btn--sm" data-action="click->toggle-restriction#reveal">
        <%= t('.restrict_access_button') %>
      </button>
    </div>

    <div data-toggle-restriction-target="restrictedBlock" class="<%= 'hidden' if api_token.full_access? %>">
      <div class="fr-select-group">
        <label class="fr-label" for="procedure_to_add"><%= t('.add_authorized_procedures') %></label>
        <%= form_with url: admin_api_token_path(api_token), method: :patch do |f| -%>
          <div class="flex">
            <%= f.select :value, options_for_select(libelle_id_procedures), { include_blank: true }, { class: 'fr-select width-33', name: 'procedure_to_add' } %>
            <button class="fr-btn fr-btn--primary fr-ml-1w"><%= t('.add_button') %></button>
          </div>
        <%- end -%>
      </div>
    </div>
  </div>

  <%- if !api_token.full_access? -%>
    <ul class="fr-mb-2w">
      <%- api_token.procedures.each do |procedure| -%>
        <li id="<%= dom_id(procedure, :authorized) %>">
          <%= procedure.libelle %>
          <%= button_to t('.delete_button'),
            remove_procedure_admin_api_token_path(api_token, procedure_id: procedure.id),
            class: 'fr-btn fr-btn--tertiary-no-outline fr-btn--sm fr-btn--icon-left fr-icon-delete-line',
            form_class: 'inline',
            method: :delete,
            form: { data: { turbo: 'true' } } %>
        </li>
      <%- end -%>
    </ul>

    <div class="flex align-center">
      <p class="fr-text--sm fr-mb-0 fr-mr-1v"><%= t('.restrict_access_message') %></p>
      <%= button_to t('.restore_full_access_button'),
        admin_api_token_path(api_token),
        method: :patch,
        params: { restore_full_access: true },
        class: 'fr-btn fr-btn--tertiary-no-outline fr-btn--sm' %>
    </div>
  <%- end -%>
</div>
