<%= content_for :title, t('.title', name: @api_token_form.name) %>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [[t('.dashboard'), tableau_de_bord_helper_path],
    [t('users.profil.show.profile'), profil_path(context: :administrateur)],
    [@api_token_form.duplicating? ? t('administrateurs.api_tokens.duplicate_title') : t('administrateurs.api_tokens.new_token')]] } %>

<div class="fr-container fr-mt-2w">
  <h1>
    <%= @api_token_form.duplicating? ? t('administrateurs.api_tokens.duplicate_title') : t('administrateurs.api_tokens.new_token') %>
  </h1>

  <%= render Dsfr::AlertComponent.new(title: nil, size: :sm, state: :info, extra_class_names: 'fr-mb-2w') do |c| %>
    <% c.with_body do %>
      <p>
        <%= t('.security_warning') %>
        <br>
        <b><%= t('.responsibility') %></b>
      </p>

      <p><%= t('.features_intro') %></p>
    <% end %>
  <% end %>

  <%= form_with model: @api_token_form, url: admin_api_tokens_path,
    method: :post,
    html: { class: 'fr-mt-2w' },
    data: { controller: 'api-token-securite' } do |f| %>
    <%- networks_error = @api_token_form.errors[:networks].first -%>

    <%= render Dsfr::RadioButtonListComponent.new(form: f,
      target: :network_filtering,
      buttons: [ { label: t('.auto_assign'),
        hint: t('.auto_assign_hint'),
        value: :autoAssign,
        'data-action': 'click->api-token-securite#hideNetworkFiltering' },
        { label: t('.custom_networks'),
        value: :customNetworks,
        'data-action': 'click->api-token-securite#showNetworkFiltering' }]) do %>
      <%= t('.network_filtering_label') %>
    <% end %>

    <div
      class="fr-input-group fr-mb-4w <%= class_names('hidden': !@api_token_form.custom_networks?, 'fr-input-group--error': networks_error) %>"
      data-api-token-securite-target="networkFiltering"
    >
      <%= f.label :networks, class: 'fr-label' do %>
        <%= t('.enter_ips') %>
        <span class="fr-hint-text"><%= t('.network_hint') %></span>
      <% end %>

      <%= f.text_field :networks,
        class: class_names('fr-input': true, 'fr-input--error': networks_error),
        aria: { describedby: ('api-token-networks-error' if networks_error), invalid: ('true' if networks_error) },
        autocomplete: 'off',
        autocapitalize: 'off',
        autocorrect: 'off',
        spellcheck: false,
        'data-action': 'input->api-token-securite#setContinueButtonState',
        'data-api-token-securite-target': 'networks' %>

      <%- if networks_error -%>
        <p class="fr-error-text" id="api-token-networks-error">
          <%= networks_error %>
        </p>
      <%- end -%>
    </div>

    <hr class="fr-hr">

    <%= render Dsfr::RadioButtonListComponent.new(form: f,
      target: :lifetime,
      error: @api_token_form.errors[:expires_at].first,
      buttons: APIToken.selectable_lifetimes.keys.map { |lifetime|
        { label: t(".lifetime.#{lifetime.to_s.underscore}"),
          value: lifetime,
          'data-action': 'click->api-token-securite#hideCustomLifetime' }
      } + [{ label: t('.custom_lifetime_label', count: APIToken::MAX_LIFETIME.in_days.to_i),
        value: :custom,
        'data-action': 'click->api-token-securite#showCustomLifetime' }]) do %>
      <%= t('.lifetime_label') %>
    <% end %>

    <div
      class="fr-input-group fr-mb-4w <%= class_names('hidden': @api_token_form.lifetime != 'custom') %>"
      data-api-token-securite-target="customLifetime"
    >
      <%= f.label :custom_lifetime, class: 'fr-label' do %>
        <%= t('.enter_expiry') %>
      <% end %>

      <%= f.date_field :custom_lifetime,
        class: 'fr-input width-33 fr-mb-4w',
        autocomplete: 'off',
        min: APIToken.min_expires_at,
        max: APIToken.max_expires_at,
        'data-action': 'input->api-token-securite#setContinueButtonState',
        'data-api-token-securite-target': 'customLifetimeInput' %>
    </div>

    <%= render APITokens::HiddenFieldsComponent.new(form: f, except: %i[network_filtering networks lifetime custom_lifetime]) %>

    <ul class="fr-btns-group fr-btns-group--inline">
      <li>
        <button
          type="submit"
          form="api-token-securite-back"
          class="fr-btn fr-btn--secondary"
        >
          <%= t('.back') %>
        </button>
      </li>

      <li>
        <%= f.button type: :submit,
          class: "fr-btn fr-btn--primary",
          disabled: true,
          'data-api-token-securite-target': 'continueButton' do %>
          <%= t('.validate') %>
        <% end %>
      </li>
    </ul>
  <% end %>

  <%= form_with model: @api_token_form, url: autorisations_admin_api_tokens_path, method: :post, id: 'api-token-securite-back' do |back| %>
    <%= render APITokens::HiddenFieldsComponent.new(form: back) %>
  <% end %>
</div>
