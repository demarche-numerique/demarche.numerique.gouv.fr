<%- content_for :title, t('.title', name: @api_token_form.name) %>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [['Tableau de bord', tableau_de_bord_helper_path],
    [t('users.profil.show.profile'), profil_path(context: :administrateur)],
    [@api_token_form.duplicating? ? t('administrateurs.api_tokens.duplicate_title') : t('administrateurs.api_tokens.new_token')]] } %>

<div class="fr-container fr-mt-2w">
  <h1>
    <%= @api_token_form.duplicating? ? t('administrateurs.api_tokens.duplicate_title') : t('administrateurs.api_tokens.new_token') %>
  </h1>

  <%= form_with model: @api_token_form, url: securite_admin_api_tokens_path,
  method: :post, id: 'api-token-autorisation-form',
  data: { controller: 'api-token-autorisation',
  'api-token-autorisation-initial-targets-value': @api_token_form.allowed_procedure_ids.present?,
  action: 'change->api-token-autorisation#setContinueButtonState' } do |f| -%>
    <%= render Dsfr::RadioButtonListComponent.new(form: f,
      target: :target,
      error: @api_token_form.errors[:allowed_procedure_ids].first,
      buttons: [
        { label: t('.all_procedures'),
        value: :all,
        hint: t('.all_procedures_hint'),
        data: { 'action': 'click->api-token-autorisation#hideProcedureSelectGroup' } },
        { label: t('.custom_procedures'),
        value: :custom,
        data: { 'action': 'click->api-token-autorisation#showProcedureSelectGroup' } },]) do %>
      <%= t('.token_access') %>
    <% end %>

    <div
      class="fr-mb-4w <%= class_names('hidden': !@api_token_form.custom_target?) %>"
      data-api-token-autorisation-target="procedureSelectGroup"
    >
      <div class="fr-select-group">
        <label class="fr-label" for="procedureSelect">
          <%= t('.select_procedures') %>
        </label>

        <div class="fr-col-sm-12 fr-col-md-6">
          <react-fragment>
            <%= render ReactComponent.new 'ComboBox/MultiComboBox',
              items: @libelle_id_procedures,
              id: 'targets',
              name: 'api_token_form[procedure_ids][]',
              selectedKeys: @api_token_form.procedure_ids,
              'aria-label': t('.select_procedures') %>
          </react-fragment>
        </div>
      </div>
    </div>

    <hr class="fr-hr">

    <div data-action="click->api-token-autorisation#setContinueButtonState">
      <%= render Dsfr::RadioButtonListComponent.new(form: f,
        target: :access,
        buttons: [ { label: t('.read_only'),
          value: :read,
          hint: t('.read_only_hint') },
        { label: t('.read_write'),
        value: :read_write,
        hint: t('.read_write_hint') }]) do %>
        <%= t('.token_permission') %>
      <% end %>
    </div>

    <%= render APITokens::HiddenFieldsComponent.new(form: f, except: %i[target procedure_ids access]) %>

    <ul class="fr-btns-group fr-btns-group--inline">
      <li>
        <button
          type="submit"
          form="api-token-autorisation-back"
          class="fr-btn fr-btn--secondary"
        >
          <%= t('.cancel') %>
        </button>
      </li>

      <li>
        <%= f.button type: :submit,
          class: "fr-btn fr-btn--primary",
          disabled: true,
          'data-api-token-autorisation-target': 'continueButton' do %>
          <%= t('.continue') %>
        <% end %>
      </li>
    </ul>
  <% end %>

  <%= form_with model: @api_token_form, url: nom_admin_api_tokens_path, method: :post, id: 'api-token-autorisation-back' do |back| %>
    <%= render APITokens::HiddenFieldsComponent.new(form: back) %>
  <% end %>
</div>
