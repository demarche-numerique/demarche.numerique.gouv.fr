<%- content_for :title, t('.title', name: @name) %>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [['Tableau de bord', tableau_de_bord_helper_path],
    [t('users.profil.show.profile'), profil_path(context: :administrateur)],
    [@api_token_params.duplicating? ? t('administrateurs.api_tokens.duplicate_title') : t('administrateurs.api_tokens.new_token')]] } %>

<div class="fr-container fr-mt-2w" data-turbo="true">
  <h1><%= @api_token_params.duplicating? ? t('administrateurs.api_tokens.duplicate_title') : t('administrateurs.api_tokens.new_token') %></h1>

  <%= form_with url: securite_admin_api_tokens_path,
  method: :get, id: 'api-token-autorisation-form',
  data: { controller: 'api-token-autorisation',
  action: 'change->api-token-autorisation#setContinueButtonState' } do |f| -%>
    <%= render Dsfr::RadioButtonListComponent.new(form: f,
      target: :target,
      buttons: [
        { label: t('.all_procedures'),
        value: :all,
        hint: t('.all_procedures_hint'),
        checked: params[:target] == 'all',
        data: { 'action': 'click->api-token-autorisation#hideProcedureSelectGroup' } },
        { label: t('.custom_procedures'),
        value: :custom,
        checked: params[:target] == 'custom',
        data: { 'action': 'click->api-token-autorisation#showProcedureSelectGroup' } },]) do %>
      <%= t('.token_access') %>
    <% end %>

    <div
      class="fr-mb-4w hidden"
      data-api-token-autorisation-target="procedureSelectGroup"
    >
      <div class="fr-select-group">
        <label class="fr-label" for="procedureSelect">
          <%= t('.select_procedures') %>
        </label>

        <div class="fr-col-sm-12 fr-col-md-6">
          <react-fragment>
            <%= render ReactComponent.new 'ComboBox/MultiComboBox',
              items: @libelle_id_procedures,
              id: 'targets',
              name: 'targets[]',
              tagsBelow: true,
              selectedKeys: @api_token_params.targets,
              'aria-label': t('.select_procedures')
            %>
          </react-fragment>
        </div>
      </div>
    </div>

    <hr class="fr-hr">

    <div data-action="click->api-token-autorisation#setContinueButtonState">
      <%= render Dsfr::RadioButtonListComponent.new(form: f,
        target: :access,
        buttons: [ { label: t('.read_only'),
          value: :read,
          checked: params[:access] == 'read',
          hint: t('.read_only_hint') },
        { label: t('.read_write'),
        value: :read_write,
        checked: params[:access] == 'read_write',
        hint: t('.read_write_hint') }]) do %>
        <%= t('.token_permission') %>
      <% end %>
    </div>

    <%= render APITokens::HiddenFieldsComponent.new(fields: @api_token_params.hidden_fields_for(%i[target targets access])) %>


    <ul class="fr-btns-group fr-btns-group--inline">
      <li>
        <%= link_to t('.cancel'), nom_admin_api_tokens_path(@api_token_params.to_h), class: "fr-btn fr-btn--secondary" %>
      </li>
      <li>
        <%= f.button type: :submit,
          class: "fr-btn fr-btn--primary",
          disabled: true,
          'data-api-token-autorisation-target': 'continueButton' do %>
          <%= t('.continue') %>
        <% end %>
      </li>
    </ul>
  <% end %>
</div>
