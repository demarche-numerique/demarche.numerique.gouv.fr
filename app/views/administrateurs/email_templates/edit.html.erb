<% content_for(:title, @email_template.class.const_get(:DISPLAYED_NAME)) %>
<% content_for(:root_class, 'scroll-margins-for-sticky-footer') %>
<% render_procedure_sticky_title(@procedure) %>

<% if params[:id] == 'accepte' %>
  <%= render partial: 'admin/email_template_attestation_inconsistency_alert',
        locals: { procedure: @procedure, state: @procedure.email_template_attestation_inconsistency_state(:acceptation),
                  mail_type: 'acceptation', email_slug: Emails::Accepte::SLUG,
                  attestation_template_v1: (@procedure.attestation_acceptation_template&.version == 1) } %>
<% elsif params[:id] == 'refuse' %>
  <%= render partial: 'admin/email_template_attestation_inconsistency_alert',
        locals: { procedure: @procedure, state: @procedure.email_template_attestation_inconsistency_state(:refus),
                  mail_type: 'refus', email_slug: Emails::Refuse::SLUG,
                  attestation_template_v1: false } %>
<% end %>

<%= render partial: 'shared/breadcrumbs_section',
      locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)],
                        [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)],
                        ["Modèles d’email", admin_procedure_email_templates_path(@procedure)],
                        [@email_template.class.const_get(:DISPLAYED_NAME)]] } %>

<% preview_url = preview_admin_procedure_email_template_path(@procedure, @email_template.class.const_get(:SLUG)) %>
<% tags = @email_template.tags_categorized %>

<%= form_for @email_template, as: Emails::PARAM_KEY,
      url: admin_procedure_email_template_path(@procedure, @email_template.class.const_get(:SLUG)),
      method: :put do |f| %>
  <div id="mail-template-edit" class="fr-container fr-my-4w">
    <div class="fr-grid-row fr-grid-row--gutters">
      <div class="fr-col-12 fr-col-lg-7">
        <fieldset class="fr-fieldset" aria-labelledby="edit-mail-template">
          <legend class="fr-fieldset__legend" id="edit-mail-template">
            <h1 class="fr-h2">
              <%= @email_template.class.const_get(:DISPLAYED_NAME) %>
            </h1>
          </legend>

          <div class="fr-fieldset__element">
            <%= render TiptapEditorComponent.new(
                  form: f,
                  field_name: :tiptap_subject,
                  preview_url:,
                  label: "Objet de l’email",
                  actions: [],
                  tags:,
                  single_line: true,
                  collapsed_tags: true,
                  error_attribute: :json_subject) %>
          </div>

          <div class="fr-fieldset__element fr-mt-2w">
            <%= render TiptapEditorComponent.new(
                  form: f,
                  field_name: :tiptap_body,
                  preview_url:,
                  label: "Corps de l’email",
                  actions: %w[bold italic heading2 heading3 bulletList orderedList hardBreak paragraph link],
                  tags:,
                  error_attribute: :json_body) %>
          </div>
        </fieldset>
      </div>

      <div class="fr-col-12 fr-col-lg-5">
        <div class="mail-preview-panel fr-background-alt--blue-france">
          <h2 class="fr-h4">Aperçu</h2>

          <p class="fr-text--sm">
            Objet&nbsp;:
            <strong id="mail-subject-preview"><%= @email_template.subject_for_dossier(@dossier) %></strong>
          </p>

          <div
            id="mail-body-preview"
            class="mail-preview"
            data-controller="mail-preview"
          >
            <%= tag.iframe(src: preview_url, class: "mail-preview-frame", title: "Aperçu de l’email", width: "636", height: "480", sandbox: "allow-same-origin", data: { mail_preview_target: "frame" }) %>
          </div>

          <p class="fr-hint-text fr-mt-2w">
            L’aperçu se met à jour automatiquement après chaque modification.
            Pour générer un aperçu fidèle avec les champs et les dates,
            <%= link_to("créez-vous un dossier", new_dossier_path(procedure_id: @procedure, brouillon: true), class: "no-wrap", **external_link_attributes) %>
            et déposez-le&nbsp;: l’aperçu l’utilisera.
          </p>
        </div>
      </div>
    </div>
  </div>

  <%= render Procedure::FixedFooterComponent.new(procedure: @procedure, form: f) %>
<% end %>
