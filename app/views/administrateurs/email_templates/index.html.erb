<% content_for(:title, "Emails") %>
<% render_procedure_sticky_title(@procedure) %>

<%= render Procedure::LegacyDeclarativeEmailsNoticeComponent.new(procedure: @procedure) %>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)],
                    [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)],
                    ["Modèles d’email"]] } %>

<div class="fr-container">
  <div class="fr-grid-row fr-grid-row--gutters">
    <div class="fr-col-12">
      <h1 class="fr-h2">Modèles d’email</h1>

      <% if @procedure.accuse_lecture? %>
        <%= render Dsfr::AlertComponent.new(state: :info, size: :sm) do |c| %>
          <% c.with_body do %>
            <p><%= t(".accuse_lecture_notice.body") %></p>

            <% if @procedure.send_combined_declarative_email? && @procedure.declarative_accepte? %>
              <p><%= t(".accuse_lecture_notice.declarative_accepte") %></p>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if @procedure.send_combined_declarative_email? %>
        <%= render Dsfr::AlertComponent.new(state: :info, title: t(".declarative_notice.title"), heading_level: "h2", extra_class_names: "fr-mt-2w") do |c| %>
          <% c.with_body do %>
            <p>
              <%= t(".declarative_notice.#{@procedure.email_templates_context}_html",
                    link: link_to(t(".declarative_notice.presentation"), edit_admin_procedure_path(@procedure, section: "options-avancees", anchor: "declarative_with_state-legend"))) %>
            </p>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <% @email_templates.each do |email_template| %>
      <div class="fr-col-12">
        <%= render Procedure::EmailTemplateCardComponent.new(email_template: email_template, context: @procedure.email_templates_context) %>
      </div>
    <% end %>
  </div>
</div>

<%= render Procedure::FixedFooterComponent.new(procedure: @procedure) %>
