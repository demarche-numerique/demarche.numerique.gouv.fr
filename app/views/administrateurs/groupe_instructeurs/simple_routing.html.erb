<% render_procedure_sticky_title(@procedure) %>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [[t('.procedures'), admin_procedures_path],
    [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)],
    [t('.groupes'), admin_procedure_groupe_instructeurs_path(@procedure)],
    [t('.breadcrumb')]] } %>

<div class="container">
  <div class="fr-grid-row">
    <div class="fr-col fr-col-12 fr-col-md-3">
      <div class="fr-container">
        <ul class="fr-btns-group fr-btns-group--inline-md fr-ml-0 fr-sidemenu__inner">
          <li>
            <%= link_to t('.back_to_options'), options_admin_procedure_groupe_instructeurs_path, class: 'fr-link fr-icon-arrow-left-line fr-link--icon-left fr-mb-2w fr-mr-2w ' %>
          </li>
        </ul>
      </div>
    </div>

    <div class="fr-col">
      <% content_for(:title, t('.page_title')) %>

      <h1><%= t('.title') %></h1>

      <h2><%= t('.subtitle') %></h2>

      <div class="fr-alert fr-alert--info fr-mb-3w">
        <p></p>
        <%= t('.simple_routable_types_html') %>
        <%= render TypesDeChamp::ByCategoryListComponent.new(types: TypeDeChamp.simple_routable_types) %>

        <p>
          <%= t('.custom_routable_types_html') %>
        </p>

        <%= render TypesDeChamp::ByCategoryListComponent.new(types: TypeDeChamp.custom_routable_types) %>
      </div>

      <%= form_for :create_simple_routing,
        method: :post,
        data: { turbo: true, controller: 'enable-submit-if-checked' },
        url: create_simple_routing_admin_procedure_groupe_instructeurs_path(@procedure) do |f| %>
        <div
          class="card fr-pb-0"
          data-action="click->enable-submit-if-checked#click"
        >
          <div class="notice">
            <%= t('.select_champ') %>
          </div>

          <% buttons_content = @procedure.active_revision.simple_routable_type_de_champs.map do |tdc|
            { label: tdc.libelle,
              value: tdc.stable_id,
              hint: "[#{t(tdc.type_champ, scope: 'activerecord.attributes.type_de_champ.type_champs')}]",
              tooltip: (tdc.drop_down_options.join(", ") if tdc.drop_down_list?) }
          end %>

          <%= render Dsfr::RadioButtonListComponent.new(form: f, target: :stable_id, buttons: buttons_content) %>
        </div>

        <ul class="fr-btns-group fr-btns-group--inline-sm">
          <li>
            <%= link_to t('.cancel'), options_admin_procedure_groupe_instructeurs_path(@procedure, state: :choix), class: 'fr-btn fr-btn--secondary' %>
          </li>

          <li>
            <button
              class="fr-btn"
              disabled
              data-turbo-submits-with="<%= t('.submitting') %>"
              data-enable-submit-if-checked-target="submit"
            >
              <%= t('.submit') %>
            </button>
          </li>
        </ul>
      <% end %>
    </div>
  </div>
</div>
