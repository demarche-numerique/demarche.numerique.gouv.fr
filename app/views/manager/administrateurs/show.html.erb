<%#
  # Show

  This view is the template for the show page.
  It renders the attributes of a resource,
  as well as a link to its edit page.

  ## Local variables:

  - `page`:
  An instance of [Administrate::Page::Show][1].
  Contains methods for accessing the resource to be displayed on the page,
  as well as helpers for describing how each attribute of the resource
  should be displayed.

  [1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Show
%>

<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>

<% procedure = page.resource %>

<header class="main-content__header">
  <h1 class="main-content__page-title"><%= content_for(:title) %></h1>

  <div>
    <%= link_to(
      t("administrate.actions.edit_resource", name: page.page_title),
      [:edit, namespace, page.resource],
      class: "button",
    ) if accessible_action?(page.resource, :edit) %>
  </div>

  <div>
    <% if !page.resource.user.active? %>
      <%= button_to "renvoyer l’invitation", reinvite_manager_administrateur_path(page.resource), method: :post, class: "button" %>
    <% end %>

    <% if page.resource.can_be_deleted? %>
      <%= link_to t("administrate.actions.destroy"),
                  delete_edit_manager_administrateur_path(page.resource),
                  class: "button button--danger" %>
    <% else %>
      <span><%= t(".cannot_be_deleted") %></span>
    <% end %>
  </div>
</header>

<section class="main-content__body">
  <%= render partial: 'manager/application/user_meta', locals: { user: page.resource&.user } %>

  <dl>
    <% page.attributes.each do |title, attributes| %>
      <fieldset class="<%= "field-unit--nested" if title.present? %>">
        <% if title.present? %>
          <legend>
            <%= t "helpers.label.#{page.resource_name}.#{title}", default: title %>
          </legend>
        <% end %>

        <% attributes.each do |attribute| %>
          <dt class="attribute-label" id="<%= attribute.name %>">
            <%= t(
            "helpers.label.#{resource_name}.#{attribute.name}",
            default: page.resource.class.human_attribute_name(attribute.name),
          ) %>
          </dt>

          <dd class="attribute-data attribute-data--<%= attribute.html_class %>">
            <%= render_field attribute, page: page %>
          </dd>
        <% end %>
      </fieldset>
    <% end %>
  </dl>

  <h2>Fusionner un ancien administrateur</h2>

  <%= form_tag(request_merge_manager_administrateur_path(page.resource)) do %>
    <p>
      J’utilise cette option ETQ support quand cet administrateur remplace un
      administrateur qui a quitté le service. Ses démarches, services,
      instructeurs et jetons d’API sont transférés à
      <em><%= page.resource.email %></em>.
    </p>

    <%= label_tag :email, "Adresse électronique de l’ancien administrateur" %>
    <%= email_field_tag(:email, "", required: true, autocapitalize: "off", autocorrect: "off", spellcheck: "false", style: "margin-bottom: 1rem;width:24rem;") %>

    <% if SUPER_ADMIN_OTP_ENABLED %>
      <div class="field-unit field-unit--string field-unit--required">
        <%= render Manager::OtpAttemptInputComponent.new %>
      </div>
    <% end %>

    <button>Fusionner dans ce compte</button>
  <% end %>
</section>
