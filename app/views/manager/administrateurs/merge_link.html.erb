<% content_for(:title) { "Fusion d’un administrateur" } %>

<header class="main-content__header">
  <h1 class="main-content__page-title"><%= content_for(:title) %></h1>

  <div>
    <%= link_to t("administrate.actions.back"), manager_administrateur_path(@administrateur), class: "button" %>
  </div>
</header>

<section class="main-content__body">
  <p>
    Les démarches, services, instructeurs et jetons d’API de
    <em><%= @old_administrateur.email %></em> seront transférés à
    <em><%= @administrateur.email %></em>.
  </p>

  <p>
    Veuillez partager ce lien avec un autre super admin pour que l’opération
    soit effectuée. Il est valable 24 heures.
  </p>

  <dl>
    <dt class="attribute-label">Lien</dt>

    <dd class="attribute-data"><%= @url %></dd>
  </dl>
</section>
