<%= turbo_frame_tag "user-sent-mails" do %>
  <% if @sent_mails.present? %>
    <p>
      Les 30 derniers jours. Pour une recherche plus fine, il faut fouiller les
      <a href="https://app.brevo.com/transactional/email/logs">logs de Brevo</a>.
    </p>
    <table>
      <thead>
        <tr>
          <th scope="col">Émetteur</th>
          <th scope="col">Objet</th>
          <th scope="col">Date</th>
          <th scope="col">Statut</th>
          <th scope="col">Prestataire</th>
        </tr>
      </thead>

      <tbody>
        <% @sent_mails.each do |email| %>
          <tr class="<%= status_color_code(email.status) %>">
            <td><%= email.from %></td>
            <td><%= email.subject %></td>
            <td><%= l(email.delivered_at, format: :long_with_time) %></td>
            <td><%= email.status %></td>
            <td><%= link_to email.service_name, email.external_url %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>
      Historique indisponible. Cette adresse électronique n’existe pas chez nos
      prestataires d’envoi, ou nous n’avons pas réussi à en charger des données.
      Vous pouvez éventuellement fouiller les
      <a href="https://app.brevo.com/transactional/email/logs">logs de Brevo</a>.
    </p>
  <% end %>
<% end %>
