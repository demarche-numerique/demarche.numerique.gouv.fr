<div class="patron">
  <div class="container">
    <h1>Icônes</h1>

    <span class="icon follow"></span>
    <span class="icon unfollow"></span>
    <span class="icon unarchive"></span>
    <span class="icon edit"></span>
    <span class="icon bubble"></span>
    <span class="icon attached"></span>
    <span class="icon lock"></span>
    <span class="icon add"></span>
    <span class="icon justificatif"></span>
    <span class="icon printer"></span>
    <span class="icon account"></span>
    <span class="icon super-admin"></span>
    <span class="icon mail"></span>
    <span class="icon reply"></span>
    <span class="icon search"></span>
    <span class="icon sign-out"></span>
    <span class="icon info"></span>
    <span class="icon help"></span>
    <span class="icon phone"></span>
    <span class="icon clock"></span>
    <span class="icon preview"></span>
    <span class="icon retry"></span>
    <span class="icon download"></span>
    <span class="icon frown"></span>
    <span class="icon meh"></span>
    <span class="icon smile"></span>

    <h1>Formulaires</h1>

    <form class="form">
      <%= form_for @dossier, url: '', html: { class: 'form' } do |f| -%>
        <%= render EditableChamp::SectionComponent.new(dossier: @dossier, type_de_champs: @dossier.revision.public_root_type_de_champs) %>

        <div class="editable-champ editable-champ-text">
          <label>Mot de passe</label>
          <input type="password" value="12345678">
        </div>

        <h3 class="fr-h5">Bouton radio verticaux</h3>

        <div class="radios vertical">
          <%= f.label :archived, value: true do -%>
            <%= f.radio_button :archived, true %> Option A

            <p class="notice">Une option tout à fait valable.</p>
          <%- end -%>

          <%= f.label :archived, value: false do -%>
            <%= f.radio_button :archived, false %> Option B

            <p class="notice">Une autre option, pas mal non plus.</p>
          <%- end -%>
        </div>

        <h3 class="fr-h5">Interrupteur</h3>

        <label class="toggle-switch">
          <%= f.check_box :archived, class: 'toggle-switch-checkbox' %>
          <span class="toggle-switch-control round"></span>
          <span class="toggle-switch-label on">Activé</span>
          <span class="toggle-switch-label off">Désactivé</span>
        </label>

        <div class="send-wrapper">
          <%= f.submit "Enregistrer un brouillon (formnovalidate)", formnovalidate: true, class: 'button send' %>
          <%= f.submit "Envoyer", class: 'button send primary' %>
        </div>

        <hr>
      <%- end -%>
    </form>

    <h1>Boutons</h1>

    <div class="patron-section">
      <%= link_to ".button", "#", class: "button" %>

      <%= link_to ".button.primary", "#", class: "button primary" %>

      <%= link_to ".button.secondary", "#", class: "button secondary" %>

      <%= link_to ".button.danger", "#", class: "button danger" %>

      <%= link_to "#", class: "button" do -%>
        <span class="icon follow"></span>
        Bouton avec icone et texte
      <%- end -%>

      <%= link_to "#", class: "button icon-only" do -%>
        <span class="icon follow"></span>
      <%- end -%>
    </div>

    <div class="patron-section">
      <button class="button" disabled>.button.disabled</button>

      <button class="button primary" disabled>.button.primary.disabled</button>

      <button class="button secondary" disabled>
        .button.secondary.disabled
      </button>

      <button class="button danger" disabled>.button.danger.disabled</button>
    </div>

    <div class="patron-section">
      <%= link_to ".button.accepted", "#", class: "button accepted" %>

      <%= link_to ".button.refused", "#", class: "button refused" %>

      <%= link_to ".button.without-continuation", "#", class: "button without-continuation" %>
    </div>

    <div class="patron-section">
      <%= link_to ".button.small", "#", class: "button small" %>

      <%= link_to ".button.small.primary", "#", class: "button small primary" %>
    </div>

    <div class="patron-section">
      <%= link_to ".button.large", "#", class: "button large" %>

      <%= link_to ".button.large.primary", "#", class: "button large primary" %>
    </div>

    <div class="patron-section">
      <%= link_to ".button.primary.expand", "#", class: "button primary expand" %>
    </div>

    <h1>Dropdown</h1>

    <div class="dropdown">
      <div class="button primary dropdown-button">
        .button.primary.dropdown-button
      </div>

      <div class="dropdown-content fade-in-down">
        <ul class="dropdown-items">
          <li>.dropdown-content ul.dropdown-items li</li>
          <li>.dropdown-content ul.dropdown-items li</li>
        </ul>
      </div>
    </div>

    <div class="dropdown">
      <div class="button dropdown-button">.button.dropdown-button</div>

      <div class="dropdown-content fade-in-down">
        <ul class="dropdown-items">
          <li>
            <a href="#">
              <span class="icon mail"></span>

              <div class="dropdown-description">
                <h4>Action</h4>
                <p>Explanation</p>
              </div>
            </a>
          </li>

          <li>
            <a href="#">
              <span class="icon edit"></span>

              <div class="dropdown-description">
                <h4>Other action</h4>
                <p>Explanation</p>
              </div>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="dropdown">
      <div class="button dropdown-button">.button.dropdown-button (left)</div>

      <div class="dropdown-content fade-in-down left-aligned">
        <ul class="dropdown-items">
          <li>.dropdown-content.left-aligned ul.dropdown-items li</li>
          <li>.dropdown-content.left-aligned ul.dropdown-items li</li>
        </ul>
      </div>
    </div>

    <h1>Labels</h1>

    <span class="label">.label</span>
    <span class="label brouillon">.label.brouillon</span>
    <span class="label instruction">.label.instruction</span>
    <span class="label construction">.label.construction</span>
    <span class="label accepted">.label.accepted</span>
    <span class="label refused">.label.refused</span>
    <span class="label without-continuation">.label.without-continuation</span>

    <h1>Cards</h1>

    <div class="card">
      <div class="card-title">
        Titre de la carte
      </div>

      <p>Et voici le contenu de la carte</p>
    </div>

    <div class="card feedback">
      <div class="card-title">
        Titre de la carte pour demander un avis
      </div>

      <p>
        Utilisez cette carte pour informer d’une nouveauté produit ou demander
        l’avis des utilisateurs.
      </p>
    </div>

    <h1>Table</h1>

    <table class="table">
      <thead>
        <tr>
          <th>Header 1</th>
          <th>Header 2</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td>Table Data 1</td>
          <td>Table Data 2</td>
        </tr>

        <tr>
          <td>Table Data 3</td>
          <td>Table Data 4</td>
        </tr>
      </tbody>
    </table>

    <h2>Vertical layout (.table.vertical)</h2>

    <table class="table vertical">
      <tbody>
        <tr>
          <th>Header 1</th>
          <td>Table Data 1</td>
        </tr>

        <tr>
          <th>Header 2</th>
          <td>Table Data 2</td>
        </tr>

        <tr>
          <th class="header-section" colspan="2">
            Header section
          </th>
        </tr>

        <tr>
          <th>Header 3</th>
          <td>Table Data 3</td>
        </tr>
      </tbody>
    </table>

    <h1>Header</h1>
  </div>

  <div class="sub-header">
    <div class="container">
      Titre
      <nav class="fr-tabs" role="navigation">
        <ul class="fr-tabs__list">
          <%= tab_item("Onglet actif", "#", active: true) %>
          <%= tab_item("Onglet inactif", "#") %>
          <%= tab_item("Onglet avec badge", "#", badge: 2) %>
          <%= tab_item("Onglet avec notification", "#", notification: true) %>
        </ul>
      </nav>
    </div>
  </div>

  <div class="container">
    <h1>Breadcrumbs</h1>

    <ul class="breadcrumbs">
      <li>
        <%= link_to "Démarche 123", "#" %>
      </li>

      <li>
        Dossier n° 38
      </li>
    </ul>

    <h1>Layout deux colonnes</h1>
  </div>

  <div class="two-columns">
    <div class="columns-container">
      <div class="column">
        Insérer ici le contenu de la colonne 1
      </div>

      <div class="column">
        Insérer ici le contenu de la colonne 2
      </div>
    </div>
  </div>

  <div class="container">
    <section class="ask-avis">
      <h1>Inviter une personne à donner son avis</h1>

      <p class="avis-notice">
        L’invité pourra consulter, donner un avis sur le dossier et contribuer
        au fil de messagerie, mais il ne pourra le modifier.
      </p>

      <%= form_for Avis.new, url: '/', html: { class: 'form' } do |f| -%>
        <%= f.text_area :introduction, rows: 3, value: "Bonjour, merci de me donner votre avis sur ce dossier.", required: true %>

        <div class="send-wrapper">
          <%= f.submit "Demander un avis", class: 'button send' %>
        </div>
      <%- end -%>
    </section>

    <section class="list-avis">
      <h1 class="title">
        Avis des invités <span class="fr-badge">1</span>
      </h1>

      <ul>
        <li class="one-avis">
          <h2 class="claimant">
            Vous <span class="date">Demande d’avis envoyée le 12/01/2012</span>
          </h2>

          <p>Bonjour, merci de me donner votre avis sur ce dossier.</p>

          <div class="answer flex align-start">
            <div class="icon bubble avis-icon"></div>

            <div class="width-100">
              <h2 class="instructeur">
                <%= Current.contact_email %>
                <span class="date">Réponse donnée le 13/01/2012</span>
              </h2>

              <p>Je donne un avis favorable</p>
            </div>
          </div>
        </li>
      </ul>
    </section>
  </div>

  <div class="container">
    <h2 class="empty-text">Aucun dossier</h2>

    <p class="empty-text-details">
      Vous n’avez commencé aucune démarche pour l’instant.
    </p>
  </div>

  <div class="container">
    <h1>Dsfr::CalloutComponent</h1>

    <p>
      <%= link_to "Documentation DSFR Mis en avant (callout)", "https://www.systeme-de-design.gouv.fr/elements-d-interface/composants/mise-en-avant", external_link_attributes("Documentation DSFR Mis en avant (callout)") %>
    </p>

    <%= render Dsfr::CalloutComponent.new(title: "Information minimale") do |c| -%>
      <%- c.with_body do -%>
        <p>Ceci est le minimum pour afficher un callout.</p>
      <%- end -%>
    <%- end -%>

    <%= render Dsfr::CalloutComponent.new(title: "Information importante ou avertissement", theme: :warning) do |c| -%>
      <%- c.with_body do -%>
        Le contenu de cette description est libre.
      <%- end -%>

      <%- c.with_bottom do -%>
        <button class="fr-btn">Call to action</button>
      <%- end -%>
    <%- end -%>

    <%= render Dsfr::CalloutComponent.new(title: "Titre d’une information positive", theme: :success, icon: "fr-icon-message-2-fill") do |c| -%>
      <%- c.with_body do -%>
        <p>
          N’importe quelle icône
          <%= link_to("du jeu d’icônes", "https://www.systeme-de-design.gouv.fr/elements-d-interface/fondamentaux-techniques/icones", external_link_attributes("du jeu d’icônes")) %>
          peut être utilisée.
        </p>
      <%- end -%>
    <%- end -%>

    <h1>Dsfr::CardVerticalComponent</h1>

    <p>
      <%= link_to "Documentation DSFR Carte", "https://www.systeme-de-design.gouv.fr/elements-d-interface/composants/carte", external_link_attributes("Documentation DSFR Carte") %>
    </p>

    <div class="fr-grid-row fr-grid-row--gutters fr-py-5w">
      <div class="fr-col-md-6 fr-col-12">
        <%= render Dsfr::CardVerticalComponent.new(title: "Optional title", desc: "Optional description") %>
      </div>

      <div class="fr-col-md-6 fr-col-12">
        <%= render Dsfr::CardVerticalComponent.new(title: "With footer buttons") do |c| -%>
          <%- c.with_footer_button do -%>
            <%= link_to "Button 1", "#", { class: "fr-btn" }.merge(external_link_attributes("Button 1")) %>
          <%- end -%>

          <%- c.with_footer_button do -%>
            <%= button_tag "Button 2", class: "fr-btn fr-btn--secondary" %>
          <%- end -%>
        <%- end -%>
      </div>
    </div>

    <h1>Dsfr::NoticeComponent</h1>

    <p>
      <%= link_to "Documentation DSFR Bandeau d’information", "https://www.systeme-de-design.gouv.fr/elements-d-interface/composants/bandeau-d-information-importante", external_link_attributes("Documentation DSFR Bandeau d’information") %>
    </p>

    <div class="fr-my-6v">
      <%= render Dsfr::NoticeComponent.new(closable: true) do |c| -%>
        <%- c.with_title do -%>
          Titre de cette notice <%= link_to "avec un lien optionnel.", "#" %>
          Des marges verticales ont ici été rajoutées.
        <%- end -%>
      <%- end -%>
    </div>
  </div>

  <div class="container">
    <h1 class="fr-mt-4w">Attachment::FileFieldComponent (single file)</h1>

    <span class="fr-hint-text">
      Note: direct upload, suppression ne marchent pas comme attendu ici.
    </span>

    <%- champ = @dossier.root_champs_public.find { _1.type_champ == TypeDeChamp.type_champs.fetch(:piece_justificative) } -%>
    <%- tdc = champ.type_de_champ -%>
    <%- avis = Avis.new -%>

    <%- if attachment = ActiveStorage::Attachment.last -%>
      <%- attachment.update(created_at: 1.second.ago) -%>
      <h3>New attachment</h3>
      <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(champ:), drop_zone: :none) %>
      <h3 class="fr-mt-4w">Existing attachment</h3>
      <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(champ:), drop_zone: :none) %>
      <h3 class="fr-mt-4w">Existing attachment, user can not destroy</h3>
      <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(champ:, user_can_destroy: false), drop_zone: :none) %>
      <h3 class="fr-mt-4w">Existing attachment, error</h3>
      <%- attachment.blob.metadata[:virus_scan_result] = ActiveStorage::VirusScanner::INFECTED -%>
      <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(champ:), drop_zone: :none) %>
      <h3 class="fr-mt-4w">New attachment on TypeDeChamp</h3>
      <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(attached_file: tdc.piece_justificative_template, auto_attach_url: "/some-auto-attach-path"), drop_zone: :none) %>
      <h3 class="fr-mt-4w">Existing attachment on TypeDeChamp, view as link</h3>
      <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(attached_file: tdc.piece_justificative_template, auto_attach_url: "/some-auto-attach-path"), drop_zone: :none) %>
      <h3 class="fr-mt-4w">
        Existing attachment on TypeDeChamp view as download
      </h3>
      <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(attached_file: tdc.piece_justificative_template, auto_attach_url: "/some-auto-attach-path", view_as: :download), drop_zone: :none) %>
      <h3 class="fr-mt-4w">New attachment on generic object</h3>
      <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(attached_file: avis.introduction_file), drop_zone: :none) %>
      <h3 class="fr-mt-4w">
        Existing attachment on generic object, view as download
      </h3>
      <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(attached_file: avis.introduction_file, view_as: :download), drop_zone: :none) %>
    <%- end -%>
  </div>
</div>
