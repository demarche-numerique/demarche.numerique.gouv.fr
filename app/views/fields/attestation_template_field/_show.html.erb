<% if field.data %>
  <strong>Activée</strong>
  <p><%= field.data.activated %></p>
  <strong>Logo</strong>
  <p>
    <% if field.data.logo.attached? %>
      <%= image_tag field.data.logo_url, alt: "Logo de l’attestation" %>
    <% else %>
      Aucun
    <% end %>
  </p>
  <% if field.data.version == 2 %>
    <strong>Corps</strong>
    <div><%= sanitize(field.body_html) %></div>
  <% else %>
    <strong>Titre</strong>
    <pre style="white-space: pre-wrap;">
      <%= field.data.title %>
    </pre>
    <strong>Corps</strong>
    <pre style="white-space: pre-wrap;">
      <%= field.data.body %>
    </pre>
  <% end %>
  <strong>Signature</strong>
  <p>
    <% if field.data.signature.attached? %>
      <%= image_tag field.data.signature, alt: "Signature de l’attestation" %>
    <% else %>
      Aucun
    <% end %>
  </p>
  <strong>Pied de page</strong>
  <pre style="white-space: pre-wrap;">
    <%= field.data.footer %>
  </pre>
<% else %>
  Aucun modèle d’attestation
<% end %>
