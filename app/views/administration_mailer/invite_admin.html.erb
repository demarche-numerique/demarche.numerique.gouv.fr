<% content_for(:title, t('.title')) %>

<p>
  <%= t(:hello, scope: [:views, :shared, :greetings]) %>
</p>

<p>
  <%= t('.thanks') %>
</p>

<p>
  <%= t('.account_created', email: @user.email) %>
</p>

<% if !@user.active? %>
  <p>
    <b>
      <%= t('.activate') %>
      <%= link_to(users_activate_url(token: @reset_password_token), users_activate_url(token: @reset_password_token)) %>
    </b>
  </p>
<% else %>
  <p>
    <b>
      <%= t('.sign_in') %>
      <%= link_to edit_user_password_url(@user, reset_password_token: @reset_password_token), edit_user_password_url(@user, reset_password_token: @reset_password_token) %>
    </b>
  </p>
<% end %>

<p>
  <%= render partial: "layouts/mailers/bizdev_signature", locals: { author_name: @author_name } %>
</p>
