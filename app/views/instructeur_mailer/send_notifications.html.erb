<% content_for(:title, t('.subject')) %>

<p>
  <%= t(:hello, scope: [:views, :shared, :greetings]) %>
</p>

<p>
  <%= t('.intro') %>
</p>

<ul>
  <% @data.each do |datum| %>
    <li>
      <%= link_to(datum[:procedure_libelle], instructeur_procedure_url(datum[:procedure_id])) %>

      <% if datum[:nb_en_construction] > 0 %>
        <br>
        <%= t('.en_construction', count: datum[:nb_en_construction]) %>
      <% end %>

      <% if datum[:nb_en_instruction] > 0 %>
        <br>
        <%= t('.en_instruction', count: datum[:nb_en_instruction]) %>
      <% end %>

      <% if datum[:nb_processed] > 0 %>
        <br>
        <%= t('.processed', count: datum[:nb_processed]) %>
        <% details = [] %>
        <% details << t('.accepted', count: datum[:nb_accepted]) if datum[:nb_accepted] > 0 %>
        <% details << t('.refused', count: datum[:nb_refused]) if datum[:nb_refused] > 0 %>
        <% details << t('.closed_without_continuation', count: datum[:nb_closed_without_continuation]) if datum[:nb_closed_without_continuation] > 0 %>
        <%= "(#{details.join(', ')})" %>
      <% end %>

      <% if datum[:nb_dossiers_with_notifications] > 0 %>
        <br>
        <%= t('.with_notifications', count: datum[:nb_dossiers_with_notifications]) %>
        <ul>
          <% %w[dossier_modifie message annotation_instructeur avis_externe].each do |type| %>
            <% if datum.dig(:nb_notifications, type)&.> 0 %>
              <li>
                <%= t('.notification', number: datum[:nb_notifications][type], label: t(type, scope: 'activerecord.attributes.notification').upcase) %>
              </li>
            <% end %>
          <% end %>
        </ul>
      <% end %>
    </li>
  <% end %>
</ul>

<%= render partial: "layouts/mailers/signature" %>
