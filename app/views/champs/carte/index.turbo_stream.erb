<%= turbo_stream.update dom_id(@champ, :geo_areas) do %>
  <%= render Dossiers::GeoAreasComponent.new(champ: @champ, editing: true, legacy_editor: true) %>
<% end %>

<% if @focus %>
  <%= turbo_stream.dispatch 'map:feature:focus', bbox: @champ.bounding_box %>
<% end %>

<% if @champ.public? %>
  <%= render partial: 'shared/dossiers/update_footer', locals: { dossier: @champ.dossier } %>
<% end %>
