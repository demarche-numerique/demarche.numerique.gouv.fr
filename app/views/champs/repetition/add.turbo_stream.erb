<% if @row.present? %>
  <%= turbo_stream.append dom_id(@champ, :rows), render(EditableChamp::RepetitionRowComponent.new(champ: @champ, row: @row, expanded: true)) %>

  <% if @first_champ_id %>
    <%= turbo_stream.focus(@first_champ_id, delay: 50) %>
  <% end %>

  <%= turbo_stream.replace dom_id(@champ, :repetition_actions) do %>
    <%= render partial: "champs/repetition/actions", locals: { champ: @champ, max_reached: @champ.max_reached? } %>
  <% end %>
<% end %>
