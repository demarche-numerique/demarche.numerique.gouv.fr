<% if @row_id.present? %>
  <%= fields_for @champ.input_name, @champ do |form| %>
    <%= turbo_stream.append dom_id(@champ, :rows), render(EditableChamp::RepetitionRowComponent.new(form: form, dossier: @champ.dossier, champ: @champ, row_id: @row_id, row_number: @row_number, expanded: true)) %>

    <% if @first_champ_id %>
      <%= turbo_stream.focus(@first_champ_id, delay: 50) %>
    <% end %>
  <% end %>

  <%= turbo_stream.replace dom_id(@champ, :repetition_actions) do %>
    <%= render partial: "champs/repetition/actions", locals: { champ: @champ, max_reached: @champ.max_reached? } %>
  <% end %>
<% end %>

<% if @champ.public? %>
  <%= render partial: 'shared/dossiers/update_footer', locals: { dossier: @champ.dossier } %>
<% end %>

<%= render partial: 'champs/repetition/clear_error', locals: { champ: @champ } %>
