<% content_for(:title, t("metas.users.dossiers.rendez_vous.title", number: @dossier.id.to_s, procedure_label: @dossier.procedure.libelle)) %>

<% content_for :footer do %>
  <%= render partial: "users/procedure_footer", locals: { procedure: @dossier.procedure, dossier: @dossier } %>
<% end %>

<div class="dossier-container fr-mb-8v">
  <%= render partial: 'users/dossiers/show/header', locals: { dossier: @dossier } %>

  <div class="container">
    <p class="fr-mb-2w">
      <h2 class="fr-h6">
        <%= t('views.users.dossiers.rendez_vous.title') %>
      </h2>

      <p>
        <%= link_to t('views.users.dossiers.rendez_vous.navigate_to_rdv_sp'), RdvService.rdv_sp_rdv_user_url(@rdv.rdv_external_id), target: '_blank', class: 'fr-link' %>
      </p>
    </p>
  </div>
</div>
