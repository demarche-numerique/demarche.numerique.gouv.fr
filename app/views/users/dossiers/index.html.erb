<% if params[:search].present? %>
  <% content_for(:title, t('views.users.dossiers.index.search.result_title', search_terms: params[:search])) %>
<% else %>
  <% content_for(:title, t('views.users.dossiers.index.metas.title')) %>
<% end %>

<turbo-frame id="dossiers_list" target="_top">
  <section class="dossiers-headers sub-header">
    <div class="fr-container">
      <% if params[:search].present? %>
        <p class="fr-mb-3w">
          <%= link_to t('views.users.dossiers.index.search.back_to_list'), dossiers_path, class: 'fr-link fr-icon-arrow-left-line fr-link--icon-left' %>
        </p>
        <h1 class="fr-h3">
          <%= t('views.users.dossiers.index.search.result_title', search_terms: params[:search]) %>
        </h1>
      <% else %>
        <%= render partial: 'index_header', locals: { corbeille_count: @corbeille_count } %>
        <% if @pending_transfers_count.positive? %>
          <div class="fr-my-3w">
            <%= render Dossiers::PendingTransfersBannerComponent.new(count: @pending_transfers_count) %>
          </div>
        <% end %>
      <% end %>

      <% if !@show_simple_list %>
        <%= render Dossiers::UserSearchComponent.new(
              search_terms: params[:search],
              active_filter_count: @filter.active_filter_tags.count,
              filter_params: filter_params_slice
            ) %>
      <% end %>
    </div>
  </section>

  <div class="fr-container">
    <% if @show_simple_list %>
      <%= render partial: 'dossiers_list', locals: { dossiers: @dossiers, filter: nil, search: false, statut: nil } %>
    <% else %>
      <% if @filter.active? %>
        <%= render Dossiers::UserActiveFiltersComponent.new(
              tags: @filter.active_filter_tags,
              current_filter_params: filter_params_slice
            ) %>
      <% end %>
      <% if @dossiers.any? %>
        <p class="results-count">
          <% if @dossiers.total_pages > 1 %>
            <%= t('views.users.dossiers.index.results_count',
                  page_from: @dossiers.offset_value + 1,
                  page_to: [@dossiers.offset_value + @dossiers.size, @total_count].min,
                  count: @total_count) %>
          <% else %>
            <%= t('views.users.dossiers.index.dossiers_count', count: @total_count) %>
          <% end %>
        </p>
      <% end %>
      <%= render partial: 'dossiers_list', locals: { dossiers: @dossiers, filter: @filter, search: params[:search].present?, statut: nil } %>
    <% end %>
  </div>
</turbo-frame>

<% if !@show_simple_list %>
  <%= render Dossiers::UserFilterPanelComponent.new(
        filter: @filter,
        filter_params: filter_params_slice,
        procedures_for_select: @procedures_for_select,
        has_invites: @counts[:shared_with_me].positive?
      ) %>
<% end %>
