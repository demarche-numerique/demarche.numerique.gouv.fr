<% content_for(:title, t('views.users.dossiers.transfer_requests.title')) %>

<div class="fr-container fr-py-4w">
  <div class="transfer-requests-close-top">
    <%= link_to dossiers_path, class: 'fr-btn fr-btn--tertiary-no-outline fr-icon-close-line fr-btn--icon-right' do %>
      <%= t('views.users.dossiers.transfer_requests.close') %>
    <% end %>
  </div>

  <h1 class="fr-h3">
    <span class="fr-icon-user-shared-line" aria-hidden="true"></span>
    <%= t('views.users.dossiers.transfer_requests.title') %>
  </h1>

  <p class="results-count fr-mb-3w">
    <%= t('views.users.dossiers.transfer_requests.count', count: @pending_transfers.size) %>
  </p>

  <% @pending_transfers.each do |dossier| %>
    <%= render partial: 'transfer_request', locals: { dossier: dossier } %>
  <% end %>
</div>

<div class="transfer-requests-close-bottom">
  <%= link_to t('views.users.dossiers.transfer_requests.close'), dossiers_path, class: 'fr-btn fr-btn--secondary' %>
</div>
