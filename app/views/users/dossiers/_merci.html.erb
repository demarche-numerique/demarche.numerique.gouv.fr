<div class="merci fr-pt-2w">
  <div class="fr-container fr-my-4w">
    <div class="fr-grid-row">
      <div class="fr-col-xl-2 preview-spacing"></div>

      <div class="fr-col-xl-8 preview-content">
        <p class="fr-h2 fr-my-4w">
          <i
            class="
              fr-icon-folder-check-line fr-icon--lg fr-text-default--info
              fr-mr-1w
            "
          ></i>

          <%= t('views.users.dossiers.merci.thanks') %>
        </p>

        <h1 class="send fr-my-2w fr-text--lg">
          <%= t('views.users.dossiers.merci.dossier_success', libelle: procedure.libelle) %>
        </h1>

        <p class="fr-my-2w">
          <%= t('views.users.dossiers.merci.dossier_acces_html') %>
        </p>

        <% dsm = local_assigns[:dossier_submitted_message] || procedure.active_dossier_submitted_message %>

        <% if dsm %>
          <div class="fr-my-4w">
            <% if dsm.tiptap_content? %>
              <div class="tiptap-content">
                <%= render SimpleFormatComponent.new(dsm.body_as_html, allow_a: true) %>
              </div>
            <% else %>
              <p><%= dsm.message_on_submit_by_usager %></p>
            <% end %>
          </div>
        <% end %>

        <p class="flex fr-mb-5w fr-mt-4w">
          <%= render(partial: 'users/dossiers/show/download_dossier', locals: { dossier: }) %>
          <%= link_to t('views.users.dossiers.merci.acces_dossier'), dossier ? dossier_path(dossier) : "#dossier", class: 'fr-btn fr-mx-2w' %>
        </p>

        <%= render Dossiers::AmiFollowComponent.new(dossier:) %>

        <hr class="fr-hr">

        <p>
          <%= link_to t('views.users.dossiers.merci.submit_dossier'), commencer_url(procedure.path), class: 'fr-btn fr-btn--secondary fr-mt-2w' %>
        </p>

        <%= render Dossiers::JdmaButtonComponent.new(procedure:) %>
      </div>
    </div>
  </div>
</div>
