<div class="card">
  <%= render partial: 'dossier_card_content', locals: { dossier: dossier, linkable: false } %>

  <%= render Dsfr::AlertComponent.new(state: :info, size: :sm, extra_class_names: "fr-pb-1w fr-mb-2w") do |c| %>
    <% c.with_body do %>
      <p class="fr-alert__title">
        <%= t('views.users.dossiers.transfer_requests.received_from', email: dossier.transfer.sender) %>
      </p>

      <ul class="fr-links-group fr-links-group--inline">
        <li>
          <%= link_to t('views.users.dossiers.transfer_requests.accept'),
              transfer_path(dossier.transfer),
              class: 'fr-link',
              method: :patch %>
        </li>

        <li>
          <%= link_to t('views.users.dossiers.transfer_requests.refuse'),
              transfer_path(dossier.transfer),
              class: 'fr-link',
              method: :delete,
              data: {
                confirm: t('views.users.dossiers.transfer_requests.refuse_confirm')
              } %>
        </li>
      </ul>
    <% end %>
  <% end %>
</div>
