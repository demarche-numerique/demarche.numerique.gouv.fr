<% content_for :procedure_logo do %>
  <%= render 'layouts/mailers/logo', url: @logo_url %>
<% end %>

<p><%= t(:hello, scope: [:views, :shared, :greetings]) %></p>

<p>
  <%= t(".#{@correction.reason}.explanation_html", dossier_id: @dossier.id, libelle_demarche: @dossier.procedure.libelle) %>
</p>

<% if @correction.dossier_complement? %>
  <p><%= t('.complement.link') %></p>
  <%= dsfr_button(t('.complement.access_label'), modifier_dossier_url(@dossier), :primary) %>
<% else %>
  <p><%= t('.link') %></p>
  <%= dsfr_button(t('.access_message'), messagerie_dossier_url(@dossier), :primary) %>
<% end %>

<% if @dossier.procedure.sva_svr_rule? && @dossier.sva_svr_decision_on.present? %>
  <p>
    <%= t(".#{@correction.reason}.sva_svr", rule_name: t(@dossier.procedure.sva? ? :sva : :svr, scope: 'shared.procedures.sva_svr_rule_name')) %>
  </p>
<% end %>

<%= render 'layouts/mailers/signature', service: @service %>

<% content_for :footer do %>
  <%= render 'layouts/mailers/service_footer', dossier: @dossier %>
<% end %>

<% content_for :sent_to do %>
  <%= render 'layouts/mailers/sent_to', dossier: @dossier %>
<% end %>
