<% content_for(:title, "#{@subject}") %>

<p><%= t(:hello, scope: [:views, :shared, :greetings]) %></p>

<p><%= t('.header', count: @dossiers_count) %></p>

<% if @dossiers %>
  <ul>
    <% @dossiers.each do |d| %>
      <li>n° <%= d.id %> (<%= d.procedure.libelle %>)</li>
    <% end %>
  </ul>
<% else %>
  <%= render "dossiers_count_by_procedure", counts: @dossiers_count_by_procedure, statut: 'supprimes' %>
<% end %>

<p>
  <%= t('.footer_html', count: @dossiers_count,
                        trash_url: instructeur_procedure_url(@dossiers_count_by_procedure.first.first, statut: "supprimes"),
                        procedures_url: instructeur_procedures_url,
                        deletion_date: human_date(@deletion_date.to_date)) %>
</p>

<%= render partial: "layouts/mailers/signature" %>
