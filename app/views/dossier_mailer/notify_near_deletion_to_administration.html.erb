<% content_for(:title, "#{@subject}") %>

<p><%= t(:hello, scope: [:views, :shared, :greetings]) %></p>

<p>
  <%= t('.header_termine_html', count: @dossiers_count, expiration_date: human_date(@expiration_date.to_date)) %>
</p>

<% if @dossiers %>
  <ul>
    <% @dossiers.each do |d| %>
      <li>
        <%= link_to("N° #{d.id} (#{d.procedure.libelle})", instructeur_dossier_url(d.procedure, d)) %>.
        Retrouvez le dossier au format
        <%= link_to("PDF", instructeur_dossier_url(d.procedure, d, format: :pdf)) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "dossiers_count_by_procedure", counts: @dossiers_count_by_procedure, statut: 'expirant' %>
<% end %>

<%= render partial: "layouts/mailers/signature" %>
