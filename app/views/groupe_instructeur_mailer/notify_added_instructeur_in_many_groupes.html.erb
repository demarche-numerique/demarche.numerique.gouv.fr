<% content_for(:title, t(".title")) %>

<p><%= t(:hello, scope: [:views, :shared, :greetings]) %></p>

<p>
  <%= t(".email_body.html",
      count: @groups.count,
      groupe: @groups.first.label,
      email: @current_instructeur_email,
      procedure: @procedure.libelle) %>

  <% if @groups.count > 1 %>
    <ul>
      <% @groups.each do |group| %>
        <li><%= group.label %></li>
      <% end %>
    </ul>
  <% end %>
</p>

<p>
  <%= dsfr_button(t(".access_button"), instructeur_procedure_url(@procedure), :primary) %>
</p>

<%= render partial: "layouts/mailers/signature" %>
