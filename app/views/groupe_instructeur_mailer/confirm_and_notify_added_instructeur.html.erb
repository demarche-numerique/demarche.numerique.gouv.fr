<p>
  <%= t(".next_connections_html", application_name: APPLICATION_NAME, sign_in_url: new_user_session_url) %>
</p>

<p><%= t(".tutorial_html", tutorial_url: INSTRUCTEUR_TUTORIAL_URL) %></p>

<%= render partial: "layouts/mailers/signature" %>
