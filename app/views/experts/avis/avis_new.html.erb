<% content_for(:title, "Avis · Dossier n° #{@dossier.id} (#{@dossier.owner_name})") %>
<%= render partial: 'header', locals: { avis: @avis, dossier: @dossier } %>

<div class="container">
  <div class="fr-grid-row">
    <div class="fr-col fr-col-12 fr-col-md-3">
      <%= render partial: 'sidemenu' %>
    </div>

    <div class="fr-col">
      <% if @dossier.avis_creatable? %>
        <%= render partial: "shared/avis/form", locals: { url: avis_expert_avis_path(@avis.procedure, @avis), linked_dossiers: @dossier.linked_dossiers_for(current_expert).avis_creatable, must_be_confidentiel: @avis.confidentiel?, avis: @new_avis, batch_action: false, procedure: @dossier.procedure, from_expert: true } %>
      <% else %>
        <%= render partial: "shared/avis/creation_blocked", locals: { dossier: @dossier } %>
      <% end %>
    </div>
  </div>
</div>
