<% content_for(:title, t('.title', dossier_id: @dossier.id, owner_name: @dossier.owner_name)) %>
<%= render partial: 'header', locals: { avis: @avis, dossier: @dossier } %>

<div class="container">
  <div class="fr-grid-row">
    <div class="fr-col fr-col-12 fr-col-md-3">
      <%= render partial: 'sidemenu' %>
    </div>

    <div class="fr-col">
      <% if @avis_for_expert.present? %>
        <%= render partial: 'shared/avis/list', locals: { avis: @avis_for_expert, avis_seen_at: nil, expert_or_instructeur: current_expert } %>
      <% else %>
        <h2 class="empty-text">
          <%= t('helpers.information_text.empty_text') %>
        </h2>
        <p class="empty-text-details">
          <%= t('helpers.information_text.empty_text_detail') %>
        </p>
      <% end %>
    </div>
  </div>
</div>
