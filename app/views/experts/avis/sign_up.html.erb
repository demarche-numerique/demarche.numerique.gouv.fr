<div class="fr-container fr-my-5w">
  <div class="fr-grid-row fr-grid-row--center">
    <div class="fr-col-lg-6">
      <%= form_for(User.new(email: @email), url: sign_up_expert_avis_path(email: @email), method: :post, html: { class: "fr-py-5w", data: { turbo: true } }) do |f| %>
        <%= f.hidden_field :confirmation_token, value: @confirmation_token %>

        <h1 class="fr-h2">
          <%= t('views.registrations.new.title', name: Current.application_name) %>
        </h1>

        <fieldset
          class="fr-mb-0 fr-fieldset"
          aria-labelledby="create-account-legend"
        >
          <div class="fr-fieldset__element">
            <p><%= t('asterisk_html', scope: [:utils]) %></p>
          </div>

          <div class="fr-fieldset__element">
            <%= render Dsfr::InputComponent.new(form: f, attribute: :email, input_type: :email_field, opts: { disabled: true }) %>
          </div>

          <div class="fr-fieldset__element">
            <%= render Dsfr::InputComponent.new(form: f, attribute: :password, input_type: :password_field, opts: { autocomplete: 'new-password', data: { controller: 'turbo-input', turbo_input_url_value: show_password_complexity_path }, aria: {describedby: 'password_hint'}}) %>

            <div id="password_complexity">
              <%= render PasswordComplexityComponent.new %>
            </div>
          </div>
        </fieldset>

        <%= f.submit t('views.shared.account.create', application_name: Current.application_name), id: 'submit-password', disabled: :disabled, class: "fr-btn fr-btn--lg fr-mt-2w", data: { turbo_submits_with: t('views.users.passwords.edit.submit_loading') } %>
      <% end %>
    </div>
  </div>
</div>
