<% content_for(:title, @subject) %>
<% merge_link = france_connect_merge_using_email_link_url(email_merge_token: @email_merge_token) %>

<p><%= t(:hello, scope: [:views, :shared, :greetings]) %></p>

<p><%= t('.click_link') %></p>

<%= dsfr_button t('user_mailer.shared.confirm_button'), merge_link, :primary %>

<p><%= t('.link_html', link: link_to(merge_link, merge_link)) %></p>

<p>
  <%= t('.validity', duration: distance_of_time_in_words(FranceConnectInformation::MERGE_VALIDITY), expires_at: I18n.l(@email_merge_token_created_at + FranceConnectInformation::MERGE_VALIDITY, format: :deadline)) %>
</p>

<p>
  <%= t('user_mailer.shared.ignore_or_contact_html', contact_link: mail_to(CONTACT_EMAIL)) %>
</p>

<%= render partial: "layouts/mailers/signature" %>
