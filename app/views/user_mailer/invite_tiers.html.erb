<% content_for(:title, t('.title', application_name: APPLICATION_NAME)) %>

<p><%= t(:hello, scope: [:views, :shared, :greetings]) %></p>

<% if @dossier.present? %>
  <p>
    <%= t('.started_for_procedure', procedure: @dossier.procedure.libelle, email: @dossier.user.email) %>
  </p>
<% else %>
  <p><%= t('.started', application_name: APPLICATION_NAME) %></p>
<% end %>

<p>
  <%= t('.confirm') %>
  <%= dsfr_button t('user_mailer.shared.confirm_button'), users_confirm_email_url(token: @token), :primary %>
</p>

<p>
  <%= t('.link_html', link: link_to(users_confirm_email_url(token: @token), users_confirm_email_url(token: @token))) %>
</p>

<% if @dossier.present? %>
  <p><%= t('.learn_more', email: @dossier.user.email) %></p>
<% else %>
  <p>
    <%= t('user_mailer.shared.support_html', contact_link: link_to(CONTACT_EMAIL, "mailto:#{CONTACT_EMAIL}")) %>
  </p>
<% end %>

<%= render partial: "layouts/mailers/signature" %>
