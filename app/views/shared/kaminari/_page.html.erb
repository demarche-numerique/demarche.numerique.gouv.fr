<li>
  <%= link_to_unless page.current?, page, url, rel: page.rel, remote: remote, class: 'fr-pagination__link', 'aria-current': page.current? ? 'page' : nil, title: t('.title', page:), role: 'link' do %>
    <%= content_tag 'a', page, 'aria-current': 'page', title: t('.title', page:), class: 'fr-pagination__link' %> <%# herb:disable html-anchor-require-href %>
  <% end %>
</li>
