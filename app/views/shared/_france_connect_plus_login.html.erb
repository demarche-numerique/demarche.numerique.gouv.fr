<% if FranceConnectPlusService.enabled? -%>
  <div class="fr-connect-group fr-my-2w">
    <%= link_to(url, class: "fr-btn fr-connect fr-connect--plus") do -%>
      <span class="fr-connect__login">
        <%= t('views.shared.france_connect_login.login_button') %>
      </span>

      <span class="fr-connect__brand">FranceConnect</span>
    <% end -%>

    <p>
      <%= link_to t('views.shared.france_connect_login.plus_help_link'), "https://www.franceconnect.gouv.fr/franceconnect-plus/", title: new_tab_suffix(t('views.shared.france_connect_login.plus_help_link')), **external_link_attributes %>
    </p>
  </div>
<% else -%>
  <p class="fr-my-2w">
    <%= t('views.shared.france_connect_login.plus_unavailable') %>
  </p>
<% end -%>
