<div id="dossier-infos-generales" class="fr-px-2w fr-mb-4w">
  <div class="fr-my-2w">
    <ul>
      <li>
        <%= t(:submitted_at, scope: [:views, :shared, :dossiers, :form], datetime: l(dossier.depose_at, format: :long_with_time)) %>
      </li>

      <% if dossier.last_champ_updated_at.present? && dossier.last_champ_updated_at > dossier.depose_at %>
        <li>
          <%= t(:user_updated_at, scope: [:views, :shared, :dossiers, :form], datetime: l(dossier.last_champ_updated_at, format: :long_with_time)) %>
        </li>
      <% end %>

      <% if dossier.last_champ_instructeur_updated_at.present? %>
        <li>
          <%= t(:instructeur_updated_at, scope: [:views, :shared, :dossiers, :form], datetime: l(dossier.last_champ_instructeur_updated_at, format: :long_with_time)) %>
        </li>
      <% end %>

      <% if dossier.en_instruction_at.present? %>
        <li>
          <%= t(:switched_to_instruction_at, scope: [:views, :shared, :dossiers, :form], datetime: l(dossier.en_instruction_at, format: :long_with_time)) %>
        </li>
      <% end %>

      <% if dossier.pending_correction? %>
        <li>
          <%= t(:revert_to_submitted_at, scope: [:views, :shared, :dossiers, :form], datetime: l(dossier.pending_correction.created_at, format: :long_with_time)) %>
        </li>
      <% end %>

      <% if dossier.termine? %>
        <% if dossier.accepte? %>
          <li>
            <%= t(:acceptee_at, scope: [:views, :shared, :dossiers, :form], datetime: l(dossier.processed_at, format: :long_with_time)) %>
          </li>
        <% end %>
        <% if dossier.refuse? %>
          <li>
            <%= t(:refuse_at, scope: [:views, :shared, :dossiers, :form], datetime: l(dossier.processed_at, format: :long_with_time)) %>
          </li>
        <% end %>
        <% if dossier.sans_suite? %>
          <li>
            <%= t(:closed_at, scope: [:views, :shared, :dossiers, :form], datetime: l(dossier.processed_at, format: :long_with_time)) %>
          </li>
        <% end %>
      <% end %>
    </ul>

    <div class="fr-highlight">
      <p class="fr-text--sm fr-text-mention--grey">
        <%= t('views.shared.dossiers.demande.en_construction_notice') %>
      </p>
    </div>
  </div>

  <% if profile == 'usager' && dossier.hide_info_with_accuse_lecture? %>
    <%= render Dossiers::AccuseLectureComponent.new(dossier:) %>
  <% else %>
    <% if dossier.justificatif_motivation.attached? %>
      <div class="fr-mb-2w">
        <span class="champ-label">
          <%= t('views.users.dossiers.show.status_overview.justificatif') %>
        </span>

        <%= render Attachment::ShowComponent.new(attachment: dossier.justificatif_motivation.attachment) %>
      </div>
    <% end %>
    <% if dossier.motivation.present? %>
      <span class="champ-label">
        <%= t('views.users.dossiers.show.status_overview.motivation') %>
      </span>
      <blockquote class="fr-m-0">
        <strong><%= simple_format(dossier.motivation) %></strong>
      </blockquote>
    <% end %>
    <% if dossier.attestation.present? && dossier.attestation.pdf.attached? %>
      <%= render Dossiers::RowShowComponent.new(label: t('views.users.dossiers.show.status_overview.attestation')) do |c| %>
        <% c.with_value do %>
          <%= render Dsfr::DownloadComponent.new(attachment: dossier.attestation.pdf, name: t(:download_attestation, scope: [:views, :shared, :dossiers, :form]), has_name: true) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
