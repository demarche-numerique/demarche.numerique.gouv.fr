<%= fields_for champ.input_name, champ do |form| %>
  <% if full %>
    <%= turbo_stream.replace champ.input_group_id do %>
      <%= render EditableChamp::EditableChampComponent.new champ:, form: %>
    <% end %>
  <% else %>
    <%= turbo_stream.update input_label_id(champ) do %>
      <%= render EditableChamp::ChampLabelContentComponent.new champ:, form: %>
    <% end %>
  <% end %>

  <%# Announce the champ status into its persistent sr-only live region, which is %>
  <%# never recreated by the replace above. See EditableChamp::SectionComponent. %>
  <%# Always updated, empty when there is nothing to announce: a stale status must not %>
  <%# outlive the value it was about. An empty update is not read out. %>
  <% polling = local_assigns.fetch(:polling, false) %>

  <% if full && champ.status_announceable? && !(polling && champ.pending?) %>
    <%= turbo_stream.update "#{champ.focusable_input_id}-aria-live" do %>
      <%= render Dsfr::InputStatusMessageComponent.new(champ:, as_announcement: true) %>
    <% end %>
  <% end %>
<% end %>
