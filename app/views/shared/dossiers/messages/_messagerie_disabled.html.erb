<div class="no-flex-xs flex align-center fr-mb-2w">
  <button
    class="
      fr-btn fr-icon-add-line fr-btn--icon-left fr-mr-2w fr-hidden
      fr-unhidden-md
    "
    type="button"
    disabled
  >
    <%= t('shared.messagerie.new_message') %>
  </button>

  <p class="fr-mb-0 fr-text-mention--grey fr-text--sm">
    La messagerie est désormais désactivée.
  </p>

  <% if service.present? && controller.try(:nav_bar_profile) == :user %>
    <button
      class="fr-btn fr-btn--sm fr-btn--tertiary-no-outline fr-ml-2v"
      aria-controls="messagerie-close-explanations"
      aria-haspopup="dialog"
      data-fr-opened="false"
    >
      + d’infos
    </button>
  <% end %>
</div>
