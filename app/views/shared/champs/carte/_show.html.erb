<% if champ.geometry? -%>
  <react-fragment class="width-100">
    <%= render ReactComponent.new("MapReader", feature_collection: champ.to_feature_collection, options: champ.render_options) %>
  </react-fragment>
  <div class="geo-areas">
    <%= render Dossiers::GeoAreasComponent.new(champ:, editing: false) %>
  </div>
<% end -%>
