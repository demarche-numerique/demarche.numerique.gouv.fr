<% content_for(:title, t('.title', name: @api_token.name)) %>

<p><%= t('.hello') %></p>

<p>
  <strong>
    <%= t('.expires', name: @api_token.name, date: l(@api_token.expires_at, format: :long)) %>
  </strong>
</p>

<p><%= t('.how_to_replace') %></p>

<% if @co_recipient_emails.any? %>
  <p>
    <%= t('.co_recipients', count: @co_recipient_emails.size, emails: @co_recipient_emails.to_sentence) %>
  </p>
<% end %>

<p><%= link_to profil_url, profil_url %></p>

<%= render partial: "layouts/mailers/signature" %>
