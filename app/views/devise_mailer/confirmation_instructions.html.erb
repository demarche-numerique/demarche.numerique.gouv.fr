<% if @user.unconfirmed_email.nil? %>
  <% content_for(:title, @subject) %>
  <p><%= t(:hello, scope: [:views, :shared, :greetings]) %></p>
  <% link = confirmation_url(@user, confirmation_token: @token, procedure_id: @procedure&.id, prefill_token: @prefill_token) %>
  <p>
    Pour confirmer votre adresse électronique et activer votre compte sur
    <%= APPLICATION_NAME %>, veuillez cliquer sur le bouton ci-dessous&nbsp;:
  </p>
  <p>
    <%= dsfr_button('Activer mon compte', link, :primary) %>
  </p>
  <p>
    Si le bouton ci-dessus ne fonctionne pas, veuillez copier/coller le lien
    suivant dans votre navigateur&nbsp;: <%= link_to(link, link) %>
  </p>
<% else %>
  <% content_for(:title, "Changement d’adresse électronique") %>
  <p><%= t(:hello, scope: [:views, :shared, :greetings]) %></p>
  <p>
    Pour confirmer votre changement d’adresse électronique, veuillez cliquer sur
    le lien suivant&nbsp;:
    <%= link_to(confirmation_url(@user, confirmation_token: @token), confirmation_url(@user, confirmation_token: @token)) %>
  </p>
<% end %>

<%= render partial: "layouts/mailers/signature" %>
