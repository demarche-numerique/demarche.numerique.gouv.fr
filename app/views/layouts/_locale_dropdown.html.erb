<%= render Dsfr::TranslateMenuComponent.new(id: "translate", title: t('.select_locale')) do |c| %>
  <% c.with_button do %>
    <%= I18n.locale.upcase %>
    <span class="fr-hidden-lg">&nbsp;- <%= t('.locale_name') %></span>
  <% end %>

  <li>
    <%= active_locale_link(:fr) do %>
      FR - Français
    <% end %>
  </li>

  <li>
    <%= active_locale_link(:en) do %>
      EN - English
    <% end %>
  </li>
<% end %>
