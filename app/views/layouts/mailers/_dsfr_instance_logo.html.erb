<%# Instance logo — float left, next to Marianne, light/dark variants %>
<table
  style="border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;"
  width="80"
  cellspacing="0"
  cellpadding="0"
  role="presentation"
  border="0"
  align="left"
  bgcolor="#ffffff"
  class="darkmode"
>
  <tbody>
    <tr>
      <td align="left">
        <table
          style="border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;"
          width="100%"
          cellspacing="0"
          cellpadding="0"
          role="presentation"
          border="0"
          align="left"
          bgcolor="#ffffff"
          class="darkmode"
        >
          <tbody>
            <tr>
              <td
                height="12"
                style="line-height:12px; font-size:12px; height:12px;"
              >
                &nbsp;
              </td>
            </tr>

            <tr>
              <td class="hide-black" align="left">
                <%= image_tag image_url(LOGO_SRC), alt: "Logo #{APPLICATION_NAME}", style: "display:block; margin-left:10px; height:auto; width:56px;", width: "56", border: "0", class: "hide-black" %>
              </td>
            </tr>

            <tr>
              <td class="hide-white" align="left">
                <%= image_tag image_url(LOGO_DARK_SRC), alt: "Logo #{APPLICATION_NAME}", style: "display:block; margin-left:10px; height:auto; width:56px;", width: "56", border: "0", class: "hide-white" %>
              </td>
            </tr>

            <tr>
              <td
                height="12"
                style="line-height:12px; font-size:12px; height:12px;"
              >
                &nbsp;
              </td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
  </tbody>
</table>
