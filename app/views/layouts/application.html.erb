<!DOCTYPE html>

<% root_class = yield(:root_class) %>

<html lang="<%= html_lang %>" class="<%= root_class %>" data-fr-scheme="system">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta name="application-name" content="<%= Current.application_name %>">

    <meta
      name="apple-mobile-web-app-title"
      content="<%= Current.application_name %>"
    >

    <meta
      name="format-detection"
      content="telephone=no,date=no,address=no,email=no,url=no"
    >

    <% if request.host != ENV["APP_HOST"] %>
      <link
        rel="canonical"
        href="<%= "https://#{ENV['APP_HOST']}#{request.fullpath}" %>"
      >
    <% end %>

    <%= csrf_meta_tags %>

    <% if administrateur_signed_in? || instructeur_signed_in? %>
      <script
        id="lasuite-gaufre-script"
        async
        type="module"
        src="https://integration.lasuite.numerique.gouv.fr/widgets/dist/lagaufre.js"
      ></script>
      <script nonce="<%= request.content_security_policy_nonce %>">
        window._lasuite_widget = window._lasuite_widget || [];
        document.addEventListener('DOMContentLoaded', () => {
          // There are two trigger buttons (mobile navbar + desktop toolbar), only one
          // visible per breakpoint. The widget is a single instance keyed by name and
          // toggles every bound button at once, so we bind it to a single button: the
          // one visible at load (mobile devices load at the mobile breakpoint).
          const button = ['lasuite-gaufre-mobile', 'lasuite-gaufre-desktop']
            .map((id) => document.getElementById(id))
            .find((el) => el && el.offsetParent !== null);
          if (!button) return;
          window._lasuite_widget.push(['lagaufre', 'init', {
            api: 'https://lasuite.numerique.gouv.fr/api/services',
            label: 'Les services de La Suite numérique',
            closeLabel: 'Fermer le menu',
            headerLabel: 'À propos',
            loadingText: 'Chargement…',
            newWindowLabelSuffix: ' (nouvelle fenêtre)',
            buttonElement: button,
            position: () => {
              const rect = button.getBoundingClientRect();
              return {
                position: 'fixed',
                top: rect.bottom + 8,
                right: window.innerWidth - rect.right
              };
            }
          }]);

          // The v2 widget renders its panel in a Shadow DOM with a hardcoded light
          // theme. Inject a dark-mode override (scoped to the host via :host(.lasuite-dark))
          // and toggle it from the DSFR theme so the panel follows the app's dark scheme.
          const DARK_CSS = ':host(.lasuite-dark) .wrapper-dialog{background:#1e1e1e;border-color:#353535}' +
            ':host(.lasuite-dark) #header,:host(.lasuite-dark) #more-apps,:host(.lasuite-dark) #footer{border-color:#353535}' +
            ':host(.lasuite-dark) .service-name{color:#8585f6}' +
            ':host(.lasuite-dark) .service-card:hover{background-color:#2a2a2a}' +
            ':host(.lasuite-dark) .maturity-badge{background:#2a2a2a;color:#8585f6}' +
            ':host(.lasuite-dark) #close,:host(.lasuite-dark) #show-more-button,:host(.lasuite-dark) #loading{color:#cecece}' +
            ':host(.lasuite-dark) #close:hover,:host(.lasuite-dark) #show-more-button:hover{background-color:#2a2a2a;color:#fff}';
          const setupDarkMode = (host) => {
            const style = document.createElement('style');
            style.textContent = DARK_CSS;
            host.shadowRoot.appendChild(style);
            const sync = () => host.classList.toggle(
              'lasuite-dark',
              document.documentElement.getAttribute('data-fr-theme') === 'dark'
            );
            sync();
            new MutationObserver(sync).observe(document.documentElement, {
              attributes: true,
              attributeFilter: ['data-fr-theme']
            });
          };
          // The host is created asynchronously once the widget script has loaded.
          const existing = document.getElementById('lasuite-widget-lagaufre-shadow');
          if (existing && existing.shadowRoot) {
            setupDarkMode(existing);
          } else {
            const observer = new MutationObserver(() => {
              const host = document.getElementById('lasuite-widget-lagaufre-shadow');
              if (host && host.shadowRoot) {
                observer.disconnect();
                setupDarkMode(host);
              }
            });
            observer.observe(document.body, { childList: true });
          }
        });
      </script>
    <% end %>

    <title>
      <% if content_for?(:title) && @procedure&.libelle.present? %>
        <%= "#{sanitize(yield(:title)).gsub("&nbsp;", " ")} · ##{@procedure.id} · #{truncate(sanitize(@procedure.libelle).gsub("&nbsp;", " "), length: 30)} · #{Current.application_name}" %>
      <% elsif content_for?(:title) %>
        <%= "#{sanitize(yield(:title)).gsub("&nbsp;", " ")} · #{Current.application_name}" %>
      <% elsif @procedure&.libelle.present? %>
        <%= "##{@procedure.id} · #{truncate(sanitize(@procedure.libelle).gsub("&nbsp;", " "), length: 30)} · #{Current.application_name}" %>
      <% else %>
        <%= Current.application_name %>
      <% end %>
    </title>

    <%= render partial: "layouts/favicons" %>

    <%= Gon::Base.render_data(camel_case: true, init: true, nonce:  request.content_security_policy_nonce) %>

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag 'application' %>

    <% if user_signed_in? %>
      <%= vite_javascript_tag 'chatbot' %>
    <% end %>

    <%= preload_link_tag(asset_url("Marianne-Regular.woff2")) %>
    <%= preload_link_tag(asset_url("Spectral-Regular.ttf")) %>

    <%= vite_stylesheet_tag 'main', media: 'all' %>
    <%= stylesheet_link_tag 'application', media: 'all' %>

    <%= yield(:invisible_captcha_styles) %>
    <%= render partial: 'layouts/setup_theme' %>

    <% if content_for?(:meta_robots) %>
      <meta name="robots" content="<%= content_for(:meta_robots) %>">
    <% end %>
  </head>

  <body
    id="<%= content_for(:page_id) %>"
    class="<%= browser.platform.ios? ? 'ios' : '' %>"
    data-controller="turbo number-input fix-table-border"
  >
    <%= render partial: 'layouts/skiplinks' %>
    <%= render partial: 'layouts/display_theme_modal' %>

    <div class="page-wrapper">
      <% if ENV['TEAM_ON_STRIKE'].present? %>
        <%= render partial: 'layouts/strike_banner' %>
      <% end %>

      <%= render partial: "layouts/outdated_browser_banner" %>
      <%= render partial: 'layouts/pre_maintenance' %>

      <% if staging? %>
        <div id="beta">Env Test</div>
      <% end %>

      <div id="sticky-header" class="sticky-header-container">
        <%= content_for(:sticky_header) %>
      </div>

      <%= render partial: "layouts/header" %>

      <main id="contenu" role="main">
        <%= render partial: "layouts/flash_messages" %>

        <%= content_for?(:content) ? yield(:content) : yield %>
      </main>

      <% if content_for?(:footer) %>
        <%= content_for(:footer) %>
      <% else %>
        <%= render 'footer' %>
      <% end %>

      <%= yield :charts_js %>
    </div>

    <template id="progress-bar-template">
      <%= render Dsfr::ProgressBarComponent.new do %>
        <slot name="filename"></slot>
      <% end %>
    </template>

    <%= render BottomRightActionsComponent.new %>
  </body>
</html>
