<% content_for :procedure_logo do %>
  <%= render 'layouts/mailers/logo', url: @logo_url %>
<% end %>

<p>
  <%= t("layouts.mailers.for_tiers.good_morning") %>
</p>

<p>
  <%= t("layouts.mailers.for_tiers.first_part", dossier_id: number_with_delimiter(@dossier.id), mandataire_first_name: @dossier.mandataire_first_name, mandataire_last_name: @dossier.mandataire_last_name) %>
  <span style="font-weight: bold;"><%= @dossier.procedure.libelle %></span>

  <% if @repasser_en_instruction %>
    <%= t("layouts.mailers.for_tiers.repasser_en_instruction") %>
  <% elsif @dossier.hide_info_with_accuse_lecture? %>
    <%= t("layouts.mailers.for_tiers.accuse_lecture", processed_at: l(@dossier.updated_at.to_date, format: :long)) %>
  <% else %>
    <%= t("layouts.mailers.for_tiers.#{@dossier.state}", processed_at: l(@dossier.updated_at.to_date, format: :long)) %>
  <% end %>
</p>

<p>
  <%= t("layouts.mailers.for_tiers.second_part") %>
  <%= mail_to(@dossier.user_email_for(:notification)) %>.
</p>

<p>
  <%= t(:best_regards, scope: [:views, :shared, :greetings]) %>
  <br>
  <%= t('layouts.mailers.signature.team') %>
  <%= application_name_without_link %>
</p>
