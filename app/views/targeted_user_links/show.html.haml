- content_for(:title, "Whoops. Mauvais compte")

.merci.text-center.fr-mb-14v
  .container
    = image_tag('user/envoi-dossier.svg', alt: '', class: 'fr-mt-16v')
    %h1.fr-mt-8v.fr-mb-6v.fr-mx-0 Attention, ce lien ne vous est pas destiné
    %p.send.fr-text--lg
      L’invitation est à destination de
      %strong.test-target-email= @targeted_user_link.target_email
      %br
      Mais vous êtes connecté avec
      %strong.test-current-email= current_user.email
    %p
      Veuillez vous reconnecter avec la bonne adresse électronique

    .flex.column.align-center
      = button_to destroy_user_session_path, method: :delete, class: "button primary", form: { data: { turbo: false } } do
        %span.fa.fa-sign-out
        Me déconnecter
