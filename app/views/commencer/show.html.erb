<% content_for(:title, @procedure.libelle) %>
<% content_for(:meta_robots, @procedure.publiee? && @procedure.robots_indexable? ? "index,follow" : "noindex,nofollow") %>
<% content_for(:hide_header_signin, true) %>
<% content_for(:pro_connect_path, commencer_pro_connect_path(path: @procedure.path, prefill_token: @prefilled_dossier&.prefill_token)) %>

<div class="commencer form">
  <%- if !user_signed_in? -%>
    <%= render ProcedureDraftWarningComponent.new(revision: @revision, current_administrateur:, extra_class_names: "fr-mb-2w") %>
    <%= render Dsfr::CalloutComponent.new(title: t(".start_procedure"), heading_level: 'h2') do |c| -%>
      <% c.with_html_body do -%>
        <%- if @procedure.pro_connect_restriction_all? -%>
          <% c.with_body do -%>
            <%= render ProConnectLoginComponent.new(url: commencer_pro_connect_path(path: @procedure.path, prefill_token: @prefilled_dossier&.prefill_token), title: nil) %>

            <div class="fr-alert fr-alert--info">
              <p>
                <%= t('.pro_connect_restriction_all_info_html', path: pro_connect_login_path) %>
              </p>
            </div>
          <%- end -%>
        <%- else -%>
          <div class="fr-grid-row fr-grid-row--gutters">
            <div class="fr-col-12 fr-col-lg-5">
              <%= render partial: 'shared/france_connect_login', locals: { url: commencer_france_connect_path(path: @procedure.path, prefill_token: @prefilled_dossier&.prefill_token), heading_level: :h3 } %>

              <%- if @procedure.pro_connect_for_moral_procedure? -%>
                <%= render ProConnectLoginComponent.new(url: commencer_pro_connect_path(path: @procedure.path, prefill_token: @prefilled_dossier&.prefill_token), heading_level: :h3, title: t('views.shared.france_connect_login.commencer_pc_title')) %>
              <%- end -%>
            </div>

            <div class="fr-hidden fr-unhidden-lg fr-col-lg-1">
              <div
                class="fr-vr-or"
                role="separator"
                aria-orientation="vertical"
              >
                <span>
                  <%= t('views.shared.france_connect_login.separator') %>
                </span>
              </div>
            </div>

            <div
              class="fr-col-12 fr-hr-or-mobile"
              role="separator"
              aria-orientation="horizontal"
            >
              <span>
                <%= t('views.shared.france_connect_login.separator') %>
              </span>
            </div>

            <div class="fr-col-12 fr-col-lg-6 flex justify-center column">
              <h3 class="fr-h6">
                <%= t('views.shared.account.account_title', application_name: Current.application_name) %>
              </h3>

              <ul class="fr-btns-group">
                <li>
                  <%= link_to commencer_sign_up_path(path: @procedure.path, prefill_token: @prefilled_dossier&.prefill_token), class: 'fr-btn' do %>
                    <%= t('views.shared.account.create', application_name: Current.application_name) %>
                  <% end %>
                </li>

                <li>
                  <%= link_to t('views.shared.account.already_user'), commencer_sign_in_path(path: @procedure.path, prefill_token: @prefilled_dossier&.prefill_token), class: 'fr-btn fr-btn--secondary' %>
                </li>
              </ul>
            </div>
          </div>
        <%- end -%>
      <%- end -%>
    <%- end -%>
  <%- else -%>
    <%= render ProcedureDraftWarningComponent.new(revision: @revision, current_administrateur:, extra_class_names: "fr-mb-2w") %>
    <%- if @procedure.pro_connect_restriction_all? && !logged_in_with_pro_connect? -%>
      <div class="fr-alert fr-alert--warning fr-mb-2w">
        <p>
          <%= t('.pro_connect_restriction_all_info_html', path: pro_connect_login_path) %>
        </p>

        <div class="fr-mt-3w"><%= render ProConnectLoginComponent.new %></div>
      </div>
    <%- elsif @prefilled_dossier -%>
      <%= render Dsfr::CalloutComponent.new(title: t(".prefilled_draft"), heading_level: 'h2') do |c| -%>
        <% c.with_body do -%>
          <p>
            <%= t('.prefilled_draft_detail_html', time_ago: time_ago_in_words(@prefilled_dossier.created_at), procedure: @procedure.libelle) %>
          </p>

          <%= link_to t('.go_to_prefilled_file'), url_for_dossier(@prefilled_dossier), class: 'fr-btn fr-mb-2w' %>
        <%- end -%>
      <%- end -%>
    <%- elsif @dossiers.empty? -%>
      <%= link_to t('.start_dossier'), url_for_new_dossier(@revision), class: 'fr-btn fr-mb-2w' %>
    <%- elsif @drafts.size == 1 && @not_drafts.empty? -%>
      <% dossier = @drafts.first %>
      <%= render Dsfr::CalloutComponent.new(title: t(".already_draft"), heading_level: 'h2') do |c| -%>
        <% c.with_body do -%>
          <p>
            <%= t('.already_draft_detail_html', time_ago: time_ago_in_words(dossier.created_at), procedure: @procedure.libelle) %>
          </p>

          <ul class="fr-btns-group fr-btns-group--inline">
            <li>
              <%= link_to t('.continue_file'), url_for_dossier(dossier), class: 'fr-btn' %>
            </li>

            <li>
              <%= link_to t('.start_new_file'), url_for_new_dossier(@revision), class: 'fr-btn fr-btn--secondary' %>
            </li>
          </ul>
        <%- end -%>
      <%- end -%>
    <%- elsif @not_drafts.size == 1 -%>
      <% dossier = @not_drafts.first %>
      <%= render Dsfr::CalloutComponent.new(title: t(".already_not_draft"), heading_level: 'h2') do |c| -%>
        <% c.with_body do -%>
          <p>
            <%= t('.already_not_draft_detail_html', time_ago: time_ago_in_words(dossier.depose_at), procedure: @procedure.libelle) %>
          </p>

          <ul class="fr-btns-group fr-btns-group--inline">
            <li>
              <%= link_to t('.show_my_submitted_file'), url_for_dossier(dossier), class: 'fr-btn' %>
            </li>

            <li>
              <%= link_to t('.start_new_file'), url_for_new_dossier(@revision), class: 'fr-btn fr-btn--secondary' %>
            </li>
          </ul>
        <%- end -%>
      <%- end -%>
    <%- else -%>
      <%= render Dsfr::CalloutComponent.new(title: t(".existing_dossiers"), heading_level: 'h2') do |c| -%>
        <% c.with_body do -%>
          <ul class="fr-btns-group fr-btns-group--inline">
            <li>
              <%= link_to t('.show_dossiers'), dossiers_path(procedure_id: @procedure.id), class: "fr-btn" %>
            </li>

            <li>
              <%= link_to t('.start_new_file'), url_for_new_dossier(@revision), class: "fr-btn fr-btn--secondary" %>
            </li>
          </ul>

          <p><%= t('.already_created', count: @preview_dossiers.size) %></p>

          <ul>
            <%- @preview_dossiers.each do |dossier| -%>
              <li>
                <%= link_to t('.already_created_details_html',
                id: number_with_html_delimiter(dossier.id),
                created_at: time_ago_in_words(dossier.created_at),
                state: dossier_display_state(dossier.state, lower: true)),
                dossier_path(dossier) %>
              </li>
            <%- end -%>
          </ul>
        <%- end -%>
      <%- end -%>
    <%- end -%>
    <%- if @procedure.feature_enabled?(:dossier_pdf_vide) -%>
      <hr>
      <p>
        <%= t('.want_empty_pdf', service: @procedure&.service&.nom, adresse: @procedure&.service&.adresse) %>
      </p>
      <br>
      <%= link_to t('.download_empty_pdf'), commencer_dossier_vide_for_revision_path(@revision), class: "fr-btn fr-btn--secondary fr-mb-2w" %>
    <%- end -%>
  <%- end -%>
</div>
