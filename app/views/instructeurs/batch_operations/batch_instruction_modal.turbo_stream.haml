- current_statut = params[:statut]
= turbo_stream.replace "instruction-modal-content" do
  #instruction-modal-content
    = render partial: "instructeurs/dossiers/instruction_modal_content", locals: { dossier: nil, operation: @operation == "reset" ? nil : @operation,batch: true, procedure: @procedure, dossier_ids: @dossier_ids, modal_title_data: @modal_title_data }

= turbo_stream.replace "instruction-modal-footer" do
  - if @operation != "reset"
    #instruction-modal-footer.fr-modal__footer
      .fr-btns-group.fr-btns-group--center.fr-btns-group--inline-reverse.fr-btns-group--inline-md
        %button.fr-btn{
          type: "submit",
          form: "batch-instruction-form",
          data: {
            turbo: "true",
            turbo_confirm: "Êtes-vous sûr de vouloir appliquer cette décision aux dossiers sélectionnés ?"
          }
        }
          Valider la décision

        = link_to "Retour", batch_instruction_modal_instructeur_batch_operations_path(@procedure, "reset", statut: current_statut), class: "fr-btn fr-btn--secondary", data: { turbo_method: :post, turbo: true }
  - else
    #instruction-modal-footer
