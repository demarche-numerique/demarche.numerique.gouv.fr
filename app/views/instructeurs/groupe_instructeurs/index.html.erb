<% content_for(:title, t('.title')) %>

<div class="sub-header">
  <div class="fr-container flex column">
    <%= render partial: 'shared/breadcrumbs', locals: {
      steps: [
        [@procedure.libelle.truncate_words(10), instructeur_procedure_path(@procedure)],
        [t('.heading')]
      ]
    } %>

    <%= render partial: 'instructeurs/procedures/header', locals: { procedure: @procedure } %>
  </div>
</div>

<div class="fr-container groupe-instructeur">
  <h1 class="fr-h4"><%= t('.heading') %></h1>

  <div class="card">
    <h2 class="fr-h3"><%= t('.groups_list') %></h2>

    <table class="table fr-mt-4v">
      <tbody>
        <% @groupes_instructeurs.each do |group| %>
          <tr>
            <td><%= group.label %></td>

            <td class="actions">
              <%= link_to instructeur_groupe_path(@procedure, group) do %>
                <%= t('.view') %>

                <span class="fr-sr-only">
                  <%= t('.view_group', label: group.label) %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= paginate @groupes_instructeurs, views_prefix: 'shared' %>
  </div>
</div>
