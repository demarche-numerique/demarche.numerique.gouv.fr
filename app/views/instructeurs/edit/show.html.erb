<% content_for(:title, t(".title", dossier_id: @dossier.id, demandeur: demandeur_dossier(@dossier))) %>

<div class="fr-container fr-my-4v">
  <%= link_to t('instructeurs.dossiers.edit.back'),
    instructeur_dossier_path(statut: params[:statut]),
    class: 'fr-link fr-icon-arrow-left-line fr-link--icon-left',
    data: { controller: 'confirm', confirm_message_value: t('instructeurs.dossiers.edit.confirm'), action: 'confirm#ask' } %>

  <div class="fr-mt-4v fr-mb-8v">
    <h1 class="fr-h3 fr-my-2v">
      <%= t(".heading", dossier_id: @dossier.id, demandeur: demandeur_dossier(@dossier)) %>
    </h1>

    <p class="fr-text--bold fr-mb-6v"><%= @dossier.procedure.libelle %></p>

    <%= render Instructeurs::EditDossierAlertComponent.new %>
  </div>
</div>

<div class="fr-container fr-my-4v">
  <div class="fr-grid-row fr-grid-row--center">
    <% summary = ViewableChamp::HeaderSectionsSummaryComponent.new(dossier: @dossier, is_private: false) %>
    <%= render summary %>

    <div class="<%= class_names("fr-col-12", "fr-col-xl-9" => summary.render?, "fr-col-xl-8" => !summary.render?) %>">
      <%= render partial: "shared/dossiers/edit_instructeur", locals: { dossier: @dossier, seen_at: @demande_seen_at } %>
    </div>
  </div>
</div>
