.motivation-wrapper{ class: local_assigns[:visible] ? nil : "hidden", data: { operation: opt[:operation], action: opt[:action]} }
  .motivation{ class: "#{opt[:operation]}", data: { controller: 'motivation-justificatif' } }

    - field_id = "motivation_#{opt[:operation]}"
    - required = opt[:operation] != 'accept'

    - if batch
      .fr-input-group{ id: "motivation-group-#{opt[:operation]}" }
        %label.fr-label{ for: field_id }
          = opt[:label]
          - if opt[:hint].present?
            %span.fr-hint-text
              = opt[:hint]

        = form.text_area :motivation,
          id: field_id,
          class: "fr-input js_batch_operation_motivation_#{opt[:operation]}",
          required: required,
          aria: { describedby: required ? "#{field_id}-error" : nil }

        - if required
          %p.fr-error-text.hidden{ id: "#{field_id}-error" }= t('instructeurs.dossiers.motivation_missing_error')

    - else
      .fr-input-group{ id: "motivation-group-#{opt[:operation]}" }
        = label_tag field_id, class: "fr-label" do
          = opt[:label]
          %span.fr-hint-text
            = opt[:hint]

        = text_area_tag "dossier[motivation]", nil,
          id: field_id,
          class: "fr-input",
          required: required,
          aria: { describedby: required ? "#{field_id}-error" : nil }

        - if required
          %p.fr-error-text.hidden{ id: "#{field_id}-error" }= t('instructeurs.dossiers.motivation_missing_error')

    / Justificatif
    .optional-justificatif{ id: "justificatif_motivation_suggest_#{opt[:operation]}", data: { motivation_justificatif_target: 'suggest' } }
      %button.fr-btn.fr-btn--tertiary-no-outline.fr-btn--icon-left.fr-btn--align-on-content.fr-icon-attachment-line{
        type: "button",
        data: { action: 'motivation-justificatif#showImport' }
      }
        = t('instructeurs.dossiers.add_justificatif')

    .hidden{ id: "justificatif_motivation_import_#{opt[:operation]}", data: { motivation_justificatif_target: 'import' } }
      - if batch
        = form.file_field :justificatif_motivation,
          id: "dossier_justificatif_motivation_#{opt[:operation]}",
          direct_upload: true,
          data: { motivation_justificatif_target: 'input', action: 'change->motivation-justificatif#fileSelected' }
      - else
        = file_field_tag "dossier[justificatif_motivation]",
          id: "dossier_justificatif_motivation_#{opt[:operation]}",
          direct_upload: true,
          data: { motivation_justificatif_target: 'input', action: 'change->motivation-justificatif#fileSelected' }

    .hidden{ id: "delete_motivation_import_#{opt[:operation]}", data: { motivation_justificatif_target: 'delete' } }
      %button.fr-btn.fr-btn--tertiary-no-outline.fr-btn--icon-left.fr-btn--align-on-content.fr-icon-delete-line{
        type: "button",
        data: { action: 'motivation-justificatif#delete' }
      }
        Supprimer le justificatif

    - if attestation_context[:template]&.activated?
      = render Dsfr::NoticeComponent.new(closable: false, data_attributes: { class: 'fr-my-2w' }) do |c|
        - c.with_title do
          = attestation_context[:title]
        - if !batch && attestation_context[:kind].present?
          - c.with_link do
            = link_to t('instructeurs.dossiers.preview_attestation'),
              apercu_attestation_instructeur_dossier_path(dossier.procedure, dossier, attestation_kind: attestation_context[:kind]),
              class: 'fr-notice__link',
              title: new_tab_suffix(t('instructeurs.dossiers.preview_attestation')),
              **new_tab_link_attributes

    - if !batch && attestation_context[:kind].present?
      = render partial: 'instructeurs/dossiers/unspecified_champs',
        locals: { unspecified_attestation_champs: dossier.unspecified_attestation_champs(attestation_context[:kind]) }
