= render partial: 'shared/dossiers/update_champs', locals: { to_show: @to_show, to_hide: @to_hide, to_update: @to_update }

- if !@dossier.private_champs_valid?
  = turbo_stream.show("alert-error-annotation")
  = turbo_stream.hide("instruction-action-tiles")
- else
  = turbo_stream.hide("alert-error-annotation")
  = turbo_stream.show("instruction-action-tiles")
