<% if batch || dossier.private_champs_valid? %>
  <div id="instruction-modal-footer"></div>
<% else %>
  <%= tag.div id: "instruction-modal-footer", class: "fr-modal__footer" do %>
    <div class="fr-btns-group fr-btns-group--center fr-btns-group--inline-md">
      <%= link_to t("instructeurs.dossiers.alert_error_annotations_link"), annotations_privees_instructeur_dossier_path(dossier.procedure, dossier, statut: params[:statut]), class: "fr-btn" %>
    </div>
  <% end %>
<% end %>
