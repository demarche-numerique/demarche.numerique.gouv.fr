= render Dropdown::MenuComponent.new(wrapper: :li, menu_options: { id: 'print-pj-menu'}, button_options: { class: ['fr-btn--sm ', 'fr-btn--secondary', 'fr-icon-download-line'], title: 'Télécharger'}) do |menu|
  - menu.with_button_inner_html do
    Télécharger
  - menu.with_item do
    = link_to telecharger_pjs_instructeur_dossier_path(dossier.procedure, dossier), class: "menu-item menu-link", role: 'menuitem', **new_tab_link_attributes("Télécharger le dossier et toutes ses pièces jointes") do
      Télécharger le dossier et toutes ses pièces jointes


= render Dropdown::MenuComponent.new(wrapper: :li, menu_options: { id: 'print-menu'}, button_options: { class: ['fr-btn--sm ', 'fr-btn--secondary', 'fr-icon-printer-line', 'fr-ml-2w'], title: 'Imprimer'}) do |menu|
  - menu.with_button_inner_html do
    Imprimer

  - menu.with_item do
    = link_to print_instructeur_dossier_path(dossier.procedure, dossier), role: 'menuitem', class: "menu-item menu-link", **new_tab_link_attributes("Imprimer tout le dossier") do
      Tout le dossier

  - menu.with_item do
    = link_to '#', role: 'menuitem', onclick: "window.print()", class: "menu-item menu-link" do
      Uniquement cet onglet

  - menu.with_item do
    = link_to instructeur_dossier_path(dossier.procedure, dossier, statut: params[:statut], format: :pdf), class: "menu-item menu-link", role: 'menuitem', **new_tab_link_attributes("Export PDF") do
      Export PDF

  - if dossier.geo_data?
    - menu.with_item do
      = link_to  geo_data_instructeur_dossier_path(dossier.procedure, dossier), class: "menu-item menu-link", role: 'menuitem', **new_tab_link_attributes("Export GeoJSON") do
        Export GeoJSON
