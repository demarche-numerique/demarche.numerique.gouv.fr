- if faq_link.present? && contact_link.present?
  %ul
    %li.fr-mb-2v
      = link_to t('.faq_link'), faq_link , class: footer ? '' : 'fr-link fr-link--sm', **helpers.external_link_attributes(t('.faq_link'))
    %li.fr-mb-2w
      = link_to t('.contact_link'), contact_link, class: footer ? '' : 'fr-link fr-link--sm', **helpers.external_link_attributes(t('.contact_link'))

- elsif faq_link.present? || contact_link.present?
  .fr-mb-2w
    - if faq_link.present?
      = link_to t('.faq_link'), faq_link , class: footer ? '' : 'fr-link fr-link--sm', **helpers.external_link_attributes(t('.faq_link'))
    - if contact_link.present?
      = link_to t('.contact_link'), contact_link, class: footer ? '' : 'fr-link fr-link--sm', **helpers.external_link_attributes(t('.contact_link'))

%dl.border-left-dark
  - if dossier.present? && dossier&.messagerie_available?
    .flex.fr-mb-2v
      %dt.fr-mr-2v
        %span.fr-icon-message-2-line.fr-icon--sm{ "aria-hidden": "true" }
        %span.fr-sr-only= t('layouts.mailers.service_footer.by_messagerie')
      %dd
        = link_to t('.contact_instructeur'), messagerie_dossier_path(dossier)

  - if email.present?
    .flex.fr-mb-2v
      %dt.fr-mr-2v
        %span.fr-icon-mail-line.fr-icon--sm{ "aria-hidden": "true" }
        %span.fr-sr-only= t('layouts.mailers.service_footer.by_email')
      %dd
        = link_to email, "mailto:#{email}"
  .flex.fr-mb-2v
    %dt.fr-mr-2v
      %span.fr-icon-phone-line.fr-icon--sm{ "aria-hidden": "true" }
      %span.fr-sr-only= t('layouts.mailers.service_footer.by_phone')
    %dd
      = link_to telephone, telephone_url
  .flex.fr-mb-2v
    %dt.fr-mr-2v
      %span.fr-icon-time-line.fr-icon--sm{ "aria-hidden": "true" }
      %span.fr-sr-only= t('layouts.mailers.service_footer.schedule')
    %dd
      = horaires

  - if other_contact_info.present?
    .flex.fr-mb-2v
      %dt.fr-mr-2v
        %span.fr-icon-info-i.fr-icon--sm{ "aria-hidden": "true" }
      %dd
        = other_contact_info
