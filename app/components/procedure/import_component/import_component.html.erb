<% if @procedure.routing_enabled? %>
  <button
    class="
      fr-btn fr-btn--secondary fr-icon-upload-line fr-btn--icon-left
      fr-mb-3w fr-ml-2w
    "
    aria-controls="modal-import"
    aria-haspopup="dialog"
    data-fr-opened="false"
  >
    <%= t('.button_groupes') %>
  </button>
<% else %>
  <button
    class="
      fr-btn fr-btn--secondary fr-icon-upload-line fr-btn--icon-left
      fr-mb-3w
    "
    aria-controls="modal-import"
    aria-haspopup="dialog"
    data-fr-opened="false"
  >
    <%= t('.button_instructeurs') %>
  </button>
<% end %>

<%= render Dsfr::ModalComponent.new(id: 'modal-import', size: :lg, icon: 'fr-icon-upload-line') do |modal| %>
  <% modal.with_title { @procedure.routing_enabled? ? t('.title_groupes') : t('.title_instructeurs') } %>

  <% if @procedure.routing_enabled? %>
    <div class="fr-tabs">
      <ul class="fr-tabs__list fr-ml-2w" role="tablist">
        <li role="presentation">
          <button
            class="fr-tabs__tab"
            id="tab-import-groupes"
            role="tab"
            aria-selected="true"
            aria-controls="panel-import-groupes"
            tabindex="0"
          >
            <%= t('.tabs.groupes') %>
          </button>
        </li>

        <li role="presentation">
          <button
            class="fr-tabs__tab"
            id="tab-import-contact"
            role="tab"
            aria-selected="false"
            aria-controls="panel-import-contact"
            tabindex="-1"
          >
            <%= t('.tabs.contact_informations') %>
          </button>
        </li>
      </ul>

      <div
        class="fr-tabs__panel fr-tabs__panel--selected"
        id="panel-import-groupes"
        role="tabpanel"
        aria-labelledby="tab-import-groupes"
      >
        <p class="fr-mb-2w">
          <%= t(".groupes.notice_html", csv_max_size: number_to_human_size(csv_max_size)) %>
        </p>

        <div class="fr-alert fr-icon-mail-line fr-mb-3w">
          <p><%= t(".groupes.alert_email_notifications_html") %></p>
        </div>

        <%= form_tag import_admin_procedure_groupe_instructeurs_path(@procedure), method: :post, multipart: true, data: { turbo: true, controller: 'enable-submit-if-uploaded' } do %>
          <label class="fr-label fr-text--bold">
            <%= t('.file_to_import') %>
          </label>

          <div class="fr-download">
            <%= link_to groupes_template_path, { class: "fr-download__link", download: '' } do %>
              <%= t('.download_template') %>

              <span class="fr-download__detail">
                <%= groupes_template_detail %>
              </span>
            <% end %>
          </div>

          <div class="fr-hint-text fr-mb-1w">
            <%= t('.file_size_limit', max_file_size: number_to_human_size(csv_max_size)) %>
          </div>

          <div
            class="flex column"
            data-action="input->enable-submit-if-uploaded#upload"
          >
            <%= file_field_tag :csv_file, required: true, accept: 'text/csv', class: 'fr-mb-2w', id: 'csv_file_groupes', data: { 'enable-submit-if-uploaded-target': 'input' } %>
          </div>

          <div class="fr-toggle fr-mb-1w">
            <input
              class="fr-toggle__input"
              id="overwrite_groupes"
              type="checkbox"
              name="overwrite"
              value="1"
            >

            <label
              class="fr-toggle__label"
              for="overwrite_groupes"
              data-fr-checked-label="Activé"
              data-fr-unchecked-label="Désactivé"
            >
              <%= t('.overwrite.routed_label') %>
            </label>
          </div>

          <p class="fr-hint-text fr-mb-2w">
            <%= t('.overwrite.hint') %>
          </p>

          <ul class="fr-btns-group fr-btns-group--inline-sm">
            <li>
              <button
                class="fr-btn fr-btn--secondary"
                type="button"
                aria-controls="modal-import"
              >
                <%= t('.cancel') %>
              </button>
            </li>

            <li>
              <%= submit_tag t('.import_file'), class: 'fr-btn', data: { turbo_submits_with: "Envoi...", turbo_confirm: t('.groupes.confirm'), 'enable-submit-if-uploaded-target': 'submit' }, disabled: true %>
            </li>
          </ul>
        <% end %>
      </div>

      <div
        class="fr-tabs__panel"
        id="panel-import-contact"
        role="tabpanel"
        aria-labelledby="tab-import-contact"
      >
        <p class="fr-mb-2w">
          <%= t(".contact_informations.notice_html") %>
        </p>

        <div class="fr-alert fr-alert--info fr-mb-3w">
          <p>
            <%= t(".contact_informations.info_1_html") %>
          </p>

          <p>
            <%= t(".contact_informations.info_2_html") %>
          </p>
        </div>

        <%= form_tag import_contact_informations_admin_procedure_groupe_instructeurs_path(@procedure), method: :post, multipart: true, data: { turbo: true, controller: 'enable-submit-if-uploaded' } do %>
          <label class="fr-label fr-text--bold">
            <%= t('.file_to_import') %>
          </label>

          <div class="fr-download">
            <%= link_to contact_informations_template_path, { class: "fr-download__link", download: '' } do %>
              <%= t('.download_template') %>

              <span class="fr-download__detail">
                <%= contact_informations_template_detail %>
              </span>
            <% end %>
          </div>

          <div class="fr-hint-text fr-mb-1w">
            <%= t('.file_size_limit', max_file_size: number_to_human_size(csv_max_size)) %>
          </div>

          <div
            class="flex column"
            data-action="input->enable-submit-if-uploaded#upload"
          >
            <%= file_field_tag :csv_file, required: true, accept: 'text/csv', class: 'fr-mb-2w', id: 'csv_file_contact', data: { 'enable-submit-if-uploaded-target': 'input' } %>

            <ul class="fr-btns-group fr-btns-group--inline-sm">
              <li>
                <button
                  class="fr-btn fr-btn--secondary"
                  type="button"
                  aria-controls="modal-import"
                >
                  <%= t('.cancel') %>
                </button>
              </li>

              <li>
                <%= submit_tag t('.import_file'), class: 'fr-btn', data: { turbo_submits_with: "Envoi...", turbo_confirm: t('.contact_informations.confirm'), 'enable-submit-if-uploaded-target': 'submit' }, disabled: true %>
              </li>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="fr-mb-2w">
      <%= t(".instructeurs.notice_html", csv_max_size: number_to_human_size(csv_max_size)) %>
    </p>
    <div class="fr-alert fr-icon-mail-line fr-mb-3w">
      <p><%= t(".instructeurs.alert_email_notifications_html") %></p>
    </div>
    <%= form_tag import_admin_procedure_groupe_instructeurs_path(@procedure), method: :post, multipart: true, data: { turbo: true, controller: 'enable-submit-if-uploaded' } do %>
      <label class="fr-label fr-text--bold"><%= t('.file_to_import') %></label>

      <div class="fr-download">
        <%= link_to groupes_template_path, { class: "fr-download__link", download: '' } do %>
          <%= t('.download_template') %>

          <span class="fr-download__detail">
            <%= groupes_template_detail %>
          </span>
        <% end %>
      </div>

      <div class="fr-hint-text fr-mb-1w">
        <%= t('.file_size_limit', max_file_size: number_to_human_size(csv_max_size)) %>
      </div>

      <div
        class="flex column"
        data-action="input->enable-submit-if-uploaded#upload"
      >
        <%= file_field_tag :csv_file, required: true, accept: 'text/csv', class: 'fr-mb-2w', id: 'csv_file_instructeurs', data: { 'enable-submit-if-uploaded-target': 'input' } %>
      </div>

      <div class="fr-toggle fr-mb-1w">
        <input
          class="fr-toggle__input"
          id="overwrite_instructeurs"
          type="checkbox"
          name="overwrite"
          value="1"
        >

        <label
          class="fr-toggle__label"
          for="overwrite_instructeurs"
          data-fr-checked-label="Activé"
          data-fr-unchecked-label="Désactivé"
        >
          <%= t('.overwrite.not_routed_label') %>
        </label>
      </div>

      <p class="fr-hint-text fr-mb-2w"><%= t('.overwrite.hint') %></p>

      <ul class="fr-btns-group fr-btns-group--inline-sm">
        <li>
          <button
            class="fr-btn fr-btn--secondary"
            type="button"
            aria-controls="modal-import"
          >
            <%= t('.cancel') %>
          </button>
        </li>

        <li>
          <%= submit_tag t('.import_file'), class: 'fr-btn', data: { turbo_submits_with: "Envoi...", turbo_confirm: t('.instructeurs.confirm'), 'enable-submit-if-uploaded-target': 'submit' }, disabled: true %>
        </li>
      </ul>
    <% end %>
  <% end %>
<% end %>
