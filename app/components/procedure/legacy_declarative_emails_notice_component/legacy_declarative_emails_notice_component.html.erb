<%= render Dsfr::NoticeComponent.new(state: 'warning', extra_class_names: 'fr-mb-2w') do |c| %>
  <% c.with_desc do %>
    <%= t('.body_html') %>
  <% end %>

  <% c.with_link do %>
    <button
      type="button"
      class="fr-btn fr-btn--secondary fr-btn--sm fr-ml-2w"
      data-fr-opened="false"
      aria-controls="<%= MODAL_ID %>"
    >
      <%= t('.learn_more') %>
    </button>
  <% end %>
<% end %>

<%# visible title carried by the alert: the modal keeps its own for screen readers %>
<%= render Dsfr::ModalComponent.new(id: MODAL_ID, size: :lg, icon: nil, title_hidden: true) do |modal| %>
  <% modal.with_title { t('.modal.title') } %>

  <%= render Dsfr::AlertComponent.new(state: :info, title: t('.modal.title'), heading_level: 'h2') do |c| %>
    <% c.with_body do %>
      <p><%= t('.modal.what_changes_html') %></p>

      <p>
        <%= t(".modal.what_you_lose.#{declarative_state}_html") %>
      </p>

      <p>
        <%= link_to t('.modal.documentation'), EMAILS_AUTOMATIQUES_DOC_URL,
              target: '_blank', rel: 'noopener', class: 'fr-link' %>
      </p>
    <% end %>
  <% end %>

  <%= button_to t('.modal.switch'),
        switch_to_combined_admin_procedure_email_templates_path(procedure),
        method: :patch,
        class: 'fr-btn fr-mt-2w' %>
<% end %>
