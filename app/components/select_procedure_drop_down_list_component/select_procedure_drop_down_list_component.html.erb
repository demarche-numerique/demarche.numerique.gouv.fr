<%= form_with url: @action_path, class: @form_class, id: 'select-procedure-drop-down-list-component', data: { turbo: false, controller: 'autosubmit' } do %>
  <div class="fr-col-12 fr-col-sm-10 fr-col-md-8 flex align-center">
    <%= label_tag :procedure_id, t('.label_html'), class: 'fr-label fr-text--bold fr-mr-2w', id: 'select-procedure-drop-down-list-label', for: 'select-procedure-drop-down-list' %>

    <react-fragment class="flex-1">
      <%= render ReactComponent.new "Select/SingleSelect", **react_props %>
    </react-fragment>

    <input
      class="hidden"
      type="submit"
      formmethod="get"
      formaction="<%= @action_path %>"
      formnovalidate
      data-autosubmit-target="submitter"
    >
  </div>
<% end %>
