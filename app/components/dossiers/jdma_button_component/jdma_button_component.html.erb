<%= render Dsfr::CalloutComponent.new(title: t('jdma.title'), theme: :blue_ecume, heading_level: 'h2', extra_class_names: ['fr-mt-5w']) do |c| %>
  <% c.with_html_body do %>
    <p><%= t('jdma.body') %></p>

    <%= link_to href, class: 'inline-block fr-raw-link fr-mt-2w', **helpers.external_link_attributes(t('jdma.alt')) do %>
      <%= image_tag 'jdma/bouton-bleu-light.svg', alt: t('jdma.alt'), class: 'hidden-on-dark-theme' %>
      <%= image_tag 'jdma/bouton-bleu-dark.svg', alt: t('jdma.alt'), class: 'hidden-on-light-theme' %>
    <% end %>
  <% end %>
<% end %>
