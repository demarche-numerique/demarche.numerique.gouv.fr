<div class="user-search-bar">
  <%= form_with url: dossiers_path, method: :get, data: { turbo_frame: "dossiers_list", turbo_action: "advance" }, class: "user-search-bar__form" do %>
    <% filter_hidden_inputs.each do |name, value| %>
      <%= hidden_field_tag name, value %>
    <% end %>

    <label for="search" class="fr-label">
      <%= t('views.users.dossiers.index.search.placeholder_label', default: 'Rechercher un dossier') %>
    </label>

    <span class="fr-hint-text">
      <%= t('views.users.dossiers.index.search.placeholder_hint', default: 'Par n° de dossier, nom / prénom, SIRET, mots-clés…') %>
    </span>

    <div class="fr-search-bar">
      <input
        type="search"
        id="search"
        name="search"
        class="fr-input"
        autocomplete="off"
        placeholder="<%= t('views.users.dossiers.index.search.placeholder_text', default: 'Saisissez votre recherche') %>"
        value="<%= search_terms %>"
      >

      <button class="fr-btn" type="submit">
        <%= t('views.users.dossiers.index.search.submit', default: 'Rechercher') %>
      </button>
    </div>
  <% end %>

  <button
    type="button"
    class="
      fr-btn fr-btn--tertiary-no-outline fr-icon-equalizer-2-line
      fr-btn--icon-left
    "
    data-fr-opened="false"
    aria-controls="dossiers-filter-modal"
  >
    <%= filter_button_label %>
  </button>
</div>
