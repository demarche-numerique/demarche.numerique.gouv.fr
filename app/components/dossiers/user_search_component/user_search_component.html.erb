<div class="user-search-bar">
  <%= form_with url: dossiers_path, method: :get, data: { turbo_frame: "dossiers_list", turbo_action: "advance" }, class: form_class do %>
    <% filter_params.each do |key, value| %>
      <% next if key.to_s == 'search' %>

      <% Array(value).each do |v| %>
        <%= hidden_field_tag "#{key}#{Array === value ? '[]' : ''}", v %>
      <% end %>
    <% end %>

    <%= render partial: 'users/dossiers/search_input', locals: { search_terms: search_terms } %>
  <% end %>

  <% if search_terms.present? %>
    <a
      href="#search-no-result"
      class="
        fr-link fr-icon-search-line fr-link--icon-left fr-text--bold
        fr-hidden-md user-search-bar__mobile-link
      "
    >
      <%= t('views.users.dossiers.index.search.submit') %>
    </a>
  <% end %>

  <button
    type="button"
    class="
      fr-btn fr-btn--tertiary-no-outline fr-icon-equalizer-line
      fr-btn--icon-left
      <%= filter_button_visibility_class %>
    "
    data-fr-opened="false"
    aria-controls="dossiers-filter-modal"
  >
    <%= filter_button_label %>
  </button>
</div>
