<div class="user-search-bar">
  <%= form_with url: dossiers_path, method: :get, data: { turbo_frame: "dossiers_list", turbo_action: "advance" }, class: "user-search-bar__form #{'user-search-bar__form--hidden-mobile' if search_terms.present?}" do %>
    <% filter_params.each do |key, value| %>
      <% next if key.to_s == 'search' %>

      <% Array(value).each do |v| %>
        <%= hidden_field_tag "#{key}#{Array === value ? '[]' : ''}", v %>
      <% end %>
    <% end %>

    <div class="fr-input-group">
      <label for="search" class="fr-label">
        <%= t('views.users.dossiers.index.search.placeholder_label') %>

        <span class="fr-hint-text">
          <%= t('views.users.dossiers.index.search.placeholder_hint') %>
        </span>
      </label>

      <div class="fr-search-bar fr-mt-2w">
        <input
          type="search"
          id="search"
          name="search"
          class="fr-input"
          placeholder="<%= t('views.users.dossiers.index.search.placeholder_text') %>"
          value="<%= search_terms %>"
          autocomplete="off"
        >

        <button class="fr-btn" type="submit">
          <%= t('views.users.dossiers.index.search.submit') %>
        </button>
      </div>
    </div>
  <% end %>

  <% if search_terms.present? %>
    <a
      href="#search-no-result"
      class="
        fr-link fr-icon-search-line fr-link--icon-left fr-text--bold
        fr-hidden-md user-search-bar__mobile-link
      "
    >
      <%= t('views.users.dossiers.index.search.submit') %>
    </a>
  <% end %>

  <button
    type="button"
    class="
      fr-btn fr-btn--tertiary-no-outline fr-icon-equalizer-line
      fr-btn--icon-left
      <%= filter_button_visibility_class %>
    "
    data-fr-opened="false"
    aria-controls="dossiers-filter-modal"
  >
    <%= filter_button_label %>
  </button>
</div>
