<div class="user-search-bar">
  <%= form_with url: dossiers_path, method: :get, data: { turbo_frame: "dossiers_list", turbo_action: "advance" }, class: "user-search-bar__form" do %>
    <% filter_params.each do |key, value| %>
      <% next if key.to_s == 'search' %>
      <% Array(value).each do |v| %>
        <%= hidden_field_tag "#{key}#{Array === value ? '[]' : ''}", v %>
      <% end %>
    <% end %>

    <label for="search" class="fr-label"><%= t('views.users.dossiers.index.search.placeholder_label', default: 'Rechercher un dossier') %></label>
    <span class="fr-hint-text"><%= t('views.users.dossiers.index.search.placeholder_hint', default: 'Par n° de dossier, nom / prénom, SIRET, mots-clés…') %></span>

    <div class="fr-search-bar">
      <input type="search" id="search" name="search" class="fr-input"
             placeholder="<%= t('views.users.dossiers.index.search.placeholder_text', default: 'Saisissez votre recherche') %>"
             value="<%= search_terms %>" />
      <button class="fr-btn" type="submit"><%= t('views.users.dossiers.index.search.submit', default: 'Rechercher') %></button>
    </div>
  <% end %>

  <button
    type="button"
    class="
      fr-btn fr-btn--tertiary-no-outline fr-icon-equalizer-line
      fr-btn--icon-left
    "
    data-fr-opened="false"
    aria-controls="dossiers-filter-modal"
  >
    <%= filter_button_label %>
  </button>
</div>
