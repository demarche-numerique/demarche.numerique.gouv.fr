<section class="ami-follow fr-mb-5w" aria-labelledby="ami-follow-title">
  <div class="fr-grid-row">
    <div class="fr-col-12 fr-col-md-6 fr-p-3w ami-follow__intro">
      <%= image_tag 'ami/illustration.svg', alt: '', class: 'ami-follow__illustration' %>

      <p id="ami-follow-title" class="fr-text--bold fr-mb-0">
        <%= t('.title', app_name: Ami::APP_NAME) %>
      </p>
    </div>

    <div class="fr-col-12 fr-col-md-6 fr-p-3w ami-follow__actions">
      <%= helpers.turbo_frame_tag "ami-consent", src: consent_path, loading: :lazy, "aria-live": "polite" do %>
        <%= render Dossiers::AmiConsentStateComponent.new(status: :loading, dossier:) %>
      <% end %>

      <p class="fr-my-2w">
        <%#
          Le picto du téléphone vient de la classe du bouton, celui du lien
          externe d'un span : DSFR ne pose qu'une seule icône par bouton.
          fr-icon--sm lui donne le 1rem que le bouton impose déjà au sien,
          faute de quoi il s'afficherait à la taille par défaut, 1.5rem.
        %>

        <%= link_to Ami::APP_URL, class: 'fr-btn fr-btn--icon-left fr-icon-smartphone-line', title: helpers.new_tab_suffix(t('.see_in_app')), **helpers.external_link_attributes do %>
          <%= t('.see_in_app') %>

          <span
            class="fr-ml-1w fr-icon-external-link-line fr-icon--sm"
            aria-hidden="true"
          ></span>
        <% end %>
      </p>

      <button
        class="fr-btn fr-btn--tertiary-no-outline fr-btn--sm"
        type="button"
        aria-controls="<%= MODAL_ID %>"
        aria-haspopup="dialog"
        data-fr-opened="false"
      >
        <%= t('.more_info') %>
      </button>
    </div>
  </div>

  <%= render Dsfr::ModalComponent.new(id: MODAL_ID, size: :lg, icon: 'fr-icon-information-line') do |modal| %>
    <% modal.with_title { t('.modal.title', app_name: Ami::APP_NAME) } %>

    <%= t('.modal.body_html', app_name: Ami::APP_NAME) %>
  <% end %>
</section>
