<div class="fr-background-alt--blue-france fr-p-2w fr-mb-n2w">
  <div class="batch-operation flex align-center">
    <span class="fr-mr-1w" data-batch-operation-target="checkboxCount">
      <%= t(".zero_selected") %>
    </span>

    <% if available_operations[:options].count.between?(1, 3) -%>
      <%= form_for(BatchOperation.new, url: instructeur_batch_operations_path(procedure_id: procedure.id), method: :post, html: { class: 'form', id: dom_id(BatchOperation.new) }, data: { turbo: true, turbo_confirm: t('.operations.confirm') }) do |form| %>
        <% available_operations[:options].each do |opt| -%>
          <%= render Dossiers::BatchOperationInlineButtonsComponent.new(opt:, icons:, form:, procedure:) %>
        <% end -%>
      <% end %>
    <% else -%>
      <%= form_for(BatchOperation.new, url: instructeur_batch_operations_path(procedure_id: procedure.id), method: :post, html: { class: 'form flex', id: dom_id(BatchOperation.new) }, data: { turbo: true, turbo_confirm: t('.operations.confirm') }) do |form| %>
        <% available_operations[:options][0, 2].each do |opt| -%>
          <%= render Dossiers::BatchOperationInlineButtonsComponent.new(opt:, icons:, form:, procedure:) %>
        <% end -%>

        <%= render Dropdown::MenuComponent.new(wrapper: :div, button_options: { class: ['fr-btn--sm', 'fr-btn--secondary', 'fr-ml-1w'], disabled: true, data: { batch_operation_target: 'dropdown' } }, menu_options: { id: 'state-menu', class: ['no-wrap'] }) do |menu| %>
          <% menu.with_button_inner_html do %>
            <%= t('.operations.other') %>
          <% end %>

          <% available_operations[:options][2, available_operations[:options].count].each do |opt| -%>
            <% unless expert_review_disallowed?(opt[:operation]) -%>
              <% menu.with_item do %>
                <%= form.button opt[:label], class: 'dropdown-items-link', role: 'menuitem', disabled: true, name: "#{form.object_name}[operation]", value: opt[:operation], data: { operation: opt[:operation] }.merge(opt[:modal_data].to_h), aria: { controls: opt[:aria].present? ? opt[:aria] : nil, haspopup: opt[:aria].present? ? 'dialog' : nil } do %>
                  <span class="<%= icons[opt[:operation].to_sym] %>"></span>

                  <div class="dropdown-description">
                    <h4><%= opt[:label] %></h4>
                  </div>
                <% end %>
              <% end %>
            <% end -%>
          <% end -%>
        <% end %>
      <% end %>
      <%= render Dsfr::ModalComponent.new(id: 'modal-avis-batch', size: :lg) do |modal| %>
        <% modal.with_title { t('.operations.create_avis') } %>
        <%= render partial: "shared/avis/form_wrapper", locals: { url: create_batch_avis_instructeur_batch_operations_path(procedure_id: procedure.id), linked_dossiers: nil, must_be_confidentiel: false, avis: Avis.new, batch_action: true, procedure:, dossier_ids: @ids } %>
      <% end %>
    <% end -%>

    <% if available_operations[:options].any? { it[:instruction] } -%>
      <%= render partial: 'instructeurs/dossiers/instruction_modal', locals: { dossier: nil, batch: true, procedure: } %>
    <% end -%>

    <%= render Dsfr::ModalComponent.new(id: 'modal-commentaire-batch', size: :lg) do |modal| %>
      <% modal.with_title do %>
        <span
          class="hidden"
          data-batch-operation-target="commentaireTitleSingular"
        >
          <%= t('.commentaire_modal.title_singular') %>
        </span>

        <span
          class="hidden"
          data-batch-operation-target="commentaireTitlePlural"
        >
          <%= t('.commentaire_modal.title_plural', count: '__COUNT__') %>
        </span>
      <% end %>

      <div data-batch-operation-target="commentaireFormContainer">
        <%= render partial: "instructeurs/batch_operations/commentaire_form", locals: { url: create_batch_commentaire_instructeur_batch_operations_path(procedure_id: procedure.id), commentaire: Commentaire.new, procedure:, dossier_ids: @ids } %>
      </div>

      <div class="hidden" data-batch-operation-target="commentaireWarning">
        <div class="fr-alert fr-alert--warning">
          <%= t('.commentaire_warning_html', limit: BatchOperation::BATCH_SELECTION_LIMIT) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
