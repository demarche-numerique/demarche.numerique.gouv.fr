<div class="fr-px-2w">
  <% if !@procedure.api_particulier_token? %>
    <%= render Dsfr::AlertComponent.new(
      state: '',
      extra_class_names: 'fr-mb-3w fr-icon-lock-fill'
    ) do |c| %>
      <% c.with_body do %>
        <p><%= t('.authorization_required_html') %></p>

        <p>
          <%= t('.api_token_required_html') %>

          <%= link_to(
            t('.api_tokens_link'),
            admin_procedure_jetons_path(@procedure),
            helpers.external_link_attributes
          ) %>
        </p>
      <% end %>
    <% end %>
  <% end %>

  <div class="<%= class_names(inactive: !@procedure.api_particulier_token?) %>">
    <hr class="fr-hr">

    <div class="fr-mb-1w cell">
      <p class="fake-label fr-text--bold flex-grow fr-mb-1v">
        <%= t('.success_title') %>
      </p>

      <p><%= t('.success_description', justificatif_label:) %></p>
    </div>

    <hr class="fr-hr">

    <div class="fr-mb-1w cell">
      <p class="fake-label fr-text--bold flex-grow fr-mb-1v">
        <%= t('.failure_title') %>
      </p>

      <p class="fr-mb-0">
        <%= t('.failure_description', justificatif_label:) %>
      </p>
    </div>

    <div class="fr-notice fr-notice--info fr-mb-2w fr-px-3w">
      <p>
        <span class="fr-notice__title"><%= t('.important_information') %></span>

        <%= t('.notice_intro') %>
      </p>

      <div class="notice__desc">
        <ul class="fr-mt-1v fr-ml-4w">
          <% t('.notice_cases').each do |notice_case| %>
            <li><%= notice_case %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
