<%= tag.li(**html_options.merge(class: ["type-de-champ flex column justify-start fr-mb-5v", html_options[:class]])) do %>
  <div
    class="type-de-champ-container"
    id="<%= dom_id(type_de_champ.stable_self, :editor_error) %>"
  >
    <% if @errors.present? %>
      <div class="types-de-champ-errors"><%= @errors %></div>
    <% end %>

    <div class="flex justify-start section head">
      <%= form_for(type_de_champ, form_options) do |form| %>
        <div class="flex justify-start flex-gap fr-mb-4w">
          <div class="flex justify-start width-33">
            <div class="cell flex justify-start column flex-grow">
              <%= form.label :type_champ, "Type de champ", for: dom_id(type_de_champ, :type_champ) %>
              <%= form.select :type_champ, grouped_options_for_select(types_of_type_de_champ, type_de_champ.type_champ), {}, class: 'fr-select small-margin small inline width-100', id: dom_id(type_de_champ, :type_champ), disabled: disabled_type_de_champ_select? %>

              <% if type_de_champ.siret? || type_de_champ.communes? || type_de_champ.departements? || type_de_champ.address? || type_de_champ.epci? %>
                <div class="cell fr-mt-1w">
                  <%= button_tag("Liste des informations remontées", type: :button, class: "fr-btn fr-icon-info-line fr-btn--icon-left fr-btn--tertiary-no-outline fr-btn--sm",
                    data: { "fr-opened" => "false", "turbo-frame" => "api-champ-columns", action: "lazy-modal#load" },
                    src: api_champ_columns_admin_procedure_path(id: procedure.id, stable_id: type_de_champ.stable_id),
                    "aria-controls" => "api-champ-columns-modal") %>
                </div>
              <% end %>

              <% if disabled_type_de_champ_select? %>
                <div class="cell fr-mt-1w">
                  <span class="fr-icon-lock-fill fr-icon--sm"></span>
                  Aucun type de champ autorisé pour transformer ce champ
                </div>
              <% end %>

              <% if type_de_champ.communes? %>
                <div class="cell fr-mt-1w">
                  <%= render Dsfr::NoticeComponent.new(state: "warning", closable: false) do |c| %>
                    <% c.with_title { "Attention :" } %>
                    <% c.with_desc { "ne pas utiliser ce champ pour les <strong>communes de naissance</strong>.".html_safe } %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="flex column justify-start width-66">
            <div class="cell">
              <div class="flex align-center">
                <% if libelle_configurable? %>
                  <%= form.label :libelle, "Libellé du champ", class: 'flex-grow', for: dom_id(type_de_champ, :libelle) %>
                <% end %>

                <% if mandatory_configurable? %>
                  <div class="flex align-center">
                    <%= form.check_box :mandatory, class: 'small-margin small', id: dom_id(type_de_champ, :mandatory) %>
                    <%= form.label :mandatory, "Champ obligatoire", for: dom_id(type_de_champ, :mandatory) %>
                  </div>
                <% end %>
              </div>

              <% if libelle_configurable? %>
                <%= form.text_field :libelle, class: 'fr-input small-margin small width-100', id: dom_id(type_de_champ, :libelle), data: input_autofocus %>
              <% end %>
            </div>

            <% if description_configurable? %>
              <div class="cell fr-mt-1w">
                <%= form.label :description, "Description du champ (optionnel)", for: dom_id(type_de_champ, :description) %>
                <%= form.text_area :description, class: 'fr-input small-margin small width-100 resize-y', rows: 3, id: dom_id(type_de_champ, :description) %>
              </div>
            <% end %>

            <% if type_de_champ.header_section? %>
              <p class="fr-text--sm">
                Nous numérotons automatiquement les titres lorsqu’aucun de vos
                titres ne commence par un chiffre.
              </p>
              <div class="cell fr-mt-1w">
                <%= render TypesDeChampEditor::HeaderSectionComponent.new(form: form, tdc: type_de_champ, upper_tdcs: @upper_coordinates.map(&:type_de_champ)) %>
              </div>
            <% end %>

            <% if type_de_champ.textarea? %>
              <div class="cell fr-mt-1w">
                <%= form.label :character_limit, for: dom_id(type_de_champ, :character_limit) do %>
                  Spécifier un nombre maximal conseillé de caractères :
                <% end %>

                <%= form.select :character_limit, options_for_character_limit, {}, { id: dom_id(type_de_champ, :character_limit), class: 'fr-select' } %>
              </div>
            <% end %>

            <% if type_de_champ.explication? %>
              <div class="cell fr-mt-2w">
                <div class="fr-toggle">
                  <%= form.check_box :collapsible_explanation_enabled, id: dom_id(type_de_champ, :collapsible_explanation_enabled), class: 'fr-toggle__input' %>
                  <%= form.label :collapsible_explanation_enabled, "Afficher un texte complémentaire affichable au clic", for: dom_id(type_de_champ, :collapsible_explanation_enabled), class: 'fr-toggle__label fr-label' %>
                </div>

                <% if form.object.collapsible_explanation_enabled? %>
                  <div class="cell fr-mt-1w">
                    <%= form.label :collapsible_explanation_text, for: dom_id(type_de_champ, :collapsible_explanation_text) do %>
                      <%= "Texte complémentaire" %>
                    <% end %>

                    <%= form.text_area :collapsible_explanation_text, class: "fr-input small-margin small", id: dom_id(type_de_champ, :collapsible_explanation_text) %>
                  </div>
                <% end %>
              </div>
              <div class="cell fr-mt-1w">
                <%= form.label :notice_explicative, "Notice explicative", for: dom_id(type_de_champ, :notice_explicative) %>
                <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(**notice_explicative_options), drop_zone: :none) %>
              </div>
            <% end %>

            <% if type_de_champ.piece_justificative? %>
              <div class="cell fr-mt-1w">
                <div class="fr-hr fr-mt-2w"></div>
                <%= form.label :nature, "Nature de la pièce", for: dom_id(type_de_champ, :nature) %>
                <% natures = TypeDeChamp.natures.keys.reject { _1 == 'justificatif_domicile' && !procedure.feature_enabled?(:analyse_justificatif_domicile) }.map { |k| [t("activerecord.attributes.type_de_champ.natures.#{k}", default: k.to_s.humanize), k] } %>

                <%= form.select :nature,
                  natures,
                  { },
                  class: 'fr-select small-margin small inline width-100',
                  id: dom_id(type_de_champ, :nature) %>
              </div>
              <% nature_dom_id = dom_id(type_de_champ, :nature) %>
              <% if type_de_champ.titre_identite? %>
                <div class="fr-hr"></div>
                <div class="cell">
                  <%= form.label :formats_accepted, t('.identity_formats.title'), for: nature_dom_id, class: 'fake-label' %>

                  <p class="fr-mb-0"><%= t('.identity_formats.desc_html') %></p>
                  <p class="fr-mt-0"><%= t('.identity_formats.rule_html') %></p>
                </div>
                <div class="fr-hr"></div>
                <div class="cell">
                  <%= form.label :deletion_title, t('.identity_deletion.title'), for: nature_dom_id, class: 'fake-label' %>

                  <p class="fr-mb-0">
                    <%= t('.identity_deletion.desc_html') %>
                  </p>

                  <p class="fr-mt-0">
                    <%= t('.identity_deletion.note_html') %>
                  </p>
                </div>
              <% elsif type_de_champ.rib? %>
                <div class="cell fr-mt-2w">
                  <%= render Dsfr::NoticeComponent.new(state: 'info') do |c| %>
                    <% c.with_title do %>
                      <%= t('.identity_notice.title') %>
                    <% end %>

                    <% c.with_desc do %>
                      <%= t('.rib_notice.desc_html') %>
                    <% end %>
                  <% end %>
                </div>
                <div class="fr-hr fr-mt-2w"></div>
                <div class="cell">
                  <%= form.label :formats_accepted, t('.rib_formats.title'), for: nature_dom_id, class: 'fake-label' %>

                  <p class="fr-mb-0"><%= t('.rib_formats.desc_html') %></p>
                </div>
              <% else %>
                <div class="fr-hr fr-mt-2w"></div>
                <div class="cell" data-controller="hide-target">
                  <div class="fr-toggle <%= class_names('fr-mb-2w': form.object.pj_limit_formats?) %>">
                    <%= form.check_box :pj_limit_formats,
                      id: dom_id(type_de_champ, :pj_limit_formats),
                      class: 'fr-toggle__input',
                      data: { 'hide-target-target': 'source' },
                      checked: form.object.pj_limit_formats? %>

                    <%= form.label :pj_limit_formats, t('.limit_formats_label'), for: dom_id(type_de_champ, :pj_limit_formats), class: 'fr-toggle__label fr-label' %>
                  </div>

                  <% families = format_families_for_select %>
                  <% grid_hidden_class = form.object.pj_limit_formats? ? nil : 'fr-hidden' %>

                  <div
                    class="cell <%= grid_hidden_class %>"
                    data-hide-target-target="toHide"
                  >
                    <fieldset class="fr-fieldset fr-mx-0 fr-px-0">
                      <legend
                        class="
                          fr-fieldset__legend fr-fieldset__legend--regular
                          fr-mx-0 fr-pl-0 fr-mb-1w
                        "
                      >
                        <%= t('.families_legend') %>
                      </legend>

                      <% prechecked = Array.wrap(form.object.pj_format_families).map(&:to_s) %>

                      <% families.each do |(value, label, examples)| %>
                        <div class="fr-fieldset__element fr-fieldset__element--inline fr-pl-0">
                          <div class="fr-checkbox-group">
                            <% checked_opt = prechecked.include?(value.to_s) %>
                            <%= form.check_box :pj_format_families, { multiple: true, id: dom_id(type_de_champ, "pj_format_#{value}"), checked: checked_opt }, value, nil %>

                            <% if examples.present? %>
                              <% tip_id = "#{dom_id(type_de_champ, "pj_format_#{value}")}-tip" %>
                              <%= form.label "pj_format_families_#{value}", label, for: dom_id(type_de_champ, "pj_format_#{value}"), class: 'fr-label', tabindex: 0, 'aria-describedby': tip_id %>
                              <span
                                class="fr-tooltip fr-placement"
                                id="<%= tip_id %>"
                                role="tooltip"
                                aria-hidden="true"
                              >
                                <%= t('.tooltip_examples', examples: examples) %>
                              </span>
                            <% else %>
                              <%= form.label "pj_format_families_#{value}", label, for: dom_id(type_de_champ, "pj_format_#{value}"), class: 'fr-label' %>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </fieldset>
                  </div>
                </div>
              <% end %>
              <% if !type_de_champ.titre_identite? %>
                <div class="fr-hr fr-mt-2w"></div>
                <div class="cell">
                  <div class="fr-toggle">
                    <%= form.check_box :pj_auto_purge, id: dom_id(type_de_champ, :pj_auto_purge), class: 'fr-toggle__input' %>
                    <%= form.label :pj_auto_purge, t('.auto_purge_label'), for: dom_id(type_de_champ, :pj_auto_purge), class: 'fr-toggle__label fr-label' %>
                  </div>
                </div>
              <% end %>
            <% end %>

            <% if type_de_champ.piece_justificative? %>
              <div class="fr-hr <%= class_names('fr-mt-2w': !type_de_champ.titre_identite?) %>"></div>
              <div class="cell">
                <%= form.label :piece_justificative_template, t('.template_label'), for: dom_id(type_de_champ, :piece_justificative_template) %>

                <p class="fr-hint-text">
                  <%= t('.max_file_size_hint', max_file_size: number_to_human_size(type_de_champ.max_file_size_bytes)) %>
                </p>

                <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(**piece_justificative_template_options), drop_zone: :none) %>
              </div>
              <% if type_de_champ.titre_identite? %>
                <div class="cell fr-mt-1w">
                  <%= render Dsfr::AlertComponent.new(state: :info, heading_level: 'p') do |c| %>
                    <% c.with_body do %>
                      <p>
                        Dans le cadre de la RGPD, le titre d’identité sera
                        supprimé lors de l’acceptation, du refus ou du
                        classement sans suite du dossier.
                        <br>
                        Aussi, pour des raisons de sécurité, un filigrane est
                        automatiquement ajouté aux images.
                        <br>
                        Finalement, le titre d’identité ne sera ni disponible
                        dans les zip de dossiers, ni téléchargeable par API.
                      </p>
                    <% end %>
                  <% end %>
                </div>
              <% elsif procedure.piece_justificative_multiple? && !type_de_champ.titre_identite? && !type_de_champ.rib? %>
                <div class="fr-hr fr-mt-2w"></div>
                <div class="cell">
                  <p><%= t('.multiple_files_hint') %></p>
                </div>
              <% end %>
            <% end %>

            <% if type_de_champ.integer_number? || type_de_champ.decimal_number? %>
              <div class="border-left-dark fr-mt-2w">
                <div class="cell">
                  <legend class="fake-label">
                    Format accepté
                  </legend>

                  <div class="fr-toggle">
                    <%= form.check_box :positive_number, id: dom_id(type_de_champ, :positive_number), class: 'fr-toggle__input' %>
                    <%= form.label :positive_number, "Ce nombre doit être positif", for: dom_id(type_de_champ, :positive_number), class: 'fr-toggle__label fr-label' %>
                  </div>
                </div>

                <div class="cell fr-mt-2w">
                  <div class="fr-toggle">
                    <%= form.check_box :range_number, id: dom_id(type_de_champ, :range_number), class: 'fr-toggle__input' %>
                    <%= form.label :range_number, "Ce nombre doit être compris entre des valeurs limites", for: dom_id(type_de_champ, :range_number), class: 'fr-toggle__label fr-label' %>
                  </div>
                </div>

                <% if form.object.range_number? %>
                  <div class="cell fr-mt-1w">
                    <fieldset class="fr-fieldset">
                      <div class="fr-fieldset__element fr-fieldset__element--inline fr-mb-0">
                        <div class="fr-input-group">
                          <%= form.label :min_number, for: dom_id(type_de_champ, :min_number) do %>
                            valeur minimale
                          <% end %>

                          <%= form.number_field :min_number, class: "fr-input", id: dom_id(type_de_champ, :min_number) %>
                        </div>
                      </div>

                      <div class="fr-fieldset__element fr-fieldset__element--inline fr-mb-0">
                        <div class="fr-input-group">
                          <%= form.label :max_number, for: dom_id(type_de_champ, :max_number) do %>
                            valeur maximale
                          <% end %>

                          <%= form.number_field :max_number, class: "fr-input", id: dom_id(type_de_champ, :max_number) %>
                        </div>
                      </div>
                    </fieldset>
                  </div>
                <% end %>
              </div>
            <% end %>

            <% if type_de_champ.date? || type_de_champ.datetime? %>
              <div class="border-left-dark fr-mt-2w">
                <div class="cell">
                  <legend class="fake-label">
                    Format accepté
                  </legend>

                  <% if type_de_champ.date? %>
                    <div class="fr-toggle">
                      <%= form.check_box :birthdate, id: dom_id(type_de_champ, :birthdate), class: 'fr-toggle__input' %>
                      <%= form.label :birthdate, "Ce champ est une date de naissance", for: dom_id(type_de_champ, :birthdate), class: 'fr-toggle__label fr-label' %>
                    </div>
                    <p class="fr-hint-text">
                      La date devra être comprise entre le 1er janvier 1900 et
                      aujourd’hui
                    </p>
                  <% end %>

                  <% if type_de_champ.date? && form.object.birthdate? %>
                    <div class="fr-toggle fr-mt-2w">
                      <%= form.check_box :prefill_with_france_connect_information, { id: dom_id(type_de_champ, :prefill_with_france_connect_information), class: 'fr-toggle__input', disabled: prefill_with_france_connect_information_locked_by_sibling? } %>
                      <%= form.label :prefill_with_france_connect_information, "Préremplir avec la date de naissance FranceConnect", for: dom_id(type_de_champ, :prefill_with_france_connect_information), class: 'fr-toggle__label fr-label' %>
                    </div>
                    <% if prefill_with_france_connect_information_locked_by_sibling? %>
                      <p class="fr-hint-text">
                        Un autre champ date utilise déjà cette option. Il ne
                        peut y avoir qu’un seul champ date prérempli par
                        FranceConnect par démarche.
                      </p>
                    <% else %>
                      <p class="fr-hint-text">
                        Le champ sera prérempli avec la date de naissance de
                        l’usager connecté via FranceConnect qui crée le dossier.
                        La valeur reste modifiable.
                      </p>
                    <% end %>
                  <% end %>

                  <% if !form.object.birthdate? %>
                    <div class="fr-toggle fr-mt-2w">
                      <%= form.check_box :date_in_past, id: dom_id(type_de_champ, :date_in_past), class: 'fr-toggle__input' %>
                      <%= form.label :date_in_past, "Cette date doit être dans le passé", for: dom_id(type_de_champ, :date_in_past), class: 'fr-toggle__label fr-label' %>
                    </div>
                    <div class="fr-toggle fr-mt-2w">
                      <%= form.check_box :range_date, id: dom_id(type_de_champ, :range_date), class: 'fr-toggle__input' %>
                      <%= form.label :range_date, "Cette date doit être comprise entre des dates limites", for: dom_id(type_de_champ, :range_date), class: 'fr-toggle__label fr-label' %>
                    </div>
                    <% if form.object.range_date? %>
                      <div class="cell fr-mt-1w">
                        <fieldset class="fr-fieldset">
                          <div class="fr-fieldset__element fr-fieldset__element--inline fr-mb-0">
                            <div class="fr-input-group">
                              <%= form.label :start_date, for: dom_id(type_de_champ, :start_date) do %>
                                date de début
                              <% end %>

                              <%= form.date_field :start_date, class: "fr-input", value: type_de_champ.start_date, id: dom_id(type_de_champ, :start_date) %>
                            </div>
                          </div>

                          <div class="fr-fieldset__element fr-fieldset__element--inline fr-mb-0">
                            <div class="fr-input-group">
                              <%= form.label :end_date, for: dom_id(type_de_champ, :end_date) do %>
                                date de fin
                              <% end %>

                              <%= form.date_field :end_date, class: "fr-input", value: type_de_champ.end_date, id: dom_id(type_de_champ, :end_date) %>
                            </div>
                          </div>
                        </fieldset>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if type_de_champ.quotient_familial? %>
              <div class="cell fr-my-auto fr-mx-3w">
                Ce champ permet de récupérer automatiquement et de façon fiable
                les données d'identité, le quotient familial CAF ou MSA et la
                composition familiale de l'usager connecté via FranceConnect
              </div>
            <% end %>

            <% if type_de_champ.dossier_link? %>
              <div class="fr-hr fr-mt-2w"></div>
              <div class="cell">
                <div class="fr-toggle fr-mb-2w">
                  <%= form.check_box :procedures_limit, id: dom_id(type_de_champ, :procedures_limit), class: 'fr-toggle__input' %>
                  <%= form.label :procedures_limit, "Limiter à certaines démarches", for: dom_id(type_de_champ, :procedures_limit), class: 'fr-toggle__label fr-label' %>
                </div>

                <% if form.object.procedures_limit? %>
                  <div class="border-left-dark">
                    <div class="fr-notice fr-notice--info">
                      <div class="fr-container">
                        <div class="fr-notice__body">
                          <p>
                            <span class="fr-notice__title fr-text--sm fr-mr-0">
                              Seuls les dossiers déposés par l'usager lui-même
                              seront proposés
                            </span>
                          </p>
                        </div>
                      </div>
                    </div>

                    <div class="cell fr-mt-2w">
                      <%= render TypesDeChampEditor::DossierLinkChampComponent.new(procedures: current_administrateur.procedures, type_de_champ: type_de_champ, form: form, procedure: procedure) %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <% if type_de_champ.repetition? %>
              <div class="border-left-dark fr-mt-2w">
                <div class="cell">
                  <legend class="fake-label">
                    Limiter le nombre d’éléments
                  </legend>

                  <div class="fr-toggle">
                    <%= form.check_box :limit_repetitions, id: dom_id(type_de_champ, :limit_repetitions), class: 'fr-toggle__input' %>
                    <%= form.label :limit_repetitions, "Limiter le nombre d’éléments que l’usager peut ajouter", for: dom_id(type_de_champ, :limit_repetitions), class: 'fr-toggle__label fr-label' %>
                  </div>

                  <% if form.object.limit_repetitions? %>
                    <div class="cell fr-mt-1w">
                      <fieldset class="fr-fieldset">
                        <div class="fr-fieldset__element fr-fieldset__element--inline fr-mb-0">
                          <div class="fr-input-group">
                            <%= form.label :min_repetitions, "Nombre d’éléments minimum", for: dom_id(type_de_champ, :min_repetitions) %>
                            <%= form.number_field :min_repetitions, class: "fr-input", id: dom_id(type_de_champ, :min_repetitions), min: 0 %>
                          </div>
                        </div>

                        <div class="fr-fieldset__element fr-fieldset__element--inline fr-mb-0">
                          <div class="fr-input-group">
                            <%= form.label :max_repetitions, "Nombre d’éléments maximum", for: dom_id(type_de_champ, :max_repetitions) %>
                            <%= form.number_field :max_repetitions, class: "fr-input", id: dom_id(type_de_champ, :max_repetitions), min: 1 %>
                          </div>
                        </div>
                      </fieldset>
                    </div>
                    <% if @errors.present? %>
                      <div class="fr-message fr-message--error fr-mt-1w">
                        <%= @errors %>
                      </div>
                    <% end %>
                    <div class="fr-message fr-message--info fr-mt-1w">
                      Veuillez indiquer le nombre minimum et / ou maximum
                      d’éléments requis. Une valeur vide correspond à une
                      absence de limite.
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex justify-start fr-mt-1w flex-gap">
          <% if type_de_champ.linked_drop_down_list? %>
            <div class="flex column justify-start width-33">
              <div class="cell">
                <%= form.label :drop_down_options_from_text, "Options de la liste", for: dom_id(type_de_champ, :drop_down_options_from_text) %>

                <%= form.text_area :drop_down_options_from_text,
                  value: type_de_champ.drop_down_options.join("\r\n"),
                  class: 'fr-input small-margin small width-100',
                  rows: 7,
                  id: dom_id(type_de_champ, :drop_down_options_from_text) %>
              </div>
            </div>
          <% elsif type_de_champ.drop_down_list? || type_de_champ.multiple_drop_down_list? %>
            <div class="flex justify-start column width-33 fr-mt-1w">
              <div class="cell">
                <fieldset class="fr-segmented fr-segmented">
                  <legend class="fr-segmented__legend">
                    Liste de choix
                  </legend>

                  <div class="fr-segmented__elements">
                    <div class="fr-segmented__element">
                      <%= form.radio_button :drop_down_mode, 'simple', checked: type_de_champ.drop_down_simple?, id: dom_id(type_de_champ, :simple) %>
                      <%= form.label :drop_down_mode_simple, t('.drop_down_list.labels.simple'), for: dom_id(type_de_champ, :simple), class: 'fr-label' %>
                    </div>

                    <div class="fr-segmented__element">
                      <%= form.radio_button :drop_down_mode, 'advanced', id: dom_id(type_de_champ, :advanced) %>
                      <%= form.label :drop_down_mode_advanced, t('.drop_down_list.labels.advanced'), for: dom_id(type_de_champ, :advanced), class: 'fr-label' %>
                    </div>
                  </div>
                </fieldset>
              </div>
            </div>
            <div class="flex column justify-start flex-grow border-left-dark fr-my-1w">
              <%= render TypesDeChampEditor::ChampDropDownSimpleComponent.new(type_de_champ:, form:, procedure:) %>
              <%= render TypesDeChampEditor::ChampDropDownAdvancedComponent.new(type_de_champ:, form:, procedure:) %>

              <% if type_de_champ.drop_down_list? %>
                <div class="cell flex align-center">
                  <%= form.check_box :drop_down_other, class: "small-margin small", id: dom_id(type_de_champ, :drop_down_other) %>

                  <%= form.label :drop_down_other, for: dom_id(type_de_champ, :drop_down_other) do %>
                    Proposer une option « autre » avec un texte libre
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if type_de_champ.linked_drop_down_list? %>
            <div class="flex column justify-start flex-grow">
              <div class="cell">
                <%= form.label :drop_down_secondary_libelle, "Libellé du champ secondaire", class: 'flex-grow', for: dom_id(type_de_champ, :drop_down_secondary_libelle) %>
                <%= form.text_field :drop_down_secondary_libelle, class: 'fr-input small-margin small width-100', id: dom_id(type_de_champ, :drop_down_secondary_libelle) %>
              </div>

              <div class="cell fr-mt-1w">
                <%= form.label :drop_down_secondary_description, "Description du champ secondaire (optionnel)", for: dom_id(type_de_champ, :drop_down_secondary_description) %>
                <%= form.text_area :drop_down_secondary_description, class: 'fr-input small-margin small width-100', rows: 3, id: dom_id(type_de_champ, :drop_down_secondary_description) %>
              </div>
            </div>
          <% end %>

          <% if type_de_champ.carte? %>
            <% type_de_champ.editable_options.each do |slice| %>
              <div class="cell">
                <div class="carte-options">
                  <%= form.fields_for :editable_options do |form| %>
                    <% slice.each do |(name, checked, disabled)| %>
                      <%= form.label name, for: dom_id(type_de_champ, "layer_#{name}") do %>
                        <%= form.check_box name, checked:, disabled:, class: 'small-margin small', id: dom_id(type_de_champ, "layer_#{name}") %>
                        <%= t(".layers.#{name}") %>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

          <% if type_de_champ.formatted? %>
            <div class="flex justify-start column width-33">
              <fieldset class="fr-segmented fr-segmented">
                <legend class="fr-segmented__legend fr-mb-1w">
                  Spécifier le format requis
                </legend>

                <div class="fr-segmented__elements">
                  <div class="fr-segmented__element">
                    <%= form.radio_button :formatted_mode, 'simple', checked: type_de_champ.formatted_simple?, id: dom_id(type_de_champ, :simple) %>
                    <%= form.label :formatted_mode_simple, t('.kind.labels.simple'), for: dom_id(type_de_champ, :simple), class: 'fr-label' %>
                  </div>

                  <div class="fr-segmented__element">
                    <%= form.radio_button :formatted_mode, 'advanced', id: dom_id(type_de_champ, :advanced) %>
                    <%= form.label :formatted_mode_advanced, t('.kind.labels.advanced'), for: dom_id(type_de_champ, :advanced), class: 'fr-label' %>
                  </div>
                </div>
              </fieldset>
            </div>
            <%= render TypesDeChampEditor::ChampFormattedSimpleComponent.new(type_de_champ:, form:, procedure:) %>
            <%= render TypesDeChampEditor::ChampFormattedAdvancedComponent.new(type_de_champ:, form:, procedure:) %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if type_de_champ.referentiel? %>
      <%= render(TypesDeChampEditor::InfoReferentielComponent.new(procedure:, type_de_champ:)) %>
    <% end %>

    <% if type_de_champ.quotient_familial? %>
      <%= render(TypesDeChampEditor::QuotientFamilialComponent.new()) %>
    <% end %>

    <% if type_de_champ.repetition? %>
      <div class="flex justify-start section fr-ml-1w">
        <div class="editor-block flex-grow cell">
          <%= render TypesDeChampEditor::BlockComponent.new(block: coordinate, coordinates: coordinate.revision_types_de_champ, upper_coordinates: @upper_coordinates) %>

          <div
            class="type-de-champ-add-button <%= class_names(hidden: !coordinate.empty?) %>"
            id="<%= dom_id(coordinate, :type_de_champ_add_button) %>"
          >
            <%= render TypesDeChampEditor::AddChampButtonComponent.new(revision: coordinate.revision, parent: coordinate, is_annotation: coordinate.private?) %>
          </div>
        </div>
      </div>
    <% end %>

    <%= render(Conditions::ChampsConditionsComponent.new(tdc: type_de_champ, upper_tdcs: @upper_coordinates.map(&:type_de_champ), procedure:)) %>

    <div class="flex justify-between section footer">
      <div class="position flex align-center">
        <%= (@coordinate.position + 1).to_s %>
      </div>

      <%= tag.button(class: "fr-btn fr-btn--tertiary-no-outline fr-icon-arrow-up-line move-up", **move_button_options(:up)) %>
      <%= tag.button(class: "fr-btn fr-btn--tertiary-no-outline fr-icon-arrow-down-line move-down", **move_button_options(:down)) %>
      <%= render TypesDeChampEditor::SelectChampPositionComponent.new(revision:, coordinate:) %>

      <div class="flex right">
        <% if coordinate.used_by_routing_rules? %>
          <%= tag.span(safe_join(["utilisé pour", link_to('le routage', admin_procedure_groupe_instructeurs_path(revision.procedure_id, anchor: 'routing-rules'))], "\n")) %>
        <% elsif coordinate.used_by_ineligibilite_rules? %>
          <%= tag.span(safe_join(["utilisé pour", link_to('l’eligibilité des dossiers', edit_admin_procedure_ineligibilite_rules_path(revision.procedure_id))], "\n")) %>
        <% else %>
          <% if coordinate.prefilled_by_type_de_champ %>
            <span><%= "Champ prérempli (référentiel)" %></span>
          <% end %>
          <%= button_to type_de_champ_path, class: 'fr-btn fr-btn--tertiary-no-outline fr-icon-delete-line', title: "Supprimer le champ", method: :delete, form: { data: { turbo_confirm: } } do %>
            <span class="fr-sr-only">Supprimer</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="type-de-champ-add-button <%= class_names(root: !coordinate.child?, flex: true) %>">
    <%= render TypesDeChampEditor::AddChampButtonComponent.new(revision: coordinate.revision, parent: coordinate&.parent, is_annotation: coordinate.private?, after_stable_id: type_de_champ.stable_id) %>
  </div>
<% end %>
