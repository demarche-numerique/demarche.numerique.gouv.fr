<div class="fr-col-6 fr-col-md-4 fr-col-lg-3">
  <%= link_to @url, class: "fr-tile fr-enlarge-link", **@link_attributes do %>
    <div class="fr-tile__body flex column align-center">
      <p class="<%= badge_class %>"><%= @badge[:label] %></p>

      <div>
        <div class="tile-counter fr-my-1w">
          <% if counter? %>
            <p class="fr-tag"><%= @counter %></p>
          <% end %>
        </div>

        <%= content_tag @heading_level, title, class: "fr-h6" %>

        <% if @subtitle.present? %>
          <p class="fr-tile-subtitle"><%= @subtitle %></p>
        <% end %>
      </div>

      <p class="tile-action fr-btn fr-btn--tertiary">
        <%= action? ? action : t("views.shared.actions.edit") %>
      </p>
    </div>
  <% end %>
</div>
