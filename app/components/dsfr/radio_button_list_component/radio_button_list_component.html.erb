<fieldset class="<%= class_names("fr-fieldset": true, "fr-fieldset--error": error?) %>" aria-labelledby="radio-hint-element-legend radio-hint-element-messages" role="<%= error? ? :group : nil %>">
  <legend class="<%= class_names("fr-fieldset__legend" => true, "fr-fieldset__legend--regular" => @regular_legend) %>">
    <%= content %>
  </legend>
  <% each_button do |label, value, hint, tooltip, **button_options| %>
    <div class="fr-fieldset__element <%= "fr-fieldset__element--inline" if @inline %>">
      <div class="fr-radio-group">
        <%= @form.radio_button @target, value, **button_options.except(:index) %>
        <%= @form.label @target, value: value, class: 'fr-label', **label_options(button_options) do %>
          <% capture do %>
            <%= label %>

            <%= button_options[:after_label] if button_options[:after_label] %>

            <% if hint.present? %>
              <div class="flex">
                <div class="fr-hint-text"><%= hint %></div>
                <% if tooltip.present? && button_options[:index] %>
                  <div class="fr-icon-information-line fr-icon--sm ml-1" aria-describedby="tooltip-<%= button_options[:index] %>"></div>
                  <span class="fr-tooltip fr-placement" id="tooltip-<%= button_options[:index] %>" role="tooltip" aria-hidden="true"><%= tooltip %></span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="fr-messages-group" aria-live="assertive">
    <% if error? %>
      <p class="fr-message fr-message--error"><%= error %></p>
    <% end %>
  </div>
</fieldset>
