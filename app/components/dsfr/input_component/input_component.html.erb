<%= content_tag(:div, input_group_opts) do %>
  <%= @form.label @attribute, label_opts do %>
    <% capture do %>
      <%= label %>

      <% if required? %>
        <%= render EditableChamp::AsteriskMandatoryComponent.new %>
      <% end %>

      <% if hint_renderable? %>
        <span class="fr-hint-text"><%= hint %></span>
      <% end %>
    <% end %>
  <% end %>

  <% if button.present? %>
    <div class="fr-input-wrap fr-input-wrap--addon">
      <%= @form.public_send(@input_type, @attribute, input_opts) %>
      <%= button %>
    </div>
  <% else %>
    <%= @form.public_send(@input_type, @attribute, input_opts) %>
  <% end %>

  <% if errors_on_attribute? %>
    <% if error_messages.size == 1 %>
      <p class="fr-error-text" id="<%= error_id %>"><%= error_messages.first %></p>
    <% else %>
      <div class="fr-error-text" id="<%= error_id %>">
        <ul class="list-style-type-none fr-pl-0">
          <% error_messages.map do |error_message| %>
            <li><%= error_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% elsif describedby.present? %>
    <%= describedby %>
  <% end %>

  <% if password? %>
    <div class="fr-password__checkbox fr-checkbox-group fr-checkbox-group--sm">
      <input id="<%= show_password_id %>" aria-label="<%= aria_label_show_confirmation %>" type="checkbox">
      <label class="fr--password__checkbox fr-label" for="<%= show_password_id %>"><%= t('.show_password.label') %></label>
    </div>
  <% end %>

  <% if email? %>
    <div class="suspect-email hidden" data-email-input-target="ariaRegion" tabindex="-1">
      <%= render Dsfr::AlertComponent.new(title: t('.email_suggest.mistake'), state: '', extra_class_names: 'fr-alert--info' ) do |c| %>
        <% c.with_body do %>
          <p>
            <%= t('.email_suggest.wanna_say') %>
            <span data-email-input-target="suggestion">
              exemple@gmail.com
            </span>
            <%= "?" %>
          </p>
          <p>
            <%= button_tag type: 'button', class: 'fr-btn fr-btn--sm fr-mr-3w', data: { action: 'click->email-input#accept'} do %>
              <%= t('utils.yes') %>
            <% end %>
            <%= button_tag type: 'button', class: 'fr-btn fr-btn--sm', data: { action: 'click->email-input#discard'} do %>
              <%= t('utils.no') %>
            <% end %>
          </p>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
