<div class="fr-messages-group" id="<%= @error_id %>" aria-live="assertive">
  <% if @error_full_messages.size > 0 %>
    <p class="<%= class_names('fr-message' => true, "fr-message--#{@errors_on_attribute ? 'error' : 'valid'}" => true) %>">
      <%= "« #{libelle} » " %>

      <%= @error_full_messages.to_sentence %>
    </p>
  <% elsif statutable? && statut_message.present? %>
    <p class="fr-message fr-message--<%= statut_message[:state] %>"><%= sanitize(statut_message[:text]) %></p>
  <% end %>

  <% if prefilled? %>
    <p class="fr-message fr-message--info"><%= sanitize(t('.prefilled')) %></p>
  <% end %>
</div>
