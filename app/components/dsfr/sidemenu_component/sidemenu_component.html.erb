
<nav class="fr-sidemenu fr-sidemenu--sticky" aria-labelledby="fr-sidemenu-title">
  <div class="fr-sidemenu__inner">
    <button class="fr-sidemenu__btn" aria-controls="fr-sidemenu-wrapper" aria-expanded="false" hidden><%= t('.btn_collapse_text') %></button>
    <div id="fr-sidemenu-wrapper" class="fr-collapse">
      <ul class="fr-sidemenu__list">
        <% links.each do |link| %>
          <li class="fr-sidemenu__item fr-sidemenu__item<%= active?(link.url) ? '--active' : '' %>">
            <%= link_to link.url, class: 'fr-sidemenu__link ', 'aria-current': active?(link.url) ? 'page' : nil, target: "_self" do %>
              <% capture do %>
                <% if link.icon.present? %>
                  <span class="<%= link.icon %>"></span>
                <% end %>
                <%= link.name %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
