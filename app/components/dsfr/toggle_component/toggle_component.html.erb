<div class="fr-toggle <%= extra_class_names %>">
  <%= @form.check_box target, class: 'fr-toggle__input', disabled: disabled, data: data, id: input_id %>
  <%= @form.label target,
    title || html_title&.html_safe,
    for: label_for,
    data: { 'fr-checked-label': toggle_labels[:checked], 'fr-unchecked-label': toggle_labels[:unchecked] },
    class: 'fr-toggle__label' %>

  <% if hint %>
    <p class="fr-hint-text"><%= hint %></p>
  <% end %>
</div>
