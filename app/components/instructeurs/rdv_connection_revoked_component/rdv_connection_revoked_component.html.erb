<%= helpers.turbo_frame_tag "rdv-connection-info" do %>
  <%= render Dsfr::AlertComponent.new(state: :warning, title: t('.title')) do |c| %>
    <% c.with_body do %>
      <p><%= t('instructeurs.rdv_connections.revoked') %></p>

      <%= form_tag('/auth/rdvservicepublic', method: 'post', data: { turbo: false }) do %>
        <button class="fr-btn fr-btn--sm" type="submit">
          <%= t('.reconnect_button') %>

          <span class="fr-ml-1w fr-icon-external-link-line" aria-hidden="true"></span>
        </button>
      <% end %>
    <% end %>
  <% end %>
<% end %>
