<div class="flex column" id="<%= id %>">
  <%= operator_hidden_field %>

  <% if radio_buttons? %>
    <%= render Dsfr::RadioButtonListComponent.new(form:,
      target: "filter[filter][value][]",
      buttons: radio_button_options,
      inline: true,
    ) do %>
      <%= render_label %>
    <% end %>
  <% elsif is_date? %>
    <fieldset class="fr-fieldset flex column flex-1">
      <legend class="fr-fieldset__legend fr-fieldset__legend--regular fr-pb-0">
        <%= render_label %>
      </legend>

      <div class="flex width-100 align-end">
        <div class="fr-fieldset__element fr-fieldset__element--inline">
          <div class="flex column">
            <%= form.label "filter[filter][operator]", t(".operator"), class: 'fr-label fr-sr-only', for: input_id(value: "operator") %>

            <%= form.select "filter[filter][operator]",
              options_for_select(date_filter_options, selected: operator), {}, { id: input_id(value: "operator"), class: 'fr-select', data: { autosubmit_target: 'input', } } %>
          </div>
        </div>

        <% if date_range? %>
          <div
            class="
              fr-fieldset__element fr-fieldset__element--inline flex
              align-center
            "
          >
            <%= form.label "filter[filter][value][]", t(".from"), class: 'fr-label fr-mr-2w', for: input_id(value: "from") %>
            <%= form.date_field "filter[filter][value][]", value: value.first, id: input_id(value: "from"), class: 'fr-input fr-mt-0' %>
          </div>
          <div
            class="
              fr-fieldset__element fr-fieldset__element--inline flex
              align-center
            "
          >
            <%= form.label "filter[filter][value][]", t(".to"), class: 'fr-label fr-mr-2w', for: input_id(value: "to") %>

            <div class="fr-input-wrap fr-input-wrap--addon fr-mt-0">
              <%= form.date_field "filter[filter][value][]", value: value.second, id: input_id(value: "to"), class: 'fr-input fr-mt-0' %>
              <%= form.button t('.update'), class: 'fr-btn fr-icon-search-line' %>
            </div>
          </div>
        <% elsif is_operator_with_value? %>
          <div class="fr-fieldset__element fr-fieldset__element--inline">
            <%= render Dsfr::InputComponent.new(form:, attribute: "filter[filter][value][]", input_type: :date_field, required: false, opts: { id: input_id(value: "value") }, label_opts: { class: 'fr-sr-only' }) do |c| %>
              <% c.with_label do %>
                <%= t(".operators.#{operator}") %>
              <% end %>

              <% c.with_button do %>
                <%= form.button t('.update'), class: 'fr-btn fr-icon-search-line' %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </fieldset>
  <% elsif selectable? %>
    <%= form.label input_id, class: 'fr-label' do %>
      <%= render_label %>
    <% end %>
    <react-fragment>
      <%= render ReactComponent.new "ComboBox/MultiComboBox", **react_props %>
    </react-fragment>
  <% else %>
    <div class="default-filter">
      <% Array(value).each do |v| %>
        <%= form.hidden_field "filter[filter][value][]", value: v %>
      <% end %>

      <%= render Dsfr::InputComponent.new(
        form:,
        attribute: "filter[filter][value][]",
        required: false,
        opts: {
          id: input_id,
          type: type,
          maxlength: FilteredColumn::FILTERS_VALUE_MAX_LENGTH,
          placeholder: t('.search_placeholder'),
          data: { no_autosubmit: true },
        },
      ) do |c| %>
        <% c.with_label do %>
          <%= render_label %>
        <% end %>

        <% c.with_button do %>
          <%= form.button t('.update'), class: 'fr-btn fr-icon-search-line' %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
