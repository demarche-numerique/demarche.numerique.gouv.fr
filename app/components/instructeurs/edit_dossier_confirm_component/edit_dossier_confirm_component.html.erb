<%= render Dsfr::ModalComponent.new(id: 'dossier-submit-dialog', size: :lg, data: { controller: 'auto-open-modal' }) do |modal| %>
  <% modal.with_title { title } %>

  <% modal.with_footer do %>
    <div class="fr-btns-group fr-btns-group--center fr-btns-group--inline-lg">
      <button
        type="button"
        class="fr-btn fr-btn--secondary fr-mb-2w"
        aria-controls="dossier-submit-dialog"
      >
        <%= t('.cancel') %>
      </button>

      <button
        type="submit"
        class="fr-btn fr-mb-2w"
        form="submit_dossier"
        data-controller="autosave-submit"
      >
        <%= t('.confirm') %>
      </button>
    </div>
  <% end %>

  <%= render Instructeurs::EditDossierAlertComponent.new %>

  <%= form_for :traitement, url: submit_instructeur_dossier_path, id: 'submit_dossier', method: :patch, class: 'fr-mt-2w' do |f| %>
    <div class="fr-input-group fr-mb-3w">
      <%= f.label :default_message, t('.default_message_label'), class: 'fr-label' %>

      <div class="fr-p-4v fr-mt-4v readonly-text-area">
        <%= default_message %>
      </div>
    </div>

    <div class="fr-input-group fr-mb-3w">
      <%= f.label :motivation, t('.motivation_label'), class: 'fr-label' %>
      <%= f.text_area :motivation, class: 'fr-input', placeholder: t('.motivation_placeholder'), data: { controller: 'autoresize' } %>
    </div>
  <% end %>
<% end %>
