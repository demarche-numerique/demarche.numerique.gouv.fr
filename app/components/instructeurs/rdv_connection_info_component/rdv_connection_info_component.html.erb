<%= helpers.turbo_frame_tag "rdv-connection-info" do %>
  <%= render Dsfr::AlertComponent.new(state: nil, title: t('.title')) do |c| %>
    <% c.with_body do %>
      <p>
        <%= t('.connection_message_html', ds_email: current_instructeur.email, rdv_email: rdv_email, application_name: Current.application_name) %>
      </p>

      <p>
        <%= t('.disconnect_info', application_name: Current.application_name) %>
      </p>

      <%= button_to(t('.disconnect_button'), instructeur_rdv_connections_path(redirect_path: redirect_path), class: 'fr-btn fr-btn--sm fr-btn--secondary', method: :delete, form: { data: { turbo: false } }) %>
    <% end %>
  <% end %>
<% end %>
