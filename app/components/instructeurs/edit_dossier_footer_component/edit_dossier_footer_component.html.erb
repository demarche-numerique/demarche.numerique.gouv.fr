<div class="padded-fixed-footer dossier-edit-footer">
  <div class="fixed-footer">
    <div class="fr-container">
      <div class="fr-grid-row fr-grid-row--center flex-gap-2">
        <%= link_to t('.cancel'),
          instructeur_dossier_path(@dossier.procedure, @dossier),
          class: 'fr-btn fr-btn--secondary fr-mb-2w',
          data: { controller: 'confirm', confirm_message_value: t('.confirm'), action: 'confirm#ask' } %>

        <%= button_to t('.submit'),
          validate_edit_instructeur_dossier_path(@dossier.procedure, @dossier),
          method: :patch,
          class: 'fr-btn fr-mb-2w',
          disabled: !@dossier.instructeur_buffer_changes?,
          form: { data: { turbo: 'true' } },
          data: { controller: 'autosave-submit' } %>
      </div>
    </div>
  </div>
</div>
