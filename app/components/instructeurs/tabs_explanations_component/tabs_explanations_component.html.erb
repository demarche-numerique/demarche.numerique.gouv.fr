<% if render_button? %>
  <button
    class="
      fr-btn fr-btn--sm fr-btn--tertiary-no-outline fr-btn--icon-left
      fr-icon-question-line fr-ml-2v
    "
    aria-controls="modal-tabs-explanations"
    aria-haspopup="dialog"
    data-fr-opened="false"
  >
    <%= t('.modal.title') %>
  </button>
<% end %>

<% if render_dialog? %>
  <%= render Dsfr::ModalComponent.new(id: 'modal-tabs-explanations', size: :lg) do |modal| %>
    <% modal.with_title { t('.modal.title') } %>

    <% if action_name == "index" %>
      <% %w(en_cours en_test close).each do |tab| %>
        <p><%= t(".modal.tabs_#{tab}_html") %></p>
      <% end %>
    <% else %>
      <% %w(a_suivre suivis traites tous expirant archives supprimes).each do |tab| %>
        <p>
          <% if tab == "supprimes" %>
            <% days = Dossier::REMAINING_WEEKS_BEFORE_DELETION * 7 %>
            <% months = Dossier::CONSERVATION_EXTENSION_DURATION / 1.month %>
            <%= t(".modal.tabs_#{tab}_html", app_name: APPLICATION_NAME, days_part: t('.modal.tabs_supprimes_days', count: days), months_part: t(".modal.tabs_supprimes_months.#{months}")) %>
          <% else %>
            <%= t(".modal.tabs_#{tab}_html", app_name: APPLICATION_NAME) %>
          <% end %>
        </p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
