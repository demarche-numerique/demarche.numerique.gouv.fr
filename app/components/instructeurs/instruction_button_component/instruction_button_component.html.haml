- if @batch
  %button.fr-btn.fr-btn--sm.fr-btn--icon-left.fr-icon-arrow-right-circle-line.fr-ml-1w{
    type: "button",
    data: {
      operation: "instruction",
      action: "batch-operation#openInstructionModal",
      'fr-js-modal-button': "true",
      'fr-opened': "false"
    },
    disabled: true,
    aria: { controls: "modal-instruction-button" }
  }
    = t(".labels.instruction")
- else
  %button.fr-btn.fr-icon-arrow-right-circle-line{ aria: { controls: 'modal-instruction-button' }, data: { 'fr-opened': "false" } }
    = t(".labels.instruction")

  = render partial: 'instructeurs/dossiers/instruction_modal', locals: { dossier:, batch:, procedure: }
