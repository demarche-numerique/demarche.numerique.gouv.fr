<%# we do this trick because some html elements should use 'label' and some should be plain paragraphs %>
<% if @champ.html_label? %>
  <%= @form.label @champ.main_value_name, id: input_label_id(@champ), for: @champ.focusable_input_id, class: 'fr-label' do %>
    <%= render EditableChamp::ChampLabelContentComponent.new(champ: @champ, seen_at: @seen_at, row_number: @row_number) %>
  <% end %>
<% elsif @champ.legend_label? %>
  <legend
    class="fr-fieldset__legend fr-text--regular"
    id="<%= champ_fieldset_legend_id(@champ) %>"
  >
    <%= render EditableChamp::ChampLabelContentComponent.new(champ: @champ, seen_at: @seen_at, row_number: @row_number) %>
  </legend>
<% end %>

<%# the automatic hints come last, just above the input %>
<% if (@champ.html_label? || @champ.legend_label?) && describedby_present? %>
  <div
    class="<%= class_names('fr-hint-text', 'fr-mb-1w': @champ.html_label?) %>"
    id="<%= @champ.describedby_id %>"
  >
    <% if @champ.description.present? %>
      <%= render SimpleFormatComponent.new(@champ.description, allow_a: true) %>
    <% end %>

    <% if expression_reguliere_indications.present? %>
      <p><%= expression_reguliere_indications %></p>
    <% end %>

    <% if referentiel_hint.present? %>
      <p><%= t('.referentiel', hint: referentiel_hint) %></p>
    <% end %>

    <% hints_for_champ.each do |hint| %>
      <p
        <%= tag.attributes(id: hint[:id], data: (hint[:controller] ? { controller: hint[:controller], turbo_force: :browser } : {})) %>
      >
        <%= hint[:text] %>
      </p>
    <% end %>
  </div>
<% end %>
