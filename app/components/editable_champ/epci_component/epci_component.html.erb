<div class="fr-fieldset__element">
  <%= @form.label :department_code, for: @champ.focusable_input_id(:department_code), class: 'fr-label', id: input_label_id(@champ, :department_code) do %>
    <%= t(".departement_label") %>
  <% end %>

  <%= @form.select :department_code, departement_options, select_options(selected: @champ.department_code), required: @champ.required?, id: @champ.focusable_input_id(:department_code), class: "width-33-desktop width-100-mobile fr-select", aria: labelledby_id_attr(input_label_id(@champ, :department_code)) %>
</div>

<% if @champ.departement? %>
  <div class="fr-fieldset__element">
    <div class="fr-select-group">
      <%= @form.label :value, for: @champ.focusable_input_id, class: 'fr-label', id: input_label_id(@champ, :value) do %>
        <%= t(".epci_label") %>
      <% end %>

      <%= @form.select :value, epci_options, select_options(selected: selected_epci_code), required: @champ.required?, id: @champ.focusable_input_id, class: "width-33-desktop width-100-mobile fr-select", aria: labelledby_id_attr(input_label_id(@champ, :value)), data: { turbo_force: :server } %>
    </div>
  </div>
<% end %>
