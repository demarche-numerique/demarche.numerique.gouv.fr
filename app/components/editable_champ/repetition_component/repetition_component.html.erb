<%= tag.legend(class: "fr-fieldset__legend fr-h5", id: repetition_fieldset_legend_id(@champ), **legend_params) do %>
  <%= @champ.libelle %>
<% end %>

<% if @champ.description.present? %>
  <%= tag.div(class: "fr-messages-group notice fr-mt-n2w", **notice_params) do %>
    <%= render SimpleFormatComponent.new(@champ.description, allow_a: true) %>
  <% end %>
<% end %>

<% if show_limits_description? %>
  <p class="fr-message fr-message--info fr-mt-1w"><%= limits_description %></p>
<% end %>

<div
  class="fr-fieldset__element flex column flex-gap-2"
  data-controller="repetition-toggle-all"
  data-repetition-toggle-all-expanded-text-value="<%= t(".collapse_all") %>"
  data-repetition-toggle-all-collapsed-text-value="<%= t(".expand_all") %>"
>
  <% if show_toggle_all_button? %>
    <div class="repetition-toggle-all fr-mt-n2w">
      <button
        type="button"
        class="fr-btn fr-btn--tertiary-no-outline fr-btn--sm fr-btn--icon-left"
        data-action="click->repetition-toggle-all#toggleAll"
        data-repetition-toggle-all-target="button"
        aria-expanded="false"
        aria-controls="<%= aria_controls %>"
      >
        <span
          data-repetition-toggle-all-target="icon"
          class="fr-icon-arrow-down-double-line"
          aria-hidden="true"
        ></span>

        <span data-repetition-toggle-all-target="text">
          <%= t(".expand_all") %>
        </span>
      </button>
    </div>
  <% end %>

  <div
    class="repetition width-100 flex column flex-gap-2 <%= class_names('utils-repetition-required' => @champ.mandatory?) %>"
    id="<%= dom_id(@champ, :rows) %>"
    data-repetition-toggle-all-target="rowsContainer"
  >
    <% @champ.rows.each do |row| %>
      <%= render EditableChamp::RepetitionRowComponent.new(champ: @champ, row:, expanded: expand_row?(row.id, @champ.row_ids.count)) %>
    <% end %>
  </div>

  <%= render partial: "champs/repetition/actions", locals: { champ: @champ, max_reached: max_reached? } %>

  <div
    id="<%= dom_id(@champ, :deletion_announcement) %>"
    class="fr-sr-only"
    role="status"
  ></div>
</div>
