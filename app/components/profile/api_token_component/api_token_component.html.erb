<tr id="<%= dom_id(@api_token) %>">
  <th scope="row" class="fr-cell--multiline fr-cell--top">
    <%= @api_token.name %>

    <p class="fr-text--sm fr-text--regular fr-my-0"><%= access %></p>

    <p class="fr-hint-text fr-text--regular fr-my-0">
      <%= t('.prefix_html', prefix:) %>
    </p>

    <% if subtitle %>
      <p class="fr-hint-text fr-text--regular fr-my-0"><%= subtitle %></p>
    <% end %>
  </th>

  <td class="fr-cell--multiline fr-cell--top">
    <p class="fr-text--xs fr-text-mention--grey fr-my-0">
      <%= t('.procedures') %>
    </p>

    <%= procedures %>

    <p class="fr-text--xs fr-text-mention--grey fr-mt-1w fr-mb-0">
      <%= t('.networks') %>
    </p>

    <%= networks %>

    <% if folded? %>
      <p class="fr-mt-1w fr-mb-0"><%= details_button %></p>
    <% end %>
  </td>

  <td class="fr-cell--multiline fr-cell--top">
    <p class="fr-text--xs fr-text-mention--grey fr-my-0">
      <%= @api_token.expired? ? t('.expired_on') : t('.expires_on') %>
    </p>

    <p class="fr-text--sm fr-my-0 api-token-expiration"><%= expiration %></p>
    <%= expiring_soon_badge %>

    <p class="fr-text--xs fr-text-mention--grey fr-mt-1w fr-mb-0">
      <%= t('.last_use') %>
    </p>

    <p class="fr-text--sm fr-my-0"><%= last_use %></p>
  </td>

  <td class="fr-cell--top api-token-actions">
    <ul class="fr-btns-group fr-btns-group--sm fr-btns-group--icon-left fr-m-0">
      <% actions.each do |action| %>
        <li><%= action %></li>
      <% end %>
    </ul>
  </td>
</tr>
