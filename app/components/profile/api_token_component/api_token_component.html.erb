<tbody id="<%= dom_id(@api_token) %>">
  <tr class="api-token-row">
    <th
      scope="row"
      rowspan="2"
      id="<%= name_id %>"
      class="fr-cell--multiline fr-cell--top"
    >
      <%= @api_token.name %>

      <span class="fr-hint-text fr-text--regular">
        <%= t('.prefix_html', prefix:) %>
      </span>
    </th>

    <td class="fr-cell--top"><%= access %></td>
    <td class="fr-cell--top"><%= last_use %></td>

    <td class="fr-cell--top">
      <%= expiration %>
      <%= expiration_badge %>
    </td>

    <td class="fr-cell--top api-token-actions">
      <div class="fr-cell--inline">
        <% if @api_token.expired? %>
          <%= duplicate_button(primary: true) %>
        <% else %>
          <%= link_to t('.edit'), edit_admin_api_token_path(@api_token),
            class: 'fr-btn fr-btn--sm fr-btn--secondary fr-btn--icon-left fr-icon-pencil-line',
            aria: { label: t('.edit_label', name: @api_token.name) } %>
          <%= duplicate_button(primary: false) %>
        <% end %>

        <%= link_to t('.destroy'), admin_api_token_path(@api_token),
          class: 'fr-btn fr-btn--sm fr-btn--tertiary fr-btn--icon-left fr-icon-delete-line',
          aria: { label: t('.destroy_label', name: @api_token.name) },
          data: { turbo_method: :delete, turbo_confirm: t('.destroy_confirm', name: @api_token.name) } %>
      </div>
    </td>
  </tr>

  <tr class="api-token-details-row">
    <td
      colspan="4"
      headers="<%= name_id %>"
      class="fr-cell--multiline fr-cell--top"
    >
      <div class="fr-hint-text"><%= t('.networks_html', networks:) %></div>
      <div class="fr-hint-text"><%= t('.procedures_html', procedures:) %></div>
    </td>
  </tr>
</tbody>
