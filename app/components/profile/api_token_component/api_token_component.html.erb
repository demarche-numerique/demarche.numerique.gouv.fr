<tbody id="<%= row_id %>">
  <tr class="api-token-row">
    <th
      scope="row"
      rowspan="2"
      id="<%= name_id %>"
      class="fr-cell--multiline fr-cell--top"
    >
      <%= @api_token.name %>

      <span class="fr-hint-text fr-text--regular">
        <%= t('.prefix_html', prefix:) %>
      </span>

      <% if subtitle %>
        <span class="fr-hint-text fr-text--regular"><%= subtitle %></span>
      <% end %>
    </th>

    <td class="fr-cell--top"><%= access %></td>
    <td class="fr-cell--top"><%= last_use %></td>

    <td class="fr-cell--top">
      <%= expiration %>
      <%= expiration_badge %>
    </td>

    <td class="fr-cell--top api-token-actions">
      <div class="fr-cell--inline">
        <%= safe_join(actions) %>
      </div>
    </td>
  </tr>

  <tr class="api-token-details-row">
    <td
      colspan="4"
      headers="<%= name_id %>"
      class="fr-cell--multiline fr-cell--top"
    >
      <div class="fr-hint-text">
        <%= t('.networks_html', networks:) %>

        <% if networks_folded? && !procedures_folded? %>
          <%= details_button %>
        <% end %>
      </div>

      <div class="fr-hint-text">
        <%= t('.procedures_html', procedures: legend_procedures) %>

        <% if procedures_folded? %>
          <%= details_button %>
        <% end %>
      </div>
    </td>
  </tr>
</tbody>
