<%= tag.div(data: wrapper_data) do %>
  <%= tag.button(tag.span(safe_join([t('views.confirmation.new.resent'), tag.span(aria: { hidden: true }, data: { countdown_button_target: 'counter' })])), type: 'submit', class: 'fr-btn fr-btn--secondary', data: { countdown_button_target: 'button' }) %>
  <%= tag.p(class: 'fr-sr-only', role: 'status', data: { countdown_button_target: 'status' }) %>
<% end %>
