<div id="header-navigation" class="fr-nav">
  <ul class="fr-nav__list">
    <% if instructeur? %>
      <li class="fr-nav__item">
        <%= link_to Procedure.model_name.human(count: 10), instructeur_procedures_path, class: 'fr-nav__link', aria: aria_current_for(:procedure) %>
      </li>
    <% end %>

    <% if expert? %>
      <li class="fr-nav__item">
        <% unanswered = helpers.current_expert.avis_summary[:unanswered] %>

        <%= link_to expert_all_avis_path, class: 'fr-nav__link flex', aria: aria_current_for(:avis) do %>
          <% if unanswered > 0 %>
            <span class="fr-badge fr-badge--new fr-badge--no-icon fr-ml-1w">
              <%= unanswered %>
            </span>
          <% end %>

          <span class="order-first">
            <%= Avis.model_name.human(count: 10) %>
          </span>

          <% if unanswered > 0 %>
            <span class="fr-sr-only"><%= t('.avis_to_give') %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <%= render MainNavigation::AnnouncesLinkComponent.new %>

    <% if instructeur? && controller.try(:nav_bar_profile) == :instructeur %>
      <li class="fr-nav__item">
        <%= link_to t("links.main_navigation.doc.label"), INSTRUCTEUR_TUTORIAL_URL, class: "fr-nav__link", **helpers.external_link_attributes(t("links.main_navigation.doc.instructeur_title")) %>
      </li>
    <% end %>

    <% if expert? && controller.try(:nav_bar_profile) == :expert %>
      <li class="fr-nav__item">
        <%= link_to t("links.main_navigation.doc.label"), EXPERT_TUTORIAL_URL, class: "fr-nav__link", **helpers.external_link_attributes(t("links.main_navigation.doc.expert_title")) %>
      </li>
    <% end %>
  </ul>
</div>
